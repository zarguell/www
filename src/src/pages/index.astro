---
import BaseLayout from '../layouts/BaseLayout.astro';
import Window from '../components/Window.astro';
import RetroButton from '../components/RetroButton.astro';
import Badge from '../components/Badge.astro';
import Sticker from '../components/Sticker.astro';
---

<BaseLayout title="Home - ARGUELLES.ME">
	<div class="hero">
		<h1 class="hero__title">
			Welcome to <span class="hero__accent">ARGUELLES.ME</span>
		</h1>
		<p class="terminal-prompt" aria-hidden="true">
			<span class="terminal-user">zach@arguelles</span>:<span class="terminal-path">~</span><span class="terminal-dollar">$</span> whoami<span class="terminal-cursor"></span>
		</p>
	</div>

	<div class="intro">
		<p>
			This is my personal website, published on the <strong>world wide web</strong>!
		</p>
		<p>
			Explore the blog, play with some tiny tools, or check out the links.
			Everything is designed to be static first (with some
			Cloudflare worker serverless compute if necessary).
		</p>
		<div class="chat-launcher">
			<RetroButton id="launchChatBtn">Launch Chat</RetroButton>
		</div>
	</div>


	<div class="features">
		<Window title="Blog" badgeText="NEW">
			<p>Read my thoughts on whatever I feel like writing about.</p>
			<RetroButton href="/blog/">Read Posts</RetroButton>
		</Window>

		<Window title="Tools" badgeText="HOT">
			<p>
				Tiny calculators and utilities that feel like toys. Really just a mix of
				random stuff I've built over time.
			</p>
			<RetroButton href="/tools/">Explore Tools</RetroButton>
		</Window>

		<Window title="Links">
			<p>Quick links to my socials, or other links I want to share.</p>
			<RetroButton href="/links/">Browse Links</RetroButton>
		</Window>

		<Window title="About">
			<p>Learn more about me.</p>
			<RetroButton href="/about/">About Me</RetroButton>
		</Window>
	</div>

	<Window title="What's New" badgeText="UPDATE">
		<div class="whats-new">
			<div class="whats-new__item">
				<strong>Latest Blog Post:</strong>
				<a href="/blog/">InfluxDB Speedtest Monitoring on OpenWRT</a>
			</div>
			<div class="whats-new__item">
				<strong>Newest Tool:</strong>
				<a href="/tools/401k-calculator/">401k Calculator (Demo)</a>
			</div>
		</div>
	</Window>
</BaseLayout>

<style>
	.hero {
		text-align: center;
		padding: 2rem 0 1.5rem;
	}

	.hero__title {
		font-size: 3.25rem;
		margin-bottom: 1rem;
		line-height: 1.1;
	}

	.hero__accent {
		/* --link passes 3:1 as large text in both themes; --accent only passes on dark */
		color: var(--link);
	}

	/* One signature flourish: a shell prompt answering the page title */
	.terminal-prompt {
		font-family: var(--font-body);
		font-size: 0.95rem;
		margin: 1rem 0 0;
		color: var(--muted);
	}

	.terminal-user {
		color: var(--link);
	}

	.terminal-path {
		color: var(--text);
	}

	.terminal-cursor {
		display: inline-block;
		width: 0.55em;
		height: 1.05em;
		margin-left: 0.15em;
		background: var(--accent);
		vertical-align: text-bottom;
		animation: cursor-blink 1.1s step-end infinite;
	}

	@keyframes cursor-blink {
		50% {
			opacity: 0;
		}
	}

	.intro {
		max-width: 65ch;
		margin: 0 auto 2.5rem;
	}

	.intro p {
		line-height: 1.7;
	}

	.features {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 1.5rem;
		margin-bottom: 2.5rem;
	}

	.whats-new {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.whats-new__item {
		display: flex;
		gap: 0.5rem;
		font-size: 1.1rem;
	}

	.whats-new__item strong {
		color: var(--link);
		min-width: 150px;
	}

	@media (max-width: 768px) {
		.hero__title {
			font-size: 2.5rem;
		}

		.features {
			grid-template-columns: 1fr;
		}

		.whats-new__item {
			flex-direction: column;
		}

		.whats-new__item strong {
			min-width: auto;
		}
	}

	.chat-launcher {
		margin-top: 1.5rem;
		text-align: center;
	}
</style>

<script>
	// Handle Launch Chat button
	const launchChatBtn = document.getElementById('launchChatBtn');
	launchChatBtn?.addEventListener('click', () => {
		const aimChatWindow = document.getElementById('aimChatWindow');
		if (aimChatWindow) {
			aimChatWindow.style.setProperty('display', 'flex');
			localStorage.setItem('aimChatOpen', 'true');
			// Hide the launch button after opening
			launchChatBtn.parentElement?.style.setProperty('display', 'none');
		}
	});

	// Show/hide launch button based on chat state (chat defaults to closed)
	const aimChatWindow = document.getElementById('aimChatWindow');
	const chatOpenState = localStorage.getItem('aimChatOpen');
	if (aimChatWindow && chatOpenState === 'true') {
		// Chat is open, hide launch button
		launchChatBtn?.parentElement?.style.setProperty('display', 'none');
	}
</script>
