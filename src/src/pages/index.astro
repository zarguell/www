---
import BaseLayout from '../layouts/BaseLayout.astro';
import Window from '../components/Window.astro';
import RetroButton from '../components/RetroButton.astro';
import Badge from '../components/Badge.astro';
import Sticker from '../components/Sticker.astro';
---

<BaseLayout title="ARGUELLES.ME">
	<div class="hero">
		<h1 class="hero__title">
			Welcome to <span class="hero__accent">ARGUELLES.ME</span>
		</h1>
		<p class="hero__subtitle">
			<Sticker text="Fashion-Forward" rotate="left" />
			<Sticker text="Retro" rotate="right" />
			<Sticker text="Maximalist" rotate="left" />
		</p>
	</div>

	<div class="intro">
		<p>
			This is a <strong>90s inspired retro website</strong> built with
			Astro. It's loud, nostalgic, and unapologetically maximalist — just like the
			internet used to be.
		</p>
		<p>
			Explore the blog, play with some tiny tools, or check out the links. Everything
			is static, lightweight, and built with <Badge text="LOVE" variant="accent" />.
		</p>
	</div>

	<div class="features">
		<Window title="Blog" badgeText="NEW">
			<p>Read my thoughts on fashion, coding, and the intersection of both.</p>
			<RetroButton href="/blog/">Read Posts</RetroButton>
		</Window>

		<Window title="Tools" badgeText="HOT">
			<p>
				Tiny calculators and utilities that feel like toys. Because productivity
				should be fun.
			</p>
			<RetroButton href="/tools/">Explore Tools</RetroButton>
		</Window>

		<Window title="Links">
			<p>Curated links to interesting corners of the internet. No algorithm required.</p>
			<RetroButton href="/links/">Browse Links</RetroButton>
		</Window>

		<Window title="About">
			<p>Learn more about me, my style influences, and how this site was built.</p>
			<RetroButton href="/about/">About Me</RetroButton>
		</Window>
	</div>

	<Window title="What's New" badgeText="UPDATE">
		<div class="whats-new">
			<div class="whats-new__item">
				<strong>Latest Blog Post:</strong>
				<a href="/blog/">Fit Notes: Cargo Pants + Neon UI</a>
			</div>
			<div class="whats-new__item">
				<strong>Newest Tool:</strong>
				<a href="/tools/401k-calculator/">401k Calculator (Demo)</a>
			</div>
		</div>
	</Window>
</BaseLayout>

<style>
	.hero {
		text-align: center;
		padding: 3rem 0;
	}

	.hero__title {
		font-size: 3.5rem;
		margin-bottom: 1rem;
		line-height: 1.1;
	}

	.hero__accent {
		color: var(--accent);
		text-shadow:
			3px 3px 0 var(--accent2),
			-2px -2px 0 var(--accent);
	}

	.hero__subtitle {
		display: flex;
		justify-content: center;
		gap: 1rem;
		flex-wrap: wrap;
	}

	.intro {
		max-width: 65ch;
		margin: 0 auto 3rem;
	}

	.intro p {
		font-size: 1.3rem;
		line-height: 1.7;
	}

	.features {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
		gap: 2rem;
		margin-bottom: 3rem;
	}

	.whats-new {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.whats-new__item {
		display: flex;
		gap: 0.5rem;
		font-size: 1.1rem;
	}

	.whats-new__item strong {
		color: var(--accent);
		min-width: 150px;
	}

	@media (max-width: 768px) {
		.hero__title {
			font-size: 2.5rem;
		}

		.features {
			grid-template-columns: 1fr;
		}

		.whats-new__item {
			flex-direction: column;
		}

		.whats-new__item strong {
			min-width: auto;
		}
	}
</style>
