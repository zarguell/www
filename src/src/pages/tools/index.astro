---
import ToolLayout from '../../layouts/ToolLayout.astro';
import Window from '../../components/Window.astro';
import RetroButton from '../../components/RetroButton.astro';
import { toolsData, getAllTools, getToolsSortedByDate } from '../../data/tools';
---

<ToolLayout title="Tools - ARGUELLES.ME">
	<div class="tools-hero">
		<h1>Tools</h1>
		<p class="tools-subtitle">Calculators and utilities for your digital life</p>
	</div>

	<!-- View Toggle & Search -->
	<div class="tools-controls">
		<div class="view-toggle">
			<button id="categoryViewBtn" class="view-toggle-btn active" data-view="category">
				Category View
			</button>
			<button id="dateViewBtn" class="view-toggle-btn" data-view="date">
				Date View (Newest)
			</button>
		</div>

		<div class="search-container">
			<input
				type="text"
				id="searchInput"
				placeholder="Search tools..."
				class="search-input"
				aria-label="Search tools"
			/>
		</div>
	</div>

	<!-- Category View -->
	<div id="categoryView" class="view-content">
		<!-- Category Navigation -->
		<nav class="category-nav" id="categoryNav">
			{toolsData.map((category) => (
				<a href={`#${category.id}`} class="category-link" data-category={category.id}>
					{category.name}
				</a>
			))}
		</nav>

		{toolsData.map((category) => (
			<section id={category.id} class="tool-category" data-category={category.id}>
				<h2 class="category-title">{category.name}</h2>
				<p class="category-description">{category.description}</p>

				<div class="tools-grid">
					{category.tools.map((tool) => (
						<Window
							title={tool.title}
							badgeText={tool.badge}
							data-tool-title={tool.title.toLowerCase()}
							data-tool-desc={tool.description.toLowerCase()}
							data-date={tool.lastModified}
						>
							<div class="tool-card">
								<p class="tool-description">{tool.description}</p>
								<ul class="tool-features">
									{tool.features.map((feature) => <li>{feature}</li>)}
								</ul>
								<div class="tool-footer">
									{tool.url ? (
										<RetroButton href={tool.url} variant="primary" target="_blank" rel="noopener noreferrer">
											Visit Site
										</RetroButton>
									) : (
										<RetroButton href={`/tools/${tool.slug}`} variant="primary">
											Open Tool
										</RetroButton>
									)}
									<span class="tool-date">Updated: {new Date(tool.lastModified).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}</span>
								</div>
							</div>
						</Window>
					))}
				</div>
			</section>
		))}
	</div>

	<!-- Date View -->
	<div id="dateView" class="view-content" style="display: none;">
		<h2 class="view-title">All Tools (Newest First)</h2>
		<div class="tools-grid" id="dateViewGrid">
			{getToolsSortedByDate('newest').map((tool) => (
				<Window
					title={tool.title}
					badgeText={tool.badge}
					data-tool-title={tool.title.toLowerCase()}
					data-tool-desc={tool.description.toLowerCase()}
					data-date={tool.lastModified}
				>
					<div class="tool-card">
						<p class="tool-description">{tool.description}</p>
						<ul class="tool-features">
							{tool.features.map((feature) => <li>{feature}</li>)}
						</ul>
						<div class="tool-footer">
							{tool.url ? (
								<RetroButton href={tool.url} variant="primary" target="_blank" rel="noopener noreferrer">
									Visit Site
								</RetroButton>
							) : (
								<RetroButton href={`/tools/${tool.slug}`} variant="primary">
									Open Tool
								</RetroButton>
							)}
							<span class="tool-date">
								<span class="tool-category-badge">{tool.category}</span>
								Updated: {new Date(tool.lastModified).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
							</span>
						</div>
					</div>
				</Window>
			))}
		</div>
	</div>

	<!-- No Results Message -->
	<div id="noResults" class="no-results" style="display: none;">
		<Window title="No Tools Found">
			<p>No tools match your search. Try different keywords.</p>
		</Window>
	</div>

	<Window title="More Coming Soon" badgeText="WIP">
		<div class="prose">
			<p>
				Got an idea for a useful tool? <a href="https://github.com/zarguell/www/issues">Let me know</a> and I might add it to the collection.
			</p>
		</div>
	</Window>
</ToolLayout>

<style>
	.tools-hero {
		text-align: center;
		padding: 2rem 0;
	}

	.tools-hero h1 {
		font-size: 3rem;
		margin: 0 0 0.5rem 0;
	}

	.tools-subtitle {
		font-size: 1.3rem;
		color: var(--muted);
		margin: 0;
	}

	.tools-controls {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 2rem;
		padding: 1.5rem 0;
		margin-bottom: 2rem;
		flex-wrap: wrap;
	}

	.view-toggle {
		display: flex;
		gap: 1rem;
	}

	.view-toggle-btn {
		padding: 0.6em 1.2em;
		background: var(--bg2);
		border: 3px solid var(--border);
		color: var(--text);
		font-family: VT323, monospace;
		font-size: 1.1rem;
		cursor: pointer;
		transition: all 0.2s ease;
		box-shadow: 2px 2px 0 var(--shadow);
	}

	.view-toggle-btn:hover {
		background: var(--bg);
		transform: translate(1px, 1px);
		box-shadow: 1px 1px 0 var(--shadow);
	}

	.view-toggle-btn.active {
		background: var(--accent);
		color: var(--sticker-text);
		border-color: var(--accent);
	}

	.search-container {
		flex: 1;
		max-width: 400px;
	}

	.search-input {
		width: 100%;
		padding: 0.6em 1em;
		background: var(--bg);
		border: 3px solid var(--border);
		color: var(--text);
		font-family: VT323, monospace;
		font-size: 1.1rem;
		box-shadow: 2px 2px 0 var(--shadow);
		transition: all 0.2s ease;
	}

	.search-input:focus {
		outline: none;
		border-color: var(--accent);
		box-shadow: 3px 3px 0 var(--shadow);
	}

	.view-content {
		animation: fadeIn 0.3s ease;
	}

	@keyframes fadeIn {
		from {
			opacity: 0;
			transform: translateY(10px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	.view-title {
		font-size: 2rem;
		margin: 0 0 1.5rem 0;
		color: var(--accent);
		border-bottom: 3px solid var(--border);
		padding-bottom: 0.5rem;
	}

	.category-nav {
		display: flex;
		justify-content: center;
		flex-wrap: wrap;
		gap: 1rem;
		padding: 1.5rem 0;
		margin-bottom: 2rem;
		border-bottom: 2px solid var(--border);
	}

	.category-link {
		padding: 0.5rem 1rem;
		background: var(--bg2);
		border: 2px solid var(--border);
		color: var(--text);
		text-decoration: none;
		font-family: 'VT323', monospace;
		font-size: 1.1rem;
		transition: all 0.2s ease;
		box-shadow: 2px 2px 0 var(--shadow);
	}

	.category-link:hover {
		background: var(--accent);
		color: var(--bg);
		transform: translate(1px, 1px);
		box-shadow: 1px 1px 0 var(--shadow);
	}

	.tool-category {
		margin-bottom: 3rem;
		scroll-margin-top: 2rem;
	}

	.category-title {
		font-size: 2.5rem;
		margin: 0 0 0.5rem 0;
		color: var(--accent);
		border-bottom: 3px solid var(--border);
		padding-bottom: 0.5rem;
	}

	.category-description {
		font-size: 1.2rem;
		color: var(--muted);
		margin: 0 0 1.5rem 0;
	}

	.tools-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
		gap: 2rem;
		margin-bottom: 2rem;
	}

	.tool-card {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.tool-description {
		margin: 0;
		font-size: 1.1rem;
		line-height: 1.5;
		color: var(--text);
	}

	.tool-features {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	.tool-features li {
		font-size: 1rem;
		color: var(--muted);
		padding: 0.25rem 0;
	}

	.tool-footer {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 1rem;
		margin-top: auto;
		flex-wrap: wrap;
	}

	.tool-date {
		font-size: 0.9rem;
		color: var(--muted);
		display: flex;
		align-items: center;
		gap: 0.5rem;
		flex-wrap: wrap;
	}

	.tool-category-badge {
		background: var(--bg2);
		border: 2px solid var(--border);
		padding: 0.2em 0.6em;
		font-size: 0.85rem;
		border-radius: 3px;
	}

	.no-results {
		text-align: center;
		padding: 2rem;
	}

	@media (max-width: 768px) {
		.tools-controls {
			flex-direction: column;
			align-items: stretch;
		}

		.search-container {
			max-width: 100%;
		}

		.view-toggle {
			justify-content: center;
		}

		.tools-grid {
			grid-template-columns: 1fr;
		}

		.tools-hero h1 {
			font-size: 2.5rem;
		}

		.category-nav {
			flex-direction: column;
			align-items: stretch;
		}

		.category-link {
			text-align: center;
		}

		.category-title {
			font-size: 2rem;
		}

		.tool-footer {
			flex-direction: column;
			align-items: stretch;
		}
	}
</style>

<script>
	const categoryViewBtn = document.getElementById('categoryViewBtn') as HTMLElement;
	const dateViewBtn = document.getElementById('dateViewBtn') as HTMLElement;
	const categoryView = document.getElementById('categoryView') as HTMLElement;
	const dateView = document.getElementById('dateView') as HTMLElement;
	const searchInput = document.getElementById('searchInput') as HTMLInputElement;
	const noResults = document.getElementById('noResults');
	const categoryNav = document.getElementById('categoryNav') as HTMLElement;

	// View toggle functionality
	const switchView = (view: string) => {
		if (view === 'category') {
			categoryView.style.display = 'block';
			dateView.style.display = 'none';
			categoryViewBtn.classList.add('active');
			dateViewBtn.classList.remove('active');
			categoryNav.style.display = 'flex';
		} else {
			categoryView.style.display = 'none';
			dateView.style.display = 'block';
			categoryViewBtn.classList.remove('active');
			dateViewBtn.classList.add('active');
			categoryNav.style.display = 'none';
		}
		// Reapply search filter
		filterTools(searchInput.value);
	};

	categoryViewBtn?.addEventListener('click', () => switchView('category'));
	dateViewBtn?.addEventListener('click', () => switchView('date'));

	// Search functionality
	const filterTools = (searchTerm: string) => {
		const term = searchTerm.toLowerCase().trim();
		const toolWindows = document.querySelectorAll<HTMLElement>('[data-tool-title]');

		let hasResults = false;

		toolWindows.forEach((window) => {
			const title = window.getAttribute('data-tool-title') || '';
			const desc = window.getAttribute('data-tool-desc') || '';
			const matches = title.includes(term) || desc.includes(term);

			if (matches || term === '') {
				window.style.display = '';
				hasResults = true;
			} else {
				window.style.display = 'none';
			}
		});

		// Show/hide categories based on visible tools in category view
		if (categoryView.style.display !== 'none') {
			const categories = document.querySelectorAll<HTMLElement>('.tool-category');
			categories.forEach((category) => {
				const visibleTools = category.querySelectorAll('[data-tool-title]:not([style*="display: none"])');
				category.style.display = visibleTools.length > 0 ? '' : 'none';
			});
		}

		// Show no results message
		if (noResults) {
			noResults.style.display = !hasResults && term !== '' ? 'block' : 'none';
		}
	};

	searchInput?.addEventListener('input', (e) => {
		filterTools((e.target as HTMLInputElement).value);
	});
</script>
