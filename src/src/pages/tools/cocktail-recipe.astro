---
import ToolLayout from '../../layouts/ToolLayout.astro';
import Window from '../../components/Window.astro';
import RetroButton from '../../components/RetroButton.astro';
import RecipeCard from '../../components/RecipeCard.astro';
---

<ToolLayout title="Cocktail Recipe Maker - ARGUELLES.ME">
	<div class="tool-hero">
		<div class="hero-header">
			<div>
				<h1>Cocktail Recipe Maker</h1>
				<p class="tool-subtitle">Build and share custom cocktail recipes with optional batch calculations</p>
			</div>
			<div class="header-actions" id="headerActions">
				<button id="share-recipe-btn" class="retro-button retro-button-primary">Share Recipe</button>
				<button id="copy-to-edit-btn" class="retro-button retro-button--secondary retro-button--small" style="display:none;">Copy to Edit</button>
			</div>
		</div>
	</div>

	<div class="mode-notice" id="modeNotice"></div>

	<div class="cocktail-name-row">
		<input id="cocktailName" class="cocktail-name-input" placeholder="Cocktail name" value="My Batch Cocktail" />
		<span class="status-pill" id="headlinePill">Ready</span>
	</div>

	<!-- Manage UI (hidden in view mode) -->
	<div id="manageUI">
		<div class="batch-grid">
			<!-- Left: Ingredient library -->
			<Window title="Ingredient Library" badgeText="BUILD">
				<div class="form-row">
					<select id="presetSelect" class="preset-select"></select>
					<button id="addPresetBtn" class="retro-button retro-button--primary">Add</button>
				</div>

				<details class="custom-ingredient-details">
					<summary>➕ Add custom ingredient</summary>
					<div class="form-row">
						<input id="custEmoji" placeholder="🧪" class="emoji-input" />
						<input id="custName" placeholder="Name" class="name-input" />
					</div>
					<div class="form-row">
						<input id="custAbv" type="number" min="0" max="100" step="0.1" placeholder="Default ABV %" class="abv-input" />
						<button id="addCustomBtn" class="retro-button retro-button--secondary">Add custom</button>
					</div>
					<div class="muted">Set ABV to 0 for juices/syrups/mixers.</div>
				</details>

				<div class="kpi-container">
					<div class="kpi-box">
						<div class="kpi-label">Single serving (undiluted)</div>
						<div class="kpi-value"><span id="baseTotalMl">0</span> ml</div>
					</div>
					<div class="kpi-box">
						<div class="kpi-label">Single serving ethanol</div>
						<div class="kpi-value"><span id="baseEthanolMl">0</span> ml</div>
					</div>
				</div>
			</Window>

			<!-- Right: Recipe builder -->
			<Window title="Recipe Builder (Single Serving)" badgeText="RECIPE">
				<div class="recipe-header">
					<div class="recipe-controls">
						<button id="clearBtn" class="retro-button retro-button--secondary retro-button--small">Clear</button>
						<button id="exampleBtn" class="retro-button retro-button--secondary retro-button--small">Load Example</button>
					</div>
				</div>

				<div class="form-group" id="recipe-name-group">
					<label for="recipe-name">Recipe Name</label>
					<input
						type="text"
						id="recipe-name"
						name="recipe-name"
						placeholder="e.g., Spicy Margarita"
						required
					/>
				</div>

				<div class="recipe-table-wrapper">
					<table class="recipe-table">
						<thead>
							<tr>
								<th>Ingredient</th>
								<th class="right">Amount</th>
								<th>Unit</th>
								<th class="right">ABV%</th>
								<th class="center">Move</th>
								<th class="center">Remove</th>
							</tr>
						</thead>
						<tbody id="recipeTbody"></tbody>
					</table>
				</div>

				<div class="muted">
					ABV is editable per ingredient (useful for overproof spirits or specific brands).
				</div>

				<div class="form-group">
					<label for="preparationMethod">Preparation method</label>
					<select id="preparationMethod">
						<option value="none">None (build in glass)</option>
						<option value="stirred">Stirred with ice</option>
						<option value="shaken">Shaken with ice</option>
					</select>
					<div class="muted">How to prepare the cocktail - affects dilution information on the recipe card</div>
				</div>
			</Window>
		</div>
	</div>

	<!-- Batch mode toggle -->
	<div class="batch-toggle-section" id="batch-toggle">
		<label class="toggle-label">
			<input
				type="checkbox"
				id="batch-mode-toggle"
				name="batch-mode"
			/>
			<span>Enable Batch Calculator</span>
		</label>
	</div>

	<!-- Full width: Settings + output card -->
	<div id="batch-calculator">
		<Window title="Batch Settings & Export" badgeText="CALCULATE">
		<div class="batch-settings-grid">
			<div class="settings-column" id="settingsColumn">
				<div class="batch-mode-section">
					<div class="radio-group">
						<label class="radio-label">
							<input type="radio" name="scaleMode" value="total" checked />
							Target total volume
						</label>
						<label class="radio-label">
							<input type="radio" name="scaleMode" value="servings" />
							Number of servings
						</label>
					</div>
				</div>

				<div class="form-group" id="totalRow">
					<label for="targetTotal">Target final volume</label>
					<div class="input-row">
						<input id="targetTotal" type="number" value="750" min="1" step="1" />
						<select id="targetUnit">
							<option value="ml">ml</option>
							<option value="oz">oz</option>
							<option value="cup">cups</option>
							<option value="l">L</option>
						</select>
					</div>
					<div class="muted">Final volume including dilution water</div>
				</div>

				<div class="form-group" id="servingsRow" style="display:none">
					<label for="servings">Number of servings</label>
					<input id="servings" type="number" value="10" min="1" step="1" />
				</div>

				<div class="form-group">
					<label for="dilutionMode">Dilution method</label>
					<div class="input-row">
						<select id="dilutionMode">
							<option value="none">No dilution water</option>
							<option value="stirred">Stirred (20% default)</option>
							<option value="shaken">Shaken (30% default)</option>
							<option value="custom">Custom %</option>
						</select>
						<input id="customDilution" type="number" min="0" max="200" step="0.1" value="20" style="display:none" />
					</div>
					<div class="muted">
						If guests will pour the batch over fresh ice, consider aiming a bit lower because the glass ice will continue diluting.
					</div>
				</div>

				<div class="form-group">
					<label for="displayUnit">Display unit for recipe card</label>
					<select id="displayUnit">
						<option value="ml">ml</option>
						<option value="oz">oz</option>
						<option value="cup">cups</option>
						<option value="l">L</option>
					</select>
				</div>

				<div class="button-row">
					<button id="calcBtn" class="retro-button retro-button--primary">Recalculate</button>
				</div>

				<div class="form-group">
					<label for="cardNoteInput">Recipe card note (optional)</label>
					<textarea id="cardNoteInput" rows="2" placeholder="Add a custom note for your recipe card..."></textarea>
					<div class="muted">This note appears on the exported PNG image.</div>
				</div>

				<div class="button-row">
					<button id="saveBtn" class="retro-button retro-button--secondary">Save to Browser</button>
					<button id="loadBtn" class="retro-button retro-button--secondary">Load</button>
				</div>
			</div>

			<div class="export-column">
				<div class="export-section">
					<div class="export-header">
						<span class="status-pill">Batch Recipe Card</span>
						<button id="exportBtn" class="retro-button retro-button--primary">Export PNG</button>
					</div>

					<!-- Recipe Card -->
					<div id="card" class="recipe-card">
						<div class="card-header">
							<div class="card-title-section">
								<h3 id="cardTitle">My Batch Cocktail</h3>
								<div class="card-meta" id="cardMeta">Batching sheet</div>
							</div>
							<div class="card-tags">
								<div class="tag" id="tagMethod">Method: —</div>
								<div class="tag" id="tagFreezer">Freezer: —</div>
							</div>
						</div>

						<div class="card-stats">
							<div><strong>Final volume:</strong> <span id="cardFinalVol">—</span></div>
							<div><strong>ABV:</strong> <span id="cardAbv">—</span></div>
							<div><strong>Dilution water:</strong> <span id="cardWater">—</span></div>
						</div>

						<table class="card-table">
							<thead>
								<tr>
									<th>Ingredient</th>
									<th class="right">Scaled amount</th>
								</tr>
							</thead>
							<tbody id="cardBody"></tbody>
						</table>

						<div class="card-note" id="cardNotes">
							Notes: If guests will pour over fresh ice, consider lowering added water since the glass ice will keep diluting.
						</div>

						<div class="card-footer">
							Made on <a href="https://www.arguelles.me/tools/cocktail-recipe/" target="_blank" rel="noopener">www.arguelles.me/tools/cocktail-recipe/</a>
						</div>
					</div>
				</div>
			</div>
		</div>
	</Window>
	</div>

	<!-- Normal Mode Recipe Card (hidden when batch mode is enabled) -->
	<div id="normal-mode-card-section" style="display: none;">
		<Window title="Single Serving Recipe Card" badgeText="RECIPE">
			<div class="batch-settings-grid">
				<div class="settings-column" style="display: none;">
					<!-- Placeholder for alignment -->
				</div>

				<div class="export-column">
					<div class="export-section">
						<div class="export-header">
							<span class="status-pill">Single Serving Recipe Card</span>
							<button id="exportNormalBtn" class="retro-button retro-button--primary">Export PNG</button>
						</div>

						<!-- Normal Mode Recipe Card -->
						<div id="normalCard" class="recipe-card">
							<div class="card-header">
								<div class="card-title-section">
									<h3 id="normalCardTitle">My Cocktail</h3>
									<div class="card-meta" id="normalCardMeta">Single serving</div>
								</div>
								<div class="card-tags">
									<div class="tag" id="normalTagMethod">Method: —</div>
								</div>
							</div>

							<div class="card-stats">
								<div><strong>Total volume:</strong> <span id="normalCardVol">—</span></div>
								<div><strong>ABV:</strong> <span id="normalCardAbv">—</span></div>
								<div><strong>Preparation:</strong> <span id="normalCardPrep">—</span></div>
							</div>

							<table class="card-table">
								<thead>
									<tr>
										<th>Ingredient</th>
										<th class="right">Amount</th>
									</tr>
								</thead>
								<tbody id="normalCardBody"></tbody>
							</table>

							<div class="card-note" id="normalCardNotes" style="display: none;">
								Notes: —
							</div>

							<div class="card-footer">
								Made on <a href="https://www.arguelles.me/tools/cocktail-recipe/" target="_blank" rel="noopener">www.arguelles.me/tools/cocktail-recipe/</a>
							</div>
						</div>
					</div>
				</div>
			</div>
		</Window>
	</div>

	<!-- Recipe Preview Card -->
	<RecipeCard
		recipe={{
			name: '',
			ingredients: []
		}}
		mode="edit"
		preparationMethod="none"
		id="recipe-preview-card"
	/>

	<div class="toast" id="toast"></div>
</ToolLayout>

<!-- html-to-image for PNG export -->
<script is:inline src="https://unpkg.com/html-to-image@1.11.11/dist/html-to-image.js"></script>
<!-- LZ-String for compression -->
<script is:inline src="https://cdn.jsdelivr.net/npm/lz-string@1.5.0/libs/lz-string.min.js"></script>

<script>
	document.addEventListener('DOMContentLoaded', function() {
		// -------- Type Definitions --------
		interface Ingredient {
			emoji: string;
			name: string;
			amount: number;
			unit: string;
			abv: number;
		}

		interface Recipe {
			name: string;
			ingredients: Ingredient[];
			createdAt: number;
		}

		// -------- App Mode --------
		const app = {
			mode: 'manage' as 'manage' | 'view',
			batchMode: false,
			preparationMethod: 'none' as 'none' | 'stirred' | 'shaken',
			recipe: {
				name: '',
				ingredients: [] as Ingredient[],
				createdAt: Date.now()
			},
			batchSettings: {
				scaleMode: 'servings' as 'servings' | 'volume',
				targetValue: 1,
				dilution: 0.2
			},
			lastURLWriteOk: true
		};

		// -------- Units (volume only) --------
		// 1 US fl oz = 29.5735 ml; 1 US cup = 236.588 ml
		function toMl(value, unit) {
			const v = Number(value) || 0;
			if (unit === "ml") return v;
			if (unit === "l") return v * 1000;
			if (unit === "oz") return v * 29.5735;
			if (unit === "cup") return v * 236.588;
			return v;
		}

		function fromMl(ml, unit) {
			if (unit === "ml") return ml;
			if (unit === "l") return ml / 1000;
			if (unit === "oz") return ml / 29.5735;
			if (unit === "cup") return ml / 236.588;
			return ml;
		}

		function fmt(n, digits = 1) {
			const x = Number(n);
			if (!isFinite(x)) return "0";
			return x.toFixed(digits).replace(/\.0+$/, '').replace(/(\.\d*[1-9])0+$/, '$1');
		}

		// -------- Preset ingredients --------
		const presets = [
			{ emoji: "🍸", name: "Gin", abv: 40 },
			{ emoji: "🍸", name: "Vodka", abv: 40 },
			{ emoji: "🥃", name: "Bourbon", abv: 45 },
			{ emoji: "🥃", name: "Rye whiskey", abv: 45 },
			{ emoji: "🥃", name: "Scotch", abv: 43 },
			{ emoji: "🍹", name: "White rum", abv: 40 },
			{ emoji: "🍹", name: "Aged rum", abv: 40 },
			{ emoji: "🌵", name: "Tequila blanco", abv: 40 },
			{ emoji: "🌵", name: "Mezcal", abv: 45 },
			{ emoji: "🍊", name: "Triple sec", abv: 30 },
			{ emoji: "🍊", name: "Orange curaçao", abv: 40 },
			{ emoji: "🍷", name: "Sweet vermouth", abv: 16 },
			{ emoji: "🍷", name: "Dry vermouth", abv: 18 },
			{ emoji: "🍒", name: "Maraschino liqueur", abv: 32 },
			{ emoji: "🥥", name: "Coconut cream", abv: 0 },
			{ emoji: "🍍", name: "Pineapple juice", abv: 0 },
			{ emoji: "🍋", name: "Lemon juice", abv: 0 },
			{ emoji: "🍋", name: "Lime juice", abv: 0 },
			{ emoji: "🍯", name: "Simple syrup", abv: 0 },
			{ emoji: "🧊", name: "Soda water", abv: 0 },
			{ emoji: "🫚", name: "Ginger beer", abv: 0 },
			{ emoji: "☕", name: "Coffee", abv: 0 },
			{ emoji: "🧂", name: "Saline (drops)", abv: 0 },
			{ emoji: "🌿", name: "Bitters", abv: 44 },
		];

		// -------- App state --------
		const STORAGE_KEY = "cocktail_recipe_tool_v1";

		let recipe = [
			{ emoji: "🍸", name: "Gin", amount: 2, unit: "oz", abv: 40 },
			{ emoji: "🍋", name: "Lemon juice", amount: 1, unit: "oz", abv: 0 },
			{ emoji: "🍯", name: "Simple syrup", amount: 0.75, unit: "oz", abv: 0 }
		];

		// -------- DOM helpers --------
		const el = (id) => document.getElementById(id);

		// Populate preset select
		(function initPresetSelect() {
			const s = el("presetSelect");
			s.innerHTML = "";
			presets.forEach((p, i) => {
				const opt = document.createElement("option");
				opt.value = String(i);
				opt.textContent = `${p.emoji} ${p.name} (${p.abv}% ABV)`;
				s.appendChild(opt);
			});
		})();

		// -------- Compression & URL helpers --------
		function encodeState(obj) {
			return LZString.compressToEncodedURIComponent(JSON.stringify(obj));
		}

		function decodeState(str) {
			const json = LZString.decompressFromEncodedURIComponent(str);
			if (!json) return null;
			return JSON.parse(json);
		}

		function getParams() {
			const sp = new URLSearchParams(window.location.search);
			return { v: sp.get('v'), e: sp.get('e') };
		}

		function buildLink(kind) {
			// kind: 'view' => v=, 'manage' => e=
			const url = new URL(window.location.origin + window.location.pathname);
			const state = getStateForEncoding();
			const encoded = encodeState(state);
			if (kind === 'view') url.searchParams.set('v', encoded);
			else url.searchParams.set('e', encoded);
			return url.toString();
		}

		function getStateForEncoding() {
			const state: any = {
				n: app.recipe.name || "",
				i: recipe.map(ing => ({
					e: ing.emoji,
					n: ing.name,
					a: ing.amount,
					u: ing.unit,
					ab: ing.abv
				})),
				no: el("cardNoteInput").value || "",
				bm: app.batchMode,
				pm: app.preparationMethod || 'none',
				du: el("displayUnit").value
			};

			// Only include batch settings if batch mode is enabled
			if (app.batchMode) {
				state.bs = {
					sm: getScaleMode(),
					tv: el(getScaleMode() === "servings" ? "servings" : "targetTotal").value,
					d: getDilutionPct()
				};

				// Include target unit only if in volume mode
				if (getScaleMode() === "total") {
					state.bs.tu = el("targetUnit").value;
				}
			}

			return state;
		}

		function decodeStateToApp(state) {
			if (!state) return false;

			try {
				app.recipe.name = state.n || "";
				el("cocktailName").value = state.n || "Batch Cocktail";
				el("cardNoteInput").value = state.no || "";

				// Sync recipe name input field
				const recipeNameInput = el('recipe-name');
				if (recipeNameInput) {
					recipeNameInput.value = app.recipe.name;
				}

				// Decode recipe from new format
				if (Array.isArray(state.i)) {
					recipe = state.i.map(ing => ({
						emoji: ing.e,
						name: ing.n,
						amount: ing.a,
						unit: ing.u,
						abv: ing.ab
					}));
				}

				// Preparation method (defaults to 'none' for backward compatibility)
				app.preparationMethod = state.pm || 'none';
				el("preparationMethod").value = app.preparationMethod;

				// Display unit is always present
				el("displayUnit").value = state.du ?? "ml";

				// Check if this is the new format (with bm field) or old format (with sm field)
				if (state.bm !== undefined) {
					// NEW FORMAT: Hierarchical batch mode and settings
					app.batchMode = state.bm;

					if (state.bs && app.batchMode) {
						// Restore batch settings
						app.batchSettings = {
							scaleMode: state.bs.sm || 'servings',
							targetValue: state.bs.tv || 1,
							dilution: state.bs.d || 0.2
						};

						// Apply settings to DOM
						document.querySelector(`input[name="scaleMode"][value="${state.bs.sm || "servings"}"]`).checked = true;

						if (state.bs.sm === "servings") {
							el("servings").value = state.bs.tv || "1";
						} else {
							el("targetTotal").value = state.bs.tv || "750";
							el("targetUnit").value = state.bs.tu || "ml";
						}

						// Convert dilution decimal to mode and custom value
						const dilution = state.bs.d || 0.2;
						if (dilution === 0) {
							el("dilutionMode").value = "none";
						} else if (dilution === 0.2) {
							el("dilutionMode").value = "stirred";
						} else if (dilution === 0.3) {
							el("dilutionMode").value = "shaken";
						} else {
							el("dilutionMode").value = "custom";
							el("customDilution").value = String(dilution * 100);
						}
					}
				} else {
					// OLD FORMAT: Backward compatibility
					app.batchMode = false; // Default to false for old links
					document.querySelector(`input[name="scaleMode"][value="${state.sm || "total"}"]`).checked = true;
					el("targetTotal").value = state.tt ?? "750";
					el("targetUnit").value = state.tu ?? "ml";
					el("servings").value = state.sv ?? "10";
					el("dilutionMode").value = state.dm ?? "stirred";
					el("customDilution").value = state.cd ?? "20";
				}

				const mode = getScaleMode();
				el("totalRow").style.display = mode === "total" ? "" : "none";
				el("servingsRow").style.display = mode === "servings" ? "" : "none";
				el("customDilution").style.display = el("dilutionMode").value === "custom" ? "" : "none";

				return true;
			} catch (e) {
				console.error("Failed to decode state:", e);
				return false;
			}
		}

		function parseURLIntoState() {
			const { v, e } = getParams();

			if (v) {
				app.mode = 'view';
				const parsed = decodeState(v);
				if (parsed && decodeStateToApp(parsed)) return true;
			}

			if (e) {
				app.mode = 'manage';
				const parsed = decodeState(e);
				if (parsed && decodeStateToApp(parsed)) return true;
			}

			app.mode = 'manage';
			return false;
		}

		function writeManageURL() {
			if (app.mode !== 'manage') return;

			const url = new URL(window.location.href);
			url.searchParams.delete('v');
			url.searchParams.set('e', encodeState(getStateForEncoding()));

			if (url.toString().length > 2000) {
				app.lastURLWriteOk = false;
				return;
			}
			app.lastURLWriteOk = true;
			history.replaceState({}, '', url);
		}

		const writeManageURLDebounced = (() => {
			let t = null;
			return () => { clearTimeout(t); t = setTimeout(writeManageURL, 300); };
		})();

		async function copyLink(kind) {
			const url = buildLink(kind);
			try {
				await navigator.clipboard.writeText(url);
				toast(kind === 'view' ? 'Copied view link!' : 'Copied manage link!');
			} catch {
				toast('Could not copy automatically');
			}
		}

		// -------- Helpers --------
		function toast(msg) {
			const t = el("toast");
			t.textContent = msg;
			t.classList.add("show");
			setTimeout(() => t.classList.remove("show"), 2200);
		}

		function baseTotals() {
			const baseTotal = recipe.reduce((sum, i) => sum + toMl(i.amount, i.unit), 0);
			const ethanol = recipe.reduce((sum, i) => sum + toMl(i.amount, i.unit) * ((Number(i.abv) || 0) / 100), 0);
			return { baseTotal, ethanol };
		}

		function getScaleMode() {
			return document.querySelector('input[name="scaleMode"]:checked').value;
		}

		function getDilutionPct() {
			const mode = el("dilutionMode").value;
			if (mode === "none") return 0;
			if (mode === "shaken") return 0.30;
			if (mode === "stirred") return 0.20;
			if (mode === "custom") return (Number(el("customDilution").value || 0) / 100);
			return 0;
		}

		function methodLabel() {
			const mode = el("dilutionMode").value;
			if (mode === "none") return "No dilution";
			if (mode === "stirred") return "Stirred";
			if (mode === "shaken") return "Shaken";
			if (mode === "custom") return "Custom dilution";
			return "—";
		}

		function freezerTag(abvPct) {
			const a = Number(abvPct || 0);
			if (a <= 15) return { label: "Likely freezes (≤15% ABV)", cls: "danger" };
			if (a < 25) return { label: "May slush/freeze (~20% ABV)", cls: "warn" };
			if (a < 35) return { label: "Borderline (~30% ABV)", cls: "warn" };
			if (a < 50) return { label: "Likely liquid (~40% ABV)", cls: "ok" };
			return { label: "Very likely liquid (high ABV)", cls: "ok" };
		}

		function computeBatch() {
			const { baseTotal } = baseTotals();
			const dilutionPct = getDilutionPct();
			if (baseTotal <= 0) return null;

			let scale = 1;
			let finalTargetMl = null;
			let servings = null;

			if (getScaleMode() === "servings") {
				servings = Math.max(1, Number(el("servings").value || 1));
				scale = servings;
			} else {
				const targetFinalMl = toMl(el("targetTotal").value, el("targetUnit").value);
				finalTargetMl = targetFinalMl;
				const targetUndiluted = targetFinalMl / (1 + dilutionPct);
				scale = targetUndiluted / baseTotal;
			}

			const scaled = recipe.map(i => {
				const ml = toMl(i.amount, i.unit) * scale;
				const ethanolMl = ml * ((Number(i.abv) || 0) / 100);
				return { ...i, ml, ethanolMl };
			});

			const undilutedMl = scaled.reduce((s, i) => s + i.ml, 0);
			const waterMl = undilutedMl * dilutionPct;
			const finalMl = undilutedMl + waterMl;
			const ethanolMl = scaled.reduce((s, i) => s + i.ethanolMl, 0);
			const abvPct = finalMl > 0 ? (100 * ethanolMl / finalMl) : 0;

			return { scaled, undilutedMl, waterMl, finalMl, ethanolMl, abvPct, dilutionPct, finalTargetMl, servings, scale };
		}

		// -------- Rendering --------
		function applyModeUI() {
			const modeNotice = el("modeNotice");
			const manageUI = el("manageUI");
			const settingsColumn = el("settingsColumn");
			const shareRecipeBtn = el("share-recipe-btn");
			const copyToEditBtn = el("copy-to-edit-btn");
			const recipeNameInput = el("recipe-name");
			const batchToggle = document.getElementById('batch-mode-toggle') as HTMLInputElement;

			if (app.mode === 'view') {
				modeNotice.textContent = '📖 View-only mode - Recipe is read-only';
				modeNotice.className = 'mode-notice mode-notice--view';
				modeNotice.style.display = 'block';
				manageUI.style.display = 'none';

				// In view mode, hide settings column, only show recipe card
				settingsColumn.style.display = 'none';

				// Show "Copy to Edit" button, hide "Share Recipe" button
				shareRecipeBtn.style.display = 'none';
				copyToEditBtn.style.display = 'inline-block';

				// Disable recipe name input in view mode
				if (recipeNameInput) recipeNameInput.disabled = true;

				// Disable and sync batch toggle in view mode
				if (batchToggle) {
					batchToggle.disabled = true;
					batchToggle.checked = app.batchMode;
				}
			} else {
				modeNotice.textContent = '✏️ Edit mode - Share the view link with others';
				modeNotice.className = 'mode-notice mode-notice--manage';
				modeNotice.style.display = 'block';
				manageUI.style.display = 'block';
				settingsColumn.style.display = 'flex';

				// Show "Share Recipe" button, hide "Copy to Edit" button
				shareRecipeBtn.style.display = 'inline-block';
				copyToEditBtn.style.display = 'none';

				// Enable recipe name input in manage mode
				if (recipeNameInput) recipeNameInput.disabled = false;

				// Enable and sync batch toggle in manage mode
				if (batchToggle) {
					batchToggle.disabled = false;
					batchToggle.checked = app.batchMode;
				}
			}
		}

		function updateBaseKpis() {
			const { baseTotal, ethanol } = baseTotals();
			el("baseTotalMl").textContent = fmt(baseTotal, 1);
			el("baseEthanolMl").textContent = fmt(ethanol, 1);
		}

		function renderRecipe() {
			const tb = el("recipeTbody");
			tb.innerHTML = "";

			const canEdit = app.mode === 'manage';

			recipe.forEach((ing, idx) => {
				const tr = document.createElement("tr");

				const tdName = document.createElement("td");
				tdName.textContent = `${ing.emoji} ${ing.name}`;
				tr.appendChild(tdName);

				const tdAmt = document.createElement("td");
				tdAmt.className = "right";
				if (canEdit) {
					const amt = document.createElement("input");
					amt.type = "number";
					amt.step = "0.01";
					amt.min = "0";
					amt.value = ing.amount;
					amt.oninput = () => {
						ing.amount = Number(amt.value || 0);
						updateBaseKpis();
						calculateAndRenderCard();
						writeManageURLDebounced();
					};
					tdAmt.appendChild(amt);
				} else {
					tdAmt.textContent = `${fmt(ing.amount, 2)} ${ing.unit}`;
				}
				tr.appendChild(tdAmt);

				const tdUnit = document.createElement("td");
				if (canEdit) {
					const unit = document.createElement("select");
					["ml", "oz", "cup", "l"].forEach(u => {
						const o = document.createElement("option");
						o.value = u;
						o.textContent = u;
						if (u === ing.unit) o.selected = true;
						unit.appendChild(o);
					});
					unit.onchange = () => {
						ing.unit = unit.value;
						updateBaseKpis();
						calculateAndRenderCard();
						writeManageURLDebounced();
					};
					tdUnit.appendChild(unit);
				} else {
					tdUnit.textContent = ing.unit;
				}
				tr.appendChild(tdUnit);

				const tdAbv = document.createElement("td");
				tdAbv.className = "right";
				if (canEdit) {
					const abv = document.createElement("input");
					abv.type = "number";
					abv.step = "0.1";
					abv.min = "0";
					abv.max = "100";
					abv.value = ing.abv;
					abv.oninput = () => {
						ing.abv = Number(abv.value || 0);
						updateBaseKpis();
						calculateAndRenderCard();
						writeManageURLDebounced();
					};
					tdAbv.appendChild(abv);
				} else {
					tdAbv.textContent = `${ing.abv}%`;
				}
				tr.appendChild(tdAbv);

				const tdMove = document.createElement("td");
				tdMove.className = "center";
				if (canEdit) {
					const up = document.createElement("button");
					up.className = "icon-button";
					up.textContent = "↑";
					up.disabled = idx === 0;
					up.onclick = () => {
						[recipe[idx - 1], recipe[idx]] = [recipe[idx], recipe[idx - 1]];
						renderRecipe();
						calculateAndRenderCard();
						writeManageURLDebounced();
					};
					const down = document.createElement("button");
					down.className = "icon-button";
					down.textContent = "↓";
					down.disabled = idx === recipe.length - 1;
					down.onclick = () => {
						[recipe[idx + 1], recipe[idx]] = [recipe[idx], recipe[idx + 1]];
						renderRecipe();
						calculateAndRenderCard();
						writeManageURLDebounced();
					};
					tdMove.appendChild(up);
					tdMove.appendChild(down);
				}
				tr.appendChild(tdMove);

				const tdX = document.createElement("td");
				tdX.className = "center";
				if (canEdit) {
					const x = document.createElement("button");
					x.className = "icon-button icon-button--danger";
					x.textContent = "✕";
					x.onclick = () => {
						recipe.splice(idx, 1);
						renderRecipe();
						calculateAndRenderCard();
						writeManageURLDebounced();
					};
					tdX.appendChild(x);
				}
				tr.appendChild(tdX);

				tb.appendChild(tr);
			});

			updateBaseKpis();
		}

		function setHeadline(msg, kind = "ok") {
			const pill = el("headlinePill");
			pill.textContent = msg;
			pill.className = `status-pill status-pill--${kind}`;
		}

		function updateRecipeCard() {
			const card = document.getElementById('recipe-card');
			if (!card) return;

			// Update recipe name
			const header = card.querySelector('.recipe-card-header h2');
			if (header) {
				header.textContent = app.recipe.name || el("cocktailName").value || 'Untitled Recipe';
			}

			// Update ingredients list
			const list = card.querySelector('.ingredient-list');
			if (list) {
				list.innerHTML = '';
				recipe.forEach(ing => {
					const li = document.createElement('li');
					li.className = 'ingredient-item';
					li.innerHTML = `
						<span class="ingredient-emoji">${ing.emoji}</span>
						<span class="ingredient-name">${ing.name}</span>
						<span class="ingredient-amount">${ing.amount} ${ing.unit}</span>
					`;
					list.appendChild(li);
				});
			}

			// Update stats
			const totalVolume = recipe.reduce((sum, ing) => sum + toMl(ing.amount, ing.unit), 0);
			const totalAlcohol = recipe.reduce((sum, ing) => sum + (toMl(ing.amount, ing.unit) * ing.abv / 100), 0);
			const finalABV = totalVolume > 0 ? (totalAlcohol / totalVolume) * 100 : 0;

			const statValues = card.querySelectorAll('.stat-value');
			if (statValues.length >= 3) {
				statValues[0].textContent = `${Math.round(totalVolume)} ml`;
				statValues[1].textContent = `${finalABV.toFixed(1)}% ABV`;
				// Update preparation method label
				const prepLabels = { 'none': 'Build in glass', 'stirred': 'Stirred', 'shaken': 'Shaken' };
				statValues[2].textContent = prepLabels[app.preparationMethod] || '—';
			}

			// Update mode and buttons
			const actionsDiv = card.querySelector('.recipe-card-actions');
			if (actionsDiv) {
				const isEditMode = app.mode === 'manage';
				actionsDiv.innerHTML = isEditMode
					? `
						<button class="retro-button retro-button-primary" data-action="share-recipe">
							Share Recipe
						</button>
						<button class="retro-button retro-button-secondary" data-action="export-png">
							Export PNG
						</button>
					`
					: `
						<button class="retro-button retro-button-secondary" data-action="copy-to-edit">
							Copy to Edit
						</button>
					`;
			}
		}

		function calculateAndRenderCard() {
			// Update the new RecipeCard component
			updateRecipeCard();

			// Update normal mode card
			updateNormalModeCard();

			// Update batch mode card (if batch mode is enabled)
			if (!app.batchMode) return;

			el("cardTitle").textContent = app.recipe.name || el("cocktailName").value || "Batch Cocktail";

			const batch = computeBatch();
			if (!batch) {
				el("cardFinalVol").textContent = "—";
				el("cardAbv").textContent = "—";
				el("cardWater").textContent = "—";
				el("cardBody").innerHTML = "";
				setHeadline("Add ingredients", "danger");
				return;
			}

			const dispUnit = el("displayUnit").value;

			el("tagMethod").textContent = `Method: ${methodLabel()}`;
			const freezer = freezerTag(batch.abvPct);
			el("tagFreezer").textContent = `Freezer: ${freezer.label}`;
			el("tagFreezer").className = `tag tag--${freezer.cls}`;

			el("cardMeta").textContent =
				getScaleMode() === "servings"
					? `Scaled to ${batch.servings} servings (dilution ${fmt(batch.dilutionPct * 100, 1)}%)`
					: `Scaled to target total (dilution ${fmt(batch.dilutionPct * 100, 1)}%)`;

			const finalDisp = fromMl(batch.finalMl, dispUnit);
			el("cardFinalVol").textContent = `${fmt(finalDisp, dispUnit === "ml" ? 0 : 2)} ${dispUnit}`;

			el("cardAbv").textContent = `${fmt(batch.abvPct, 1)}%`;

			const waterDisp = fromMl(batch.waterMl, dispUnit);
			el("cardWater").textContent = `${fmt(waterDisp, dispUnit === "ml" ? 0 : 2)} ${dispUnit}`;

			const body = el("cardBody");
			body.innerHTML = "";
			batch.scaled.forEach(i => {
				const tr = document.createElement("tr");
				const td1 = document.createElement("td");
				td1.textContent = `${i.emoji} ${i.name}`;
				const td2 = document.createElement("td");
				td2.className = "right";
				const v = fromMl(i.ml, dispUnit);
				td2.textContent = `${fmt(v, dispUnit === "ml" ? 0 : 2)} ${dispUnit}`;
				tr.appendChild(td1);
				tr.appendChild(td2);
				body.appendChild(tr);
			});

			const noteInput = el("cardNoteInput").value.trim();
			if (noteInput) {
				el("cardNotes").textContent = `Notes: ${noteInput}`;
				el("cardNotes").style.display = "block";
			} else {
				el("cardNotes").style.display = "none";
			}

			if (getScaleMode() === "servings") {
				setHeadline(`Scaled ×${fmt(batch.scale, 2)} (servings)`);
			} else {
				const tgtMl = toMl(el("targetTotal").value, el("targetUnit").value);
				setHeadline(`Target ${fmt(tgtMl, 0)} ml final • ABV ${fmt(batch.abvPct, 1)}%`);
			}
		}

		function updateNormalModeCard() {
			const name = app.recipe.name || el("cocktailName").value || "My Cocktail";
			el("normalCardTitle").textContent = name;

			// Calculate totals for single serving
			const totalVolume = recipe.reduce((sum, ing) => sum + toMl(ing.amount, ing.unit), 0);
			const totalAlcohol = recipe.reduce((sum, ing) => sum + (toMl(ing.amount, ing.unit) * ing.abv / 100), 0);
			const finalABV = totalVolume > 0 ? (totalAlcohol / totalVolume) * 100 : 0;

			// Update stats
			el("normalCardVol").textContent = recipe.length > 0 ? `${Math.round(totalVolume)} ml` : "—";
			el("normalCardAbv").textContent = recipe.length > 0 ? `${finalABV.toFixed(1)}%` : "—";

			// Update preparation method
			const prepLabels = { 'none': 'Build in glass', 'stirred': 'Stirred', 'shaken': 'Shaken' };
			el("normalCardPrep").textContent = prepLabels[app.preparationMethod] || "—";
			el("normalTagMethod").textContent = `Method: ${prepLabels[app.preparationMethod] || "None"}`;

			// Update ingredients
			const body = el("normalCardBody");
			body.innerHTML = "";

			if (recipe.length === 0) {
				setHeadline("Add ingredients", "danger");
				return;
			}

			recipe.forEach(ing => {
				const tr = document.createElement("tr");
				const td1 = document.createElement("td");
				td1.textContent = `${ing.emoji} ${ing.name}`;
				const td2 = document.createElement("td");
				td2.className = "right";
				td2.textContent = `${ing.amount} ${ing.unit}`;
				tr.appendChild(td1);
				tr.appendChild(td2);
				body.appendChild(tr);
			});

			setHeadline("Ready");
		}

		function syncAll() {
			applyModeUI();
			updateBatchVisibility();
			renderRecipe();
			calculateAndRenderCard();
			if (app.mode === 'manage') writeManageURLDebounced();
		}

		// -------- State Persistence --------
		function saveState() {
			const state = {
				recipe: {
					name: app.recipe.name,
					ingredients: app.recipe.ingredients,
					createdAt: app.recipe.createdAt
				},
				batchMode: app.batchMode,
				preparationMethod: app.preparationMethod,
				batchSettings: app.batchSettings
			};
			localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
		}

		function loadState() {
			const saved = localStorage.getItem(STORAGE_KEY);
			if (saved) {
				const state = JSON.parse(saved);
				app.recipe.name = state.recipe?.name || '';
				app.recipe.ingredients = state.recipe?.ingredients || [];
				app.recipe.createdAt = state.recipe?.createdAt || Date.now();
				app.batchMode = state.batchMode || false;
				app.preparationMethod = state.preparationMethod || 'none';
				app.batchSettings = state.batchSettings || {
					scaleMode: 'servings',
					targetValue: 1,
					dilution: 0.2
				};

				// Update DOM with loaded state
				const recipeNameInput = el('recipe-name');
				if (recipeNameInput && app.recipe.name) {
					recipeNameInput.value = app.recipe.name;
				}

				// Sync preparation method selector
				el("preparationMethod").value = app.preparationMethod;

				// Sync batch toggle immediately to reflect loaded state
				const batchToggle = document.getElementById('batch-mode-toggle') as HTMLInputElement;
				if (batchToggle) {
					batchToggle.checked = app.batchMode;
				}
			}
		}

		// -------- Events --------
		// Share recipe button (edit mode)
		const shareRecipeBtn = el("share-recipe-btn");
		shareRecipeBtn?.addEventListener("click", () => {
			const link = buildLink('edit');
			navigator.clipboard.writeText(link);
			toast('Recipe link copied!');
		});

		// Copy to edit button (view mode)
		const copyToEditBtn = el("copy-to-edit-btn");
		copyToEditBtn?.addEventListener("click", () => {
			const link = buildLink('edit');
			window.location.href = link;
		});

		// -------- RecipeCard Event Handlers (exposed globally) --------
		window.handleRecipeCardShare = function() {
			const link = buildLink('edit');
			navigator.clipboard.writeText(link);
			toast('Recipe link copied!');
		};

		window.handleRecipeCardCopyToEdit = function() {
			const link = buildLink('edit');
			window.location.href = link;
		};

		window.handleRecipeCardExportPNG = async function() {
			const card = document.getElementById('recipe-card');
			if (!card) {
				toast('Recipe card not found');
				return;
			}
			try {
				toast("Rendering PNG…");
				const dataUrl = await htmlToImage.toPng(card, {
					pixelRatio: 2,
					cacheBust: true,
					backgroundColor: "#ffffff"
				});
				const a = document.createElement("a");
				const name = (app.recipe.name || el("cocktailName").value || "recipe").trim().replace(/[^\w\-]+/g, "_");
				a.download = `${name}.png`;
				a.href = dataUrl;
				a.click();
				toast("Downloaded PNG");
			} catch (err) {
				console.error(err);
				toast("Export failed (try another browser)");
			}
		};

		el("addPresetBtn").addEventListener("click", () => {
			if (app.mode !== 'manage') return;
			const p = presets[Number(el("presetSelect").value)];
			recipe.push({ ...p, amount: 1, unit: "oz" });
			syncAll();
			toast("Added ingredient");
		});

		el("addCustomBtn").addEventListener("click", () => {
			if (app.mode !== 'manage') return;
			const emoji = (el("custEmoji").value || "🧪").trim();
			const name = (el("custName").value || "Custom").trim();
			const abv = Number(el("custAbv").value || 0);

			recipe.push({ emoji, name, amount: 1, unit: "oz", abv });
			el("custEmoji").value = "";
			el("custName").value = "";
			el("custAbv").value = "";
			syncAll();
			toast("Added custom ingredient");
		});

		el("cocktailName").addEventListener("input", () => {
			calculateAndRenderCard();
			writeManageURLDebounced();
		});
		el("cardNoteInput").addEventListener("input", () => {
			calculateAndRenderCard();
			writeManageURLDebounced();
		});

		// Recipe name input listener
		const recipeNameInput = el('recipe-name');
		recipeNameInput?.addEventListener('input', (e) => {
			app.recipe.name = e.target.value;
			saveState();
		});

		// Preparation method listener
		el("preparationMethod").addEventListener("change", (e) => {
			app.preparationMethod = e.target.value as 'none' | 'stirred' | 'shaken';
			calculateAndRenderCard();
			saveState();
			writeManageURLDebounced();
