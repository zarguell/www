			el("customDilution").style.display = mode === "custom" ? "" : "none";
			if (mode === "custom") el("customDilution").value = "25";
			if (mode === "stirred") el("customDilution").value = "20";
			if (mode === "shaken") el("customDilution").value = "30";
			calculateAndRenderCard();
			writeManageURLDebounced();
		});

		el("customDilution").addEventListener("input", () => {
			calculateAndRenderCard();
			writeManageURLDebounced();
		});
		el("calcBtn").addEventListener("click", () => {
			calculateAndRenderCard();
			writeManageURLDebounced();
		});

		el("clearBtn").addEventListener("click", () => {
			if (app.mode !== 'manage') return;
			recipe = [];
			syncAll();
			toast("Cleared");
		});

		el("exampleBtn").addEventListener("click", () => {
			if (app.mode !== 'manage') return;
			recipe = [
				{ emoji: "🥃", name: "Bourbon", amount: 2, unit: "oz", abv: 45 },
				{ emoji: "🍋", name: "Lemon juice", amount: 0.75, unit: "oz", abv: 0 },
				{ emoji: "🍯", name: "Simple syrup", amount: 0.75, unit: "oz", abv: 0 },
				{ emoji: "🌿", name: "Bitters", amount: 0.1, unit: "oz", abv: 44 }
			];
			el("cocktailName").value = "Whiskey Sour-ish Batch";
			el("dilutionMode").value = "shaken";
			el("customDilution").value = "30";
			syncAll();
			toast("Loaded example");
		});

		el("saveBtn").addEventListener("click", () => {
			if (app.mode !== 'manage') return;
			const payload = {
				cocktailName: el("cocktailName").value || "",
				cardNote: el("cardNoteInput").value || "",
				recipe,
				scaleMode: getScaleMode(),
				targetTotal: el("targetTotal").value,
				targetUnit: el("targetUnit").value,
				servings: el("servings").value,
				dilutionMode: el("dilutionMode").value,
				customDilution: el("customDilution").value,
				displayUnit: el("displayUnit").value
			};
			localStorage.setItem(STORAGE_KEY, JSON.stringify(payload));
			toast("Saved");
		});

		el("loadBtn").addEventListener("click", () => {
			if (app.mode !== 'manage') return;
			const raw = localStorage.getItem(STORAGE_KEY);
			if (!raw) return toast("Nothing saved yet");
			try {
				const p = JSON.parse(raw);
				decodeStateToApp(p);
				syncAll();
				toast("Loaded");
			} catch (e) {
				toast("Load failed (bad data)");
			}
		});

		el("exportBtn").addEventListener("click", async () => {
			const node = el("card");
			try {
				toast("Rendering PNG…");
				const dataUrl = await htmlToImage.toPng(node, {
					pixelRatio: 2,
					cacheBust: true,
					backgroundColor: "#ffffff"
				});
				const a = document.createElement("a");
				const name = (el("cocktailName").value || "batch-recipe").trim().replace(/[^\w\-]+/g, "_");
				a.download = `${name}.png`;
				a.href = dataUrl;
				a.click();
				toast("Downloaded PNG");
			} catch (err) {
				console.error(err);
				toast("Export failed (try another browser)");
			}
		});

		el("exportNormalBtn").addEventListener("click", async () => {
			const node = el("normalCard");
			try {
				toast("Rendering PNG…");
				const dataUrl = await htmlToImage.toPng(node, {
					pixelRatio: 2,
					cacheBust: true,
					backgroundColor: "#ffffff"
				});
				const a = document.createElement("a");
				const name = (app.recipe.name || el("cocktailName").value || "recipe").trim().replace(/[^\w\-]+/g, "_");
				a.download = `${name}.png`;
				a.href = dataUrl;
				a.click();
				toast("Downloaded PNG");
			} catch (err) {
				console.error(err);
				toast("Export failed (try another browser)");
			}
		});

		window.addEventListener('popstate', () => {
			parseURLIntoState();
			syncAll();
		});

		// -------- Init --------
		loadState();
		parseURLIntoState();
		syncAll();

		// Creator flow: if no params, create manage link immediately
		const { v, e } = getParams();
		if (!v && !e) {
			app.mode = 'manage';
			const url = new URL(window.location.origin + window.location.pathname);
			url.searchParams.set('e', encodeState(getStateForEncoding()));
			history.replaceState({}, '', url);
			syncAll();
		}
	});
</script>

