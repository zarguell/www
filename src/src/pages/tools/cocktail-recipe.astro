---
import ToolLayout from '../../layouts/ToolLayout.astro';
import Window from '../../components/Window.astro';
import RetroButton from '../../components/RetroButton.astro';

const ogImage = new URL('/assets/cocktail-og.jpg', Astro.site);
---

<ToolLayout title="Cocktail Recipe Maker - ARGUELLES.ME" ogImage={ogImage.href}>
	<div class="tool-hero">
		<div class="hero-header">
			<div>
				<h1>Cocktail Recipe Maker</h1>
				<p class="tool-subtitle">Build and share custom cocktail recipes with optional batch calculations</p>
			</div>
			<div class="header-actions" id="headerActions">
				<button id="share-recipe-btn" class="retro-button retro-button--primary">Share Recipe</button>
				<button id="copy-to-edit-btn" class="retro-button retro-button--secondary retro-button--small" style="display:none;">Copy to Edit</button>
			</div>
		</div>
	</div>

	<div class="mode-notice" id="modeNotice"></div>

	<div class="cocktail-name-row">
		<input id="cocktailName" class="cocktail-name-input" placeholder="Cocktail name" value="My Batch Cocktail" aria-label="Cocktail name" />
		<span class="status-pill" id="headlinePill">Ready</span>
	</div>

	<!-- Manage UI (hidden in view mode) -->
	<div id="manageUI">
		<div class="batch-grid">
			<!-- Left: Ingredient library -->
			<Window title="Ingredient Library" badgeText="BUILD">
				<div class="form-row">
					<select id="presetSelect" class="preset-select" aria-label="Preset ingredient"></select>
					<button id="addPresetBtn" class="retro-button retro-button--primary">Add</button>
				</div>

				<details class="custom-ingredient-details">
					<summary>➕ Add custom ingredient</summary>
					<div class="form-row">
						<input id="custEmoji" placeholder="🧪" class="emoji-input" aria-label="Custom ingredient emoji" />
						<input id="custName" placeholder="Name" class="name-input" aria-label="Custom ingredient name" />
					</div>
					<div class="form-row">
						<input id="custAbv" type="number" min="0" max="100" step="0.1" placeholder="Default ABV %" class="abv-input" aria-label="Custom ingredient ABV percent" />
						<button id="addCustomBtn" class="retro-button retro-button--secondary">Add custom</button>
					</div>
					<div class="muted">Set ABV to 0 for juices/syrups/mixers.</div>
				</details>

				<div class="kpi-container">
					<div class="kpi-box">
						<div class="kpi-label">Single serving (undiluted)</div>
						<div class="kpi-value"><span id="baseTotalMl">0</span> ml</div>
					</div>
					<div class="kpi-box">
						<div class="kpi-label">Single serving ethanol</div>
						<div class="kpi-value"><span id="baseEthanolMl">0</span> ml</div>
					</div>
				</div>
			</Window>

			<!-- Right: Recipe builder -->
			<Window title="Recipe Builder (Single Serving)" badgeText="RECIPE">
				<div class="recipe-header">
					<div class="recipe-controls">
						<button id="clearBtn" class="retro-button retro-button--secondary retro-button--small">Clear</button>
						<button id="exampleBtn" class="retro-button retro-button--secondary retro-button--small">Load Example</button>
					</div>
				</div>

				<div class="form-group" id="recipe-name-group">
					<label for="recipe-name">Recipe Name</label>
					<input
						type="text"
						id="recipe-name"
						name="recipe-name"
						placeholder="e.g., Spicy Margarita"
						required
					/>
				</div>

				<div class="recipe-table-wrapper">
					<table class="recipe-table">
						<thead>
							<tr>
								<th>Ingredient</th>
								<th class="right">Amount</th>
								<th>Unit</th>
								<th class="right">ABV%</th>
								<th class="center">Move</th>
								<th class="center">Remove</th>
							</tr>
						</thead>
						<tbody id="recipeTbody"></tbody>
					</table>
				</div>

				<div class="muted">
					ABV is editable per ingredient (useful for overproof spirits or specific brands).
				</div>

				<div class="form-group">
					<label for="preparationMethod">Preparation method</label>
					<select id="preparationMethod">
						<option value="none">None (build in glass)</option>
						<option value="stirred">Stirred with ice</option>
						<option value="shaken">Shaken with ice</option>
					</select>
					<div class="muted">How to prepare the cocktail - affects dilution information on the recipe card</div>
				</div>
			</Window>
		</div>
	</div>

	<!-- Batch mode toggle -->
	<div class="batch-toggle-section" id="batch-toggle">
		<label class="toggle-label">
			<input
				type="checkbox"
				id="batch-mode-toggle"
				name="batch-mode"
			/>
			<span>Enable Batch Calculator</span>
		</label>
	</div>

	<!-- Full width: Settings + output card -->
	<div id="batch-calculator">
		<Window title="Batch Settings & Export" badgeText="CALCULATE">
		<div class="batch-settings-grid">
			<div class="settings-column" id="settingsColumn">
				<div class="batch-mode-section">
					<div class="radio-group">
						<label class="radio-label">
							<input type="radio" name="scaleMode" value="total" checked />
							Target total volume
						</label>
						<label class="radio-label">
							<input type="radio" name="scaleMode" value="servings" />
							Number of servings
						</label>
					</div>
				</div>

				<div class="form-group" id="totalRow">
					<label for="targetTotal">Target final volume</label>
					<div class="input-row">
						<input id="targetTotal" type="number" value="750" min="1" step="1" />
						<select id="targetUnit">
							<option value="ml">ml</option>
							<option value="oz">oz</option>
							<option value="cup">cups</option>
							<option value="l">L</option>
						</select>
					</div>
					<div class="muted">Final volume including dilution water</div>
				</div>

				<div class="form-group" id="servingsRow" style="display:none">
					<label for="servings">Number of servings</label>
					<input id="servings" type="number" value="10" min="1" step="1" />
				</div>

				<div class="form-group">
					<label for="dilutionMode">Dilution method</label>
					<div class="input-row">
						<select id="dilutionMode">
							<option value="none">No dilution water</option>
							<option value="stirred">Stirred (20% default)</option>
							<option value="shaken">Shaken (30% default)</option>
							<option value="custom">Custom %</option>
						</select>
						<input id="customDilution" type="number" min="0" max="200" step="0.1" value="20" style="display:none" />
					</div>
					<div class="muted">
						If guests will pour the batch over fresh ice, consider aiming a bit lower because the glass ice will continue diluting.
					</div>
				</div>

				<div class="form-group">
					<label for="displayUnit">Display unit for recipe card</label>
					<select id="displayUnit">
						<option value="ml">ml</option>
						<option value="oz">oz</option>
						<option value="cup">cups</option>
						<option value="l">L</option>
					</select>
				</div>

				<div class="button-row">
					<button id="calcBtn" class="retro-button retro-button--primary">Recalculate</button>
				</div>

				<div class="form-group">
					<label for="cardNoteInput">Recipe card note (optional)</label>
					<textarea id="cardNoteInput" rows="2" placeholder="Add a custom note for your recipe card..."></textarea>
					<div class="muted">This note appears on the exported PNG image.</div>
				</div>

				<div class="button-row">
					<button id="saveBtn" class="retro-button retro-button--secondary">Save to Browser</button>
					<button id="loadBtn" class="retro-button retro-button--secondary">Load</button>
				</div>
			</div>

			<div class="export-column">
				<div class="export-section">
					<div class="export-header">
						<span class="status-pill">Batch Recipe Card</span>
						<button id="exportBtn" class="retro-button retro-button--primary">Export PNG</button>
					</div>

					<!-- Recipe Card -->
					<div id="card" class="recipe-card">
						<div class="card-header">
							<div class="card-title-section">
								<h3 id="cardTitle">My Batch Cocktail</h3>
								<div class="card-meta" id="cardMeta">Batching sheet</div>
							</div>
							<div class="card-tags">
								<div class="tag" id="tagMethod">Method: —</div>
								<div class="tag" id="tagFreezer">Freezer: —</div>
							</div>
						</div>

						<div class="card-stats">
							<div><strong>Final volume:</strong> <span id="cardFinalVol">—</span></div>
							<div><strong>ABV:</strong> <span id="cardAbv">—</span></div>
							<div><strong>Dilution water:</strong> <span id="cardWater">—</span></div>
						</div>

						<table class="card-table">
							<thead>
								<tr>
									<th>Ingredient</th>
									<th class="right">Scaled amount</th>
								</tr>
							</thead>
							<tbody id="cardBody"></tbody>
						</table>

						<div class="card-note" id="cardNotes">
							Notes: If guests will pour over fresh ice, consider lowering added water since the glass ice will keep diluting.
						</div>

						<div class="card-footer">
							Made on <a href="https://www.arguelles.me/tools/cocktail-recipe/" target="_blank" rel="noopener">www.arguelles.me/tools/cocktail-recipe/</a>
						</div>
					</div>
				</div>
			</div>
		</div>
	</Window>
	</div>

	<!-- Normal Mode Recipe Card (hidden when batch mode is enabled) -->
	<div id="normal-mode-card-section" style="display: none;">
		<Window title="Single Serving Recipe Card" badgeText="RECIPE">
			<div class="batch-settings-grid">
				<div class="settings-column" style="display: none;">
					<!-- Placeholder for alignment -->
				</div>

				<div class="export-column">
					<div class="export-section">
						<div class="export-header">
							<span class="status-pill">Single Serving Recipe Card</span>
							<button id="exportNormalBtn" class="retro-button retro-button--primary">Export PNG</button>
						</div>

						<!-- Normal Mode Recipe Card -->
						<div id="normalCard" class="recipe-card">
							<div class="card-header">
								<div class="card-title-section">
									<h3 id="normalCardTitle">My Cocktail</h3>
									<div class="card-meta" id="normalCardMeta">Single serving</div>
								</div>
								<div class="card-tags">
									<div class="tag" id="normalTagMethod">Method: —</div>
								</div>
							</div>

							<div class="card-stats">
								<div><strong>Total volume:</strong> <span id="normalCardVol">—</span></div>
								<div><strong>ABV:</strong> <span id="normalCardAbv">—</span></div>
								<div><strong>Preparation:</strong> <span id="normalCardPrep">—</span></div>
							</div>

							<table class="card-table">
								<thead>
									<tr>
										<th>Ingredient</th>
										<th class="right">Amount</th>
									</tr>
								</thead>
								<tbody id="normalCardBody"></tbody>
							</table>

							<div class="card-note" id="normalCardNotes" style="display: none;">
								Notes: —
							</div>

							<div class="card-footer">
								Made on <a href="https://www.arguelles.me/tools/cocktail-recipe/" target="_blank" rel="noopener">www.arguelles.me/tools/cocktail-recipe/</a>
							</div>
						</div>
					</div>
				</div>
			</div>
		</Window>
	</div>

	<div class="toast" id="toast"></div>
</ToolLayout>

<!-- html-to-image for PNG export -->
<script is:inline src="https://unpkg.com/html-to-image@1.11.11/dist/html-to-image.js" integrity="sha384-UbfRVKN3/elS1r7JcK2FhmPP+KlJ4CvYwbyYD7tH+uTkbT9bNJr9eJeQ0FoFbAgz" crossorigin="anonymous"></script>
<!-- LZ-String for compression -->
<script is:inline src="https://cdn.jsdelivr.net/npm/lz-string@1.5.0/libs/lz-string.min.js" integrity="sha384-0d+Gr7vM4Drod8E3hXKgciWJSWbjD/opKLLygI9ktiWbuvlDwQLzU46wJ9s5gsp7" crossorigin="anonymous"></script>

<script>
	import { initCocktailRecipeApp } from '../../scripts/cocktail-recipe-app';

	document.addEventListener('DOMContentLoaded', () => initCocktailRecipeApp());
</script>

<style>
	.tool-hero {
		text-align: center;
		padding: 2rem 0;
	}

	.hero-header {
		display: flex;
		justify-content: space-between;
		align-items: flex-start;
		gap: 1rem;
		flex-wrap: wrap;
	}

	.tool-hero h1 {
		font-size: 3rem;
		margin: 0 0 0.5rem 0;
	}

	.tool-subtitle {
		font-size: 1.3rem;
		color: var(--muted);
		margin: 0;
	}

	.header-actions {
		display: flex;
		gap: 0.5rem;
		align-items: flex-start;
	}

	#share-recipe-btn {
		font-size: 1.3rem;
		padding: 0.75rem 1.5rem;
		margin-top: 1rem;
	}

	.mode-notice {
		padding: 0.75rem 1rem;
		border-radius: 8px;
		border: 2px solid var(--border);
		margin-bottom: 1rem;
		font-family: var(--font-display);
		font-size: 1.1rem;
		text-align: center;
		display: none;
	}

	.mode-notice--view {
		background: rgba(59, 130, 246, 0.1);
		border-color: #3b82f6;
		color: #60a5fa;
	}

	.mode-notice--manage {
		background: rgba(16, 185, 129, 0.1);
		border-color: #10b981;
		color: #34d399;
	}

	.cocktail-name-row {
		display: flex;
		gap: 1rem;
		align-items: center;
		margin-bottom: 1.5rem;
	}

	.cocktail-name-input {
		flex: 1;
		font-family: var(--font-body);
		font-size: 1rem;
		padding: 0.75rem;
		border: 2px solid var(--border);
		background: var(--panel);
		color: var(--text);
		border-radius: 4px;
		min-width: 200px;
	}

	.cocktail-name-input:focus {
		outline: none;
		border-color: var(--accent);
		box-shadow: 0 0 0 2px var(--accent);
	}

	.status-pill {
		display: inline-block;
		padding: 0.5rem 1rem;
		font-size: 1rem;
		border: 2px solid var(--accent);
		background: rgba(255, 0, 255, 0.1);
		color: var(--accent);
		border-radius: 999px;
		white-space: nowrap;
	}

	.status-pill--ok {
		border-color: var(--accent);
		background: rgba(255, 0, 255, 0.1);
		color: var(--accent);
	}

	.status-pill--danger {
		border-color: #fb7185;
		background: rgba(251, 113, 133, 0.12);
		color: #ffd5dc;
	}

	.batch-grid {
		display: grid;
		grid-template-columns: 1fr 1.5fr;
		gap: 1.5rem;
		align-items: start;
	}

	@media (max-width: 1200px) {
		.batch-grid {
			grid-template-columns: 1fr;
		}
	}

	/* Form elements */
	.form-row {
		display: flex;
		gap: 0.5rem;
		align-items: center;
		flex-wrap: wrap;
	}

	.form-group {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		margin-bottom: 1rem;
	}

	label {
		font-weight: 600;
		font-size: 1rem;
		color: var(--text);
	}

	input:not(.icon-button),
	select,
	textarea {
		font-family: var(--font-body);
		font-size: 1rem;
		padding: 0.75rem;
		border: 3px solid var(--border);
		background: var(--bg2);
		color: var(--text);
		border-radius: 4px;
		outline: none;
	}

	input:focus,
	select:focus,
	textarea:focus {
		border-color: var(--focus);
		box-shadow: 0 0 0 3px var(--focus);
	}

	textarea {
		min-height: 3rem;
		resize: vertical;
	}

	.input-row {
		display: flex;
		gap: 0.5rem;
	}

	.preset-select {
		flex: 1;
	}

	.emoji-input {
		width: 80px;
	}

	.name-input {
		flex: 1;
	}

	.abv-input {
		width: 180px;
	}

	.muted {
		color: var(--muted);
		font-size: 0.9rem;
		line-height: 1.4;
	}

	/* Custom ingredient details */
	.custom-ingredient-details {
		margin-top: 1rem;
		border: 2px solid var(--border);
		border-radius: 8px;
		padding: 1rem;
		background: rgba(255, 255, 255, 0.02);
	}

	.custom-ingredient-details summary {
		cursor: pointer;
		font-weight: 600;
		color: var(--text);
		margin-bottom: 0.5rem;
	}

	.custom-ingredient-details summary:hover {
		color: var(--accent);
	}

	/* KPI boxes */
	.kpi-container {
		display: flex;
		gap: 1rem;
		flex-wrap: wrap;
		margin-top: 1rem;
		padding-top: 1rem;
		border-top: 2px solid var(--border);
	}

	.kpi-box {
		flex: 1;
		min-width: 160px;
		background: rgba(255, 255, 255, 0.03);
		border: 2px solid var(--border);
		border-radius: 8px;
		padding: 1rem;
	}

	.kpi-label {
		font-size: 0.9rem;
		color: var(--muted);
		margin-bottom: 0.25rem;
	}

	.kpi-value {
		font-size: 1.3rem;
		font-weight: 700;
		color: var(--accent);
	}

	/* Recipe builder */
	.recipe-header {
		margin-bottom: 1rem;
	}

	.recipe-controls {
		display: flex;
		gap: 0.5rem;
	}

	.recipe-table-wrapper {
		overflow-x: auto;
	}

	.recipe-table {
		width: 100%;
		border-collapse: collapse;
	}

	.recipe-table th,
	.recipe-table td {
		padding: 0.75rem 0.5rem;
		border-bottom: 2px solid var(--border);
		text-align: left;
		vertical-align: middle;
	}

	.recipe-table th {
		font-size: 0.9rem;
		color: var(--muted);
		font-weight: 600;
	}

	.recipe-table td.right,
	.recipe-table th.right {
		text-align: right;
	}

	.recipe-table td.center,
	.recipe-table th.center {
		text-align: center;
	}

	/* Ensure table inputs and selects get retro styling */
	.recipe-table input,
	.recipe-table select {
		font-family: var(--font-body);
		font-size: 1rem;
		padding: 0.5rem;
		border: 3px solid var(--border);
		background: var(--bg2);
		color: var(--text);
		border-radius: 4px;
		outline: none;
		width: 100%;
		box-sizing: border-box;
	}

	.recipe-table input:focus,
	.recipe-table select:focus {
		border-color: var(--focus);
		box-shadow: 0 0 0 3px var(--focus);
	}

	.icon-button {
		padding: 0.3em 0.6em;
		font-size: 1rem;
		border: 2px solid var(--border);
		background: var(--bg2);
		color: var(--text);
		border-radius: 4px;
		cursor: pointer;
		margin: 0 2px;
		box-shadow: 2px 2px 0 var(--shadow);
		transition: all 0.1s ease;
		font-family: var(--font-display);
	}

	.icon-button:hover:not(:disabled) {
		transform: translate(1px, 1px);
		box-shadow: 1px 1px 0 var(--shadow);
		filter: brightness(1.1);
	}

	.icon-button:active:not(:disabled) {
		transform: translate(2px, 2px);
		box-shadow: 0 0 0 var(--shadow);
	}

	.icon-button:disabled {
		opacity: 0.5;
		cursor: not-allowed;
		box-shadow: none;
		transform: none;
	}

	.icon-button--danger {
		background: #ff4444;
		color: #ffffff;
		border-color: #ff0000;
	}

	/* Batch settings */
	.batch-settings-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 2rem;
		align-items: start;
	}

	.settings-column {
		display: flex;
		flex-direction: column;
		gap: 0;
	}

	.export-column {
		display: flex;
		flex-direction: column;
	}

	@media (max-width: 1000px) {
		.batch-settings-grid {
			display: grid;
			grid-template-columns: 1fr !important;
			gap: 1.5rem;
		}

		.settings-column,
		.export-column {
			grid-column: 1 / -1;
			width: 100%;
		}
	}

	.batch-toggle-section {
		margin: 1.5rem 0;
		padding: 1rem;
		background: var(--bg2);
		border: 2px solid var(--border);
		border-radius: 4px;
	}

	.toggle-label {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		cursor: pointer;
		font-size: 1.1rem;
	}

	.toggle-label input[type="checkbox"] {
		width: 1.5rem;
		height: 1.5rem;
		cursor: pointer;
	}

	.toggle-label input[type="checkbox"]:focus-visible {
		outline: 2px solid var(--focus);
		outline-offset: 2px;
	}

	.toggle-label input[type="checkbox"]:disabled {
		cursor: not-allowed;
		opacity: 0.6;
	}

	.batch-mode-section {
		margin-bottom: 1rem;
	}

	.radio-group {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	.radio-label {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		cursor: pointer;
		font-size: 1rem;
	}

	.radio-label input[type="radio"] {
		min-width: auto;
		width: auto;
		cursor: pointer;
	}

	.button-row {
		display: flex;
		gap: 0.5rem;
		margin-top: 1rem;
	}

	/* Export section */
	.export-section {
		margin-top: 0;
	}

	.export-header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-bottom: 1rem;
		gap: 1rem;
		flex-wrap: wrap;
	}

	/* Recipe card (export target) */
	.recipe-card {
