---
import PythonToolLayout from '../../layouts/PythonToolLayout.astro';
import Window from '../../components/Window.astro';
---

<PythonToolLayout title="Traditional vs Roth Analyzer - ARGUELLES.ME" plotly>
	<div class="tool-header">
		<h1>Traditional vs Roth Analyzer</h1>
		<p class="tool-subtitle">Compare Traditional and Roth IRA outcomes across different future tax rates</p>
	</div>

	<div class="tool-content">
		<form id="simulationForm">

		<script>
			document.getElementById("simulationForm")?.addEventListener("submit", (e) => e.preventDefault());
		</script>
			<Window title="Account Parameters" badgeText="INPUTS">
				<div class="form-group">
					<label for="currentAge">Current Age <small>(years)</small></label>
					<input type="number" id="currentAge" min="25" max="65" value="30" required />
					<small>Your current age</small>
				</div>

				<div class="form-group">
					<label for="retirementAge">Retirement Age <small>(years)</small></label>
					<input type="number" id="retirementAge" min="40" max="70" value="58" required />
					<small>When you'll retire</small>
				</div>

				<div class="form-group">
					<label for="annualContribution">Annual Contribution <small>($)</small></label>
					<input type="number" id="annualContribution" min="0" max="30000" step="1000" value="7000" required />
					<small>Annual contribution amount</small>
				</div>

				<div class="form-group">
					<label for="currentRate">Current Marginal Tax Rate <small>(decimal)</small></label>
					<input type="number" id="currentRate" min="0.10" max="0.50" step="0.01" value="0.24" required />
					<small>Your current tax rate (10% - 50%)</small>
				</div>

				<div class="form-group">
					<label for="retirementRate">Expected Retirement Tax Rate <small>(decimal)</small></label>
					<input type="number" id="retirementRate" min="0.10" max="0.50" step="0.01" value="0.22" required />
					<small>Expected tax rate in retirement</small>
				</div>

				<div class="form-group">
					<label for="expectedReturn">Expected Return <small>(decimal)</small></label>
					<input type="number" id="expectedReturn" min="0.02" max="0.12" step="0.005" value="0.07" required />
					<small>Expected annual return (2% - 12%)</small>
				</div>

				<div class="button-group">
					<button type="button" class="retro-button retro-button--primary" py-click="run_analysis">
						Compare Accounts
					</button>
				</div>
			</Window>
		</form>

		<div id="chart-container" class="chart-container">
			<h3>Static Image (Click to Zoom)</h3>
			<div id="chart" class="click-zoom"></div>
		</div>

		<div id="plotly-container" class="chart-container">
			<h3>Interactive Chart (Hover for Exact Values)</h3>
			<div id="plotlyChart"></div>
		</div>

		<div id="summary"></div>
	</div>
</PythonToolLayout>

<script>
	import { watchForChart } from '../../scripts/zoomable-chart';
	watchForChart('chart', [{ img: 'chartImg', checkbox: 'zoom-checkbox-chart' }]);
</script>

<style>
	.tool-header { text-align: center; margin-bottom: 2rem; }
	.tool-header h1 { font-size: 2.5rem; margin: 0 0 0.5rem 0; }
	.tool-subtitle { font-size: 1.2rem; color: var(--muted); margin: 0; }
	.tool-content { display: flex; flex-direction: column; gap: 2rem; }
	.form-group { margin-bottom: 1.5rem; }
	.form-group label { display: block; font-weight: bold; margin-bottom: 0.5rem; color: var(--text); }
	.form-group label small { font-weight: normal; color: var(--muted); font-size: 0.9rem; }
	.form-group input { width: 100%; padding: 0.75rem; font-family: var(--font-body); font-size: 1rem; border: 2px solid var(--border); background: var(--bg); color: var(--text); box-sizing: border-box; }
	.form-group input:focus { outline: none; border-color: var(--accent); }
	.form-group small { display: block; margin-top: 0.5rem; color: var(--muted); font-size: 0.95rem; }
	.button-group { display: flex; gap: 1rem; margin-top: 1rem; }
	.retro-button { flex: 1; padding: 1rem 2rem; font-family: var(--font-display); font-size: 1.2rem; border: 3px solid var(--border); cursor: pointer; transition: all 0.2s ease; text-transform: uppercase; font-weight: bold; }
	.chart-container { width: 100%; overflow-x: hidden; border: 3px solid var(--border); background: var(--panel); padding: 1rem; box-shadow: 4px 4px 0 var(--shadow); margin-bottom: 1.5rem; }
	.chart-container h3 { margin: 0 0 1rem 0; font-size: 1.2rem; }
	:global(#chart img) { max-width: 100% !important; height: auto !important; display: block !important; }
	:global(#plotlyChart) { min-height: 500px; height: 60vh; }

	@media (max-width: 768px) {
		.tool-header h1 { font-size: 2rem; }
		.tool-subtitle { font-size: 1rem; }
		.button-group { flex-direction: column; }
	}
</style>

<Fragment set:html={`<script type="py" src="/tools/trad-vs-roth/main.py" config="/tools/trad-vs-roth/config.json"></script>`} />
