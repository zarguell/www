---
import PythonToolLayout from '../../layouts/PythonToolLayout.astro';
import Window from '../../components/Window.astro';
---

<PythonToolLayout title="Safe Withdrawal Rate Comparison - ARGUELLES.ME">
	<div class="tool-header">
		<h1>Safe Withdrawal Rate Comparison Tool</h1>
		<p class="tool-subtitle">Compare Constant Dollar, Percentage of Portfolio, and Guardrails withdrawal strategies</p>
	</div>

	<div class="tool-content">
		<form id="simulationForm">

		<script>
			document.getElementById("simulationForm")?.addEventListener("submit", (e) => e.preventDefault());
		</script>
			<Window title="Portfolio Parameters" badgeText="STEP 1">
				<div class="form-group">
					<label for="portfolioValue">
						Portfolio Value
						<small>(dollars)</small>
					</label>
					<input type="number" id="portfolioValue" min="100000" max="5000000" step="50000" value="1000000" required />
					<small>Your retirement portfolio value ($100k - $5M)</small>
				</div>

				<div class="form-group">
					<label for="withdrawalRate">
						Initial Withdrawal Rate
						<small>(decimal)</small>
					</label>
					<input type="number" id="withdrawalRate" min="0.02" max="0.06" step="0.005" value="0.04" required />
					<small>Annual withdrawal rate (2% - 6%, 4% is traditional)</small>
				</div>

				<div class="form-group">
					<label for="timeHorizon">
						Time Horizon
						<small>(years)</small>
					</label>
					<input type="number" id="timeHorizon" min="10" max="50" value="30" required />
					<small>Years to test (10 - 50 years)</small>
				</div>
			</Window>

			<Window title="Asset Allocation & Returns" badgeText="STEP 2">
				<div class="form-group">
					<label for="stockAllocation">Stock Allocation <small>(0-1)</small></label>
					<input type="number" id="stockAllocation" min="0" max="1" step="0.05" value="0.6" required />
					<small>Percentage in stocks (e.g., 0.6 = 60%)</small>
				</div>

				<div class="form-group">
					<label for="bondAllocation">Bond Allocation <small>(0-1)</small></label>
					<input type="number" id="bondAllocation" min="0" max="1" step="0.05" value="0.4" required />
					<small>Percentage in bonds (must equal 1 - stock allocation)</small>
				</div>

				<div class="form-group">
					<label for="stockReturn">Expected Stock Return <small>(decimal)</small></label>
					<input type="number" id="stockReturn" min="0.02" max="0.12" step="0.005" value="0.07" required />
					<small>Expected annual stock return (2% - 12%)</small>
				</div>

				<div class="form-group">
					<label for="bondReturn">Expected Bond Return <small>(decimal)</small></label>
					<input type="number" id="bondReturn" min="0.01" max="0.08" step="0.005" value="0.03" required />
					<small>Expected annual bond return (1% - 8%)</small>
				</div>

				<div class="form-group">
					<label for="stockVolatility">Stock Volatility <small>(decimal)</small></label>
					<input type="number" id="stockVolatility" min="0.10" max="0.30" step="0.01" value="0.16" required />
					<small>Annual stock volatility (10% - 30%)</small>
				</div>

				<div class="form-group">
					<label for="bondVolatility">Bond Volatility <small>(decimal)</small></label>
					<input type="number" id="bondVolatility" min="0.03" max="0.15" step="0.01" value="0.05" required />
					<small>Annual bond volatility (3% - 15%)</small>
				</div>

				<div class="form-group">
					<label for="numSimulations">Number of Simulations <small>(count)</small></label>
					<input type="number" id="numSimulations" min="100" max="5000" step="100" value="1000" required />
					<small>How many scenarios to run (100 - 5,000)</small>
				</div>
			</Window>

			<div class="button-group">
				<button type="button" class="retro-button retro-button--primary" py-click="run_simulation">
					Compare Strategies
				</button>
			</div>
		</form>

		<div id="chart-container" class="chart-container">
			<div id="chart" class="click-zoom"></div>
		</div>

		<div id="summary"></div>
	</div>
</PythonToolLayout>

<script>
	import { watchForChart } from '../../scripts/zoomable-chart';
	watchForChart('chart', [{ img: 'chartImg', checkbox: 'zoom-checkbox-chart' }]);
</script>

<style>
	.tool-header { text-align: center; margin-bottom: 2rem; }
	.tool-header h1 { font-size: 2.5rem; margin: 0 0 0.5rem 0; color: var(--accent); }
	.tool-subtitle { font-size: 1.2rem; color: var(--muted); margin: 0; }
	.tool-content { display: flex; flex-direction: column; gap: 2rem; }
	.form-group { margin-bottom: 1.5rem; }
	.form-group label { display: block; font-weight: bold; margin-bottom: 0.5rem; color: var(--text); }
	.form-group label small { font-weight: normal; color: var(--muted); font-size: 0.9rem; }
	.form-group input { width: 100%; padding: 0.75rem; font-family: 'VT323', monospace; font-size: 1.1rem; border: 2px solid var(--border); background: var(--bg); color: var(--text); box-sizing: border-box; }
	.form-group input:focus { outline: none; border-color: var(--accent); }
	.form-group small { display: block; margin-top: 0.5rem; color: var(--muted); font-size: 0.95rem; }
	.button-group { display: flex; gap: 1rem; margin-top: 1rem; }
	.retro-button { flex: 1; padding: 1rem 2rem; font-family: 'VT323', monospace; font-size: 1.2rem; border: 3px solid var(--border); cursor: pointer; transition: all 0.2s ease; text-transform: uppercase; font-weight: bold; }
	.chart-container { width: 100%; overflow-x: hidden; border: 3px solid var(--border); background: var(--panel); padding: 1rem; box-shadow: 4px 4px 0 var(--shadow); }
	:global(#chart img) { max-width: 100% !important; height: auto !important; display: block !important; }

	@media (max-width: 768px) {
		.tool-header h1 { font-size: 2rem; }
		.tool-subtitle { font-size: 1rem; }
		.button-group { flex-direction: column; }
	}
</style>

<Fragment set:html={`<script type="py" src="/tools/safe-withdrawal/main.py" config="/tools/safe-withdrawal/config.json"></script>`} />
