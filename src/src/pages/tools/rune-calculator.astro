---
import ToolLayout from '../../layouts/ToolLayout.astro';
import Window from '../../components/Window.astro';
import RetroButton from '../../components/RetroButton.astro';
---

<ToolLayout title="Golden Rune Calculator - ARGUELLES.ME">
	<div class="calculator-hero">
		<h1>Golden Rune Calculator</h1>
		<p class="calculator-subtitle">Calculate Golden Runes needed in Elden Ring</p>
	</div>

	<Window title="Calculator" badgeText="ACTIVE">
		<form id="rune-form" class="calculator-form">
			<div class="form-row">
				<div class="form-group">
					<label for="runes-needed">Runes needed:</label>
					<input type="number" id="runes-needed" min="0" required>
				</div>
				<div class="form-group">
					<label for="runes-have">Current Runes:</label>
					<input type="number" id="runes-have" min="0" required>
				</div>
			</div>

			<div class="form-row">
				<div class="form-group">
					<label for="rune-1"># Golden Rune 1:</label>
					<input type="number" id="rune-1" min="0">
				</div>
				<div class="form-group">
					<label for="rune-2"># Golden Rune 2:</label>
					<input type="number" id="rune-2" min="0">
				</div>
				<div class="form-group">
					<label for="rune-3"># Golden Rune 3:</label>
					<input type="number" id="rune-3" min="0">
				</div>
				<div class="form-group">
					<label for="rune-4"># Golden Rune 4:</label>
					<input type="number" id="rune-4" min="0">
				</div>
			</div>

			<div class="form-row">
				<div class="form-group">
					<label for="rune-5"># Golden Rune 5:</label>
					<input type="number" id="rune-5" min="0">
				</div>
				<div class="form-group">
					<label for="rune-6"># Golden Rune 6:</label>
					<input type="number" id="rune-6" min="0">
				</div>
				<div class="form-group">
					<label for="rune-7"># Golden Rune 7:</label>
					<input type="number" id="rune-7" min="0">
				</div>
				<div class="form-group">
					<label for="rune-8"># Golden Rune 8:</label>
					<input type="number" id="rune-8" min="0">
				</div>
			</div>

			<div class="form-row">
				<div class="form-group">
					<label for="rune-9"># Golden Rune 9:</label>
					<input type="number" id="rune-9" min="0">
				</div>
				<div class="form-group">
					<label for="rune-10"># Golden Rune 10:</label>
					<input type="number" id="rune-10" min="0">
				</div>
				<div class="form-group">
					<label for="rune-11"># Golden Rune 11:</label>
					<input type="number" id="rune-11" min="0">
				</div>
				<div class="form-group">
					<label for="rune-12"># Golden Rune 12:</label>
					<input type="number" id="rune-12" min="0">
				</div>
			</div>

			<div class="form-row">
				<div class="form-group">
					<label for="rune-13"># Golden Rune 13:</label>
					<input type="number" id="rune-13" min="0">
				</div>
				<div class="form-group button-group">
					<RetroButton type="submit" variant="primary">
						Calculate
					</RetroButton>
				</div>
			</div>
		</form>
	</Window>

	<div id="result" class="results-section"></div>
</ToolLayout>

<style>
	.calculator-hero {
		text-align: center;
		padding: 2rem 0;
	}

	.calculator-hero h1 {
		font-size: 3rem;
		margin: 0 0 0.5rem 0;
	}

	.calculator-subtitle {
		font-size: 1.3rem;
		color: var(--muted);
		margin: 0;
	}

	.calculator-form {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}

	.form-row {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 1rem;
	}

	.form-group {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	.form-group.button-group {
		justify-content: flex-end;
	}

	.form-group label {
		font-size: 1rem;
		font-weight: bold;
		color: var(--text);
	}

	.form-group input {
		font-family: 'VT323', monospace;
		font-size: 1.2rem;
		padding: 0.75rem;
		border: 3px solid var(--border);
		background: var(--bg2);
		color: var(--text);
		outline: none;
		transition: all 0.2s ease;
	}

	.form-group input:focus {
		border-color: var(--focus);
		box-shadow: 0 0 0 3px var(--focus);
	}

	.results-section {
		margin-top: 2rem;
	}

	.results-section table {
		width: 100%;
		margin: 0 auto;
		border-collapse: collapse;
		background: var(--bg2);
		border: 3px solid var(--border);
	}

	.results-section thead {
		background: var(--accent);
	}

	.results-section th {
		padding: 1rem;
		text-align: center;
		font-size: 1.1rem;
		color: var(--bg);
		font-weight: bold;
	}

	.results-section td {
		padding: 0.75rem;
		text-align: center;
		border: 1px solid var(--border);
		font-size: 1.1rem;
		color: var(--text);
	}

	.results-section tbody tr:nth-child(even) {
		background: var(--bg2);
	}
	.results-section .error-message {
		padding: 1rem;
		text-align: center;
		background: var(--bg2);
		border: 3px solid var(--border);
		color: var(--text);
		font-family: 'VT323', monospace;
		font-size: 1.2rem;
	}

	@media (max-width: 768px) {
		.calculator-hero h1 {
			font-size: 2.5rem;
		}

		.form-row {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 480px) {
		.form-row {
			grid-template-columns: 1fr;
		}
	}
</style>

<script>
	import { RUNE_VALUES, calculateRunes } from '../../lib/rune-calculator';

	// Add event listener when DOM is ready
	document.addEventListener('DOMContentLoaded', () => {
		const form = document.getElementById('rune-form');
		const resultDiv = document.getElementById('result');

		if (form && resultDiv) {
			form.addEventListener('submit', (e) => {
				e.preventDefault();

				const runesNeededInput = document.getElementById('runes-needed') as HTMLInputElement;
				const runesHaveInput = document.getElementById('runes-have') as HTMLInputElement;

				const runesNeeded = parseInt(runesNeededInput.value) || 0;
				const runesHave = parseInt(runesHaveInput.value) || 0;

				// Initialize the array to store the # of each type of golden runes
				const availableRunes: number[] = [];

				// Get the # of each type of golden runes
				for (let i = 0; i < RUNE_VALUES.length; i++) {
					const inputField = document.getElementById(`rune-${i + 1}`) as HTMLInputElement;
					availableRunes.push(parseInt(inputField?.value) || 0);
				}

				const numGoldenRunes = calculateRunes(runesNeeded, runesHave, availableRunes);

				resultDiv.innerHTML = '';

				if (numGoldenRunes.length === 0) {
					const message = document.createElement('p');
					message.className = 'error-message';
					message.textContent = 'Not enough Golden Runes available to reach your target.';
					resultDiv.appendChild(message);
				} else {
					const table = document.createElement('table');
					table.innerHTML = `
						<thead>
							<tr>
								<th>Golden Rune</th>
								<th>Quantity Needed</th>
							</tr>
						</thead>
						<tbody>
							${numGoldenRunes.map((quantity, index) => `
								<tr>
									<td style="text-align: center;">${index + 1}</td>
									<td style="text-align: center">${quantity}</td>
								</tr>
							`).join('')}
						</tbody>
					`;
					resultDiv.appendChild(table);
				}

				// Scroll to results
				resultDiv.scrollIntoView({ behavior: 'smooth' });
			});
		}
	});
</script>
