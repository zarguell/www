---
import PythonToolLayout from '../../layouts/PythonToolLayout.astro';
import Window from '../../components/Window.astro';
---

<PythonToolLayout title="Cash Flow Sankey Builder - Retro.SITE">
	<div class="tool-header">
		<h1>Cash Flow Sankey Builder</h1>
		<p class="tool-subtitle">Create beautiful Sankey diagrams from simple text input</p>
	</div>

	<div class="tool-content">
		<form id="simulationForm">

		<script>
			document.getElementById("simulationForm").addEventListener("submit", (e) => e.preventDefault());
		</script>
			<Window title="Flow Data Input" badgeText="INPUTS">
				<div class="form-group">
					<label for="diagramTitle">Diagram Title</label>
					<input type="text" id="diagramTitle" value="Cash Flow Diagram" />
					<small>Title for your diagram</small>
				</div>

				<div class="form-group">
					<label for="sankeyText">Flow Data</label>
					<textarea id="sankeyText" rows="15" required placeholder="Gross Income [150000] Federal Taxes
Gross Income [7500] State Taxes
Gross Income [11475] FICA Taxes
Gross Income [23000] 401k Contributions
Gross Income [7000] Roth IRA
Take Home Pay [39600] Housing
Take Home Pay [26425] Other Expenses"></textarea>
					<small>Format: Source [value] Target (one flow per line)</small>
				</div>

				<div class="button-group">
					<button type="button" class="retro-button retro-button-primary" py-click="build_sankey">
						Build Diagram
					</button>
				</div>
			</Window>
		</form>

		<div id="chart-container" class="chart-container">
			<div id="chart"></div>
		</div>

		<div id="summary"></div>
	</div>
</PythonToolLayout>

<script define:vars={{}}>
	// No script needed - Plotly's native fullscreen button works best
</script>

<style>
	.tool-header { text-align: center; margin-bottom: 2rem; }
	.tool-header h1 { font-size: 2.5rem; margin: 0 0 0.5rem 0; color: var(--accent); }
	.tool-subtitle { font-size: 1.2rem; color: var(--muted); margin: 0; }
	.tool-content { display: flex; flex-direction: column; gap: 2rem; }
	.form-group { margin-bottom: 1.5rem; }
	.form-group label { display: block; font-weight: bold; margin-bottom: 0.5rem; color: var(--text); }
	.form-group label small { font-weight: normal; color: var(--muted); font-size: 0.9rem; }
	.form-group input { width: 100%; padding: 0.75rem; font-family: 'VT323', monospace; font-size: 1.1rem; border: 2px solid var(--border); background: var(--bg); color: var(--text); box-sizing: border-box; }
	.form-group input:focus { outline: none; border-color: var(--accent); }
	.form-group textarea { width: 100%; padding: 0.75rem; font-family: 'VT323', monospace; font-size: 1rem; border: 2px solid var(--border); background: var(--bg); color: var(--text); box-sizing: border-box; resize: vertical; }
	.form-group textarea:focus { outline: none; border-color: var(--accent); }
	.form-group small { display: block; margin-top: 0.5rem; color: var(--muted); font-size: 0.95rem; }
	.button-group { display: flex; gap: 1rem; margin-top: 1rem; }
	.retro-button { flex: 1; padding: 1rem 2rem; font-family: 'VT323', monospace; font-size: 1.2rem; border: 3px solid var(--border); cursor: pointer; transition: all 0.2s ease; text-transform: uppercase; font-weight: bold; }
	.retro-button-primary { background: var(--accent); color: var(--bg); box-shadow: 4px 4px 0 var(--shadow); }
	.retro-button-primary:hover { transform: translate(2px, 2px); box-shadow: 2px 2px 0 var(--shadow); }
	.chart-container { width: 100%; overflow-x: hidden; border: 3px solid var(--border); background: var(--panel-bg); padding: 1rem; box-shadow: 4px 4px 0 var(--shadow); }
	:global(#chart) { min-height: 500px; height: 60vh; }
	:global(#chart img) { max-width: 100% !important; height: auto !important; display: block !important; }
	:global(#summary) { margin-top: 2rem; }

	@media (max-width: 768px) {
		.tool-header h1 { font-size: 2rem; }
		.tool-subtitle { font-size: 1rem; }
		.button-group { flex-direction: column; }

		/* Taller chart on mobile for better visibility */
		:global(#chart) { min-height: 400px; height: 75vh; }

		/* Plotly mobile optimizations */
		:global(.plotly) { touch-action: manipulation; }
		:global(.plotly .modebar) { touch-action: none; }
		:global(.plotly .modebar-group) { margin: 0 2px !important; }
		:global(.plotly .modebar-btn) { padding: 4px 6px !important; margin: 0 1px !important; }
	}
</style>

<script type="py" src="/tools/sankey-builder/main.py" config="/tools/sankey-builder/config.json"></script>
