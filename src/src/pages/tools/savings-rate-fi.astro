---
import PythonToolLayout from '../../layouts/PythonToolLayout.astro';
import Window from '../../components/Window.astro';
---

<PythonToolLayout title="Savings Rate to FI Calculator - ARGUELLES.ME">
	<div class="tool-header">
		<h1>Savings Rate to FI Calculator</h1>
		<p class="tool-subtitle">See the powerful relationship between savings rate and time to financial independence</p>
	</div>

	<div class="tool-content">
		<form id="simulationForm">

		<script>
			document.getElementById("simulationForm")?.addEventListener("submit", (e) => e.preventDefault());
		</script>
			<Window title="Financial Parameters" badgeText="INPUTS">
				<div class="form-group">
					<label for="annualIncome">Annual Income <small>($)</small></label>
					<input type="number" id="annualIncome" min="30000" max="500000" step="5000" value="150000" required />
					<small>Your annual gross income</small>
				</div>

				<div class="form-group">
					<label for="currentSavings">Current Savings <small>($)</small></label>
					<input type="number" id="currentSavings" min="0" max="2000000" step="10000" value="100000" required />
					<small>Current invested assets</small>
				</div>

				<div class="form-group">
					<label for="savingsRate">Savings Rate <small>(decimal)</small></label>
					<input type="number" id="savingsRate" min="0.05" max="0.80" step="0.05" value="0.40" required />
					<small>Percentage of income saved (5% - 80%)</small>
				</div>

				<div class="form-group">
					<label for="withdrawalRate">Withdrawal Rate <small>(decimal)</small></label>
					<input type="number" id="withdrawalRate" min="0.02" max="0.05" step="0.005" value="0.035" required />
					<small>Safe withdrawal rate (2% - 5%)</small>
				</div>

				<div class="form-group">
					<label for="realReturn">Real Return <small>(decimal)</small></label>
					<input type="number" id="realReturn" min="0.02" max="0.10" step="0.005" value="0.05" required />
					<small>Expected inflation-adjusted return (2% - 10%)</small>
				</div>

				<div class="button-group">
					<button type="button" class="retro-button retro-button--primary" py-click="calculate_fi">
						Calculate Years to FI
					</button>
				</div>
			</Window>
		</form>

		<div id="chart-container" class="chart-container">
			<div id="chart" class="click-zoom"></div>
		</div>

		<div id="summary"></div>
	</div>
</PythonToolLayout>

<script>
	import { watchForChart } from '../../scripts/zoomable-chart';
	watchForChart('chart', [{ img: 'chartImg', checkbox: 'zoom-checkbox-chart' }]);
</script>

<style>
	.tool-header { text-align: center; margin-bottom: 2rem; }
	.tool-header h1 { font-size: 2.5rem; margin: 0 0 0.5rem 0; }
	.tool-subtitle { font-size: 1.2rem; color: var(--muted); margin: 0; }
	.tool-content { display: flex; flex-direction: column; gap: 2rem; }
	.form-group { margin-bottom: 1.5rem; }
	.form-group label { display: block; font-weight: bold; margin-bottom: 0.5rem; color: var(--text); }
	.form-group label small { font-weight: normal; color: var(--muted); font-size: 0.9rem; }
	.form-group input { width: 100%; padding: 0.75rem; font-family: var(--font-body); font-size: 1rem; border: 2px solid var(--border); background: var(--bg); color: var(--text); box-sizing: border-box; }
	.form-group input:focus { outline: none; border-color: var(--accent); }
	.form-group small { display: block; margin-top: 0.5rem; color: var(--muted); font-size: 0.95rem; }
	.button-group { display: flex; gap: 1rem; margin-top: 1rem; }
	.retro-button { flex: 1; padding: 1rem 2rem; font-family: var(--font-display); font-size: 1.2rem; border: 3px solid var(--border); cursor: pointer; transition: all 0.2s ease; text-transform: uppercase; font-weight: bold; }
	.chart-container { width: 100%; overflow-x: hidden; border: 3px solid var(--border); background: var(--panel); padding: 1rem; box-shadow: 4px 4px 0 var(--shadow); }
	:global(#chart img) { max-width: 100% !important; height: auto !important; display: block !important; }

	@media (max-width: 768px) {
		.tool-header h1 { font-size: 2rem; }
		.tool-subtitle { font-size: 1rem; }
		.button-group { flex-direction: column; }
	}
</style>

<Fragment set:html={`<script type="py" src="/tools/savings-rate-fi/main.py" config="/tools/savings-rate-fi/config.json"></script>`} />
