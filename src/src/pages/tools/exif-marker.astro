---
import ToolLayout from '../../layouts/ToolLayout.astro';
import Window from '../../components/Window.astro';
import RetroButton from '../../components/RetroButton.astro';
---

<ToolLayout title="EXIF Explorer & Marker Tool - ARGUELLES.ME">
	<div class="tools-hero">
		<h1>EXIF Explorer & Marker Tool</h1>
		<p class="tools-subtitle">View raw EXIF data and add metadata overlays to your photos</p>
	</div>

	<Window title="Image Upload & Configuration" badgeText="IMAGE TOOL">
		<div class="controls">
			<div class="form-group">
				<label for="imageInput">Select Image:</label>
				<div class="file-input-wrapper">
					<input type="file" id="imageInput" accept="image/*,image/heic">
					<label for="imageInput" class="file-input-label">Choose File</label>
					<span id="fileName" class="file-name">No file selected</span>
				</div>
				<div id="errorMsg" class="error-message"></div>
			</div>

			<div class="form-group">
				<label for="cornerSelect">Corner Position:</label>
				<select id="cornerSelect">
					<option value="bottom-left">Bottom Left</option>
					<option value="bottom-right">Bottom Right</option>
					<option value="top-left">Top Left</option>
					<option value="top-right">Top Right</option>
				</select>
			</div>

			<div class="form-group">
				<label for="sizeSelect">Text Size:</label>
				<select id="sizeSelect">
					<option value="small">Small</option>
					<option value="medium" selected>Medium</option>
					<option value="large">Large</option>
				</select>
			</div>

			<div class="checkbox-group">
				<label>
					<input type="checkbox" id="timestampCheck" checked>
					Include Timestamp
				</label>
			</div>

			<div class="checkbox-group">
				<label>
					<input type="checkbox" id="locationCheck" checked>
					Include Location
				</label>
			</div>

			<div class="checkbox-group">
				<label>
					<input type="checkbox" id="cameraCheck" checked>
					Include Camera Info
				</label>
			</div>

			<div class="button-group">
				<button id="processBtn" class="retro-button retro-button--primary">Process Image</button>
				<button id="downloadBtn" class="retro-button retro-button--secondary">Download</button>
			</div>
		</div>
	</Window>

	<Window title="Result" badgeText="PREVIEW">
		<div class="canvas-container">
			<canvas id="canvas"></canvas>
		</div>
	</Window>

	<Window title="Raw EXIF Data" badgeText="EXPLORER">
		<div id="exifData" class="exif-data">
			<p class="exif-placeholder">Upload and process an image to view raw EXIF data</p>
		</div>
	</Window>

	<!-- Load EXIFReader and heic-to from CDN -->
	<script is:inline src="https://cdn.jsdelivr.net/npm/exifreader@4.23.5/dist/exif-reader.min.js" integrity="sha384-Mh5OIRxVBO3fXntyBIquG8kl7f3CjKLOsqUf4c4eARBB3F7x2kKY4Q0J14qhivUH" crossorigin="anonymous"></script>
	<script is:inline src="https://cdn.jsdelivr.net/npm/heic-to@1.3.0/dist/iife/heic-to.js" integrity="sha384-R9DMp3OJlMnbM+JPaosqA30W1QqMM+plQMspUZ3KguUAlg9SSVHybSqJQ3zgZMhE" crossorigin="anonymous"></script>

	<script>
	import { initExifMarkerApp } from '../../scripts/exif-marker-app';

	document.addEventListener('DOMContentLoaded', () => initExifMarkerApp());
</script>
</ToolLayout>

<style>
	.tools-hero {
		text-align: center;
		padding: 2rem 0;
	}

	.tools-hero h1 {
		font-size: 2.5rem;
		margin: 0 0 0.5rem 0;
	}

	.tools-subtitle {
		font-size: 1.3rem;
		color: var(--muted);
		margin: 0;
	}

	.controls {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.form-group {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	.form-group label {
		font-weight: bold;
		color: var(--text);
	}

	.form-group input[type="file"] {
		display: none;
	}

	.file-input-wrapper {
		display: flex;
		align-items: center;
		gap: 1rem;
		flex-wrap: wrap;
	}

	.file-input-label {
		padding: 0.5rem 1rem;
		background: var(--panel);
		color: var(--text);
		border: 2px solid var(--border);
		font-family: 'VT323', monospace;
		font-size: 1.1rem;
		cursor: pointer;
		transition: all 0.1s ease;
		display: inline-block;
		box-shadow: 2px 2px 0 var(--shadow);
	}

	.file-input-label:hover {
		background: var(--accent);
		color: var(--bg);
		transform: translate(1px, 1px);
		box-shadow: 1px 1px 0 var(--shadow);
	}

	.file-name {
		font-family: 'VT323', monospace;
		font-size: 1rem;
		color: var(--muted);
		font-style: italic;
	}

	.form-group select {
		padding: 0.5rem;
		border: 2px solid var(--border);
		background: var(--bg);
		color: var(--text);
		font-family: 'VT323', monospace;
		font-size: 1.1rem;
	}

	.checkbox-group {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	.checkbox-group label {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		cursor: pointer;
	}

	.checkbox-group input[type="checkbox"] {
		width: 1.2rem;
		height: 1.2rem;
		cursor: pointer;
	}

	.error-message {
		margin-top: 0.5rem;
		padding: 0.5rem;
		background: var(--panel);
		border: 2px solid var(--border);
		color: var(--text);
		font-family: 'VT323', monospace;
		font-size: 1rem;
		min-height: 1.5rem;
	}

	.button-group {
		display: flex;
		gap: 1rem;
		margin-top: 1rem;
	}

	.canvas-container {
		width: 100%;
		overflow-x: auto;
	}

	#canvas {
		max-width: 100%;
		height: auto;
		border: 2px solid var(--border);
		background: var(--panel);
	}

	.exif-data {
		max-height: 600px;
		overflow-y: auto;
	}

	.exif-placeholder {
		text-align: center;
		color: var(--muted);
		font-style: italic;
		padding: 2rem;
	}

	.exif-category {
		margin-bottom: 1.5rem;
	}

	.exif-category-title {
		font-size: 1.5rem;
		color: var(--accent);
		border-bottom: 2px solid var(--border);
		padding-bottom: 0.5rem;
		margin-bottom: 1rem;
	}

	.exif-tags {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	.exif-tag {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1rem;
		padding: 0.5rem;
		background: var(--panel);
		border: 1px solid var(--border);
		font-family: 'VT323', monospace;
		font-size: 1rem;
	}

	.exif-tag-name {
		color: var(--muted);
		font-weight: bold;
	}

	.exif-tag-value {
		color: var(--text);
		word-break: break-all;
	}

	@media (max-width: 768px) {
		.tools-hero h1 {
			font-size: 2rem;
		}

		.button-group {
			flex-direction: column;
		}

		.exif-tag {
			grid-template-columns: 1fr;
		}
	}
</style>
