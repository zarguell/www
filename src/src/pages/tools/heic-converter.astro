---
import ToolLayout from '../../layouts/ToolLayout.astro';
import Window from '../../components/Window.astro';
---

<ToolLayout title="HEIC to JPG/PNG Converter - ARGUELLES.ME">
	<div class="tools-hero">
		<h1>HEIC to JPG/PNG Converter</h1>
		<p class="tools-subtitle">Convert HEIC images to standard formats in your browser</p>
	</div>

	<Window title="Upload & Convert" badgeText="IMAGE TOOL">
		<div class="controls">
			<div class="form-group">
				<label for="fileInput">Select HEIC Files:</label>
				<div class="file-input-wrapper">
					<input type="file" id="fileInput" accept=".heic,.heif,image/heic,image/heif" multiple>
					<label for="fileInput" class="file-input-label">Choose Files</label>
					<span id="fileCount" class="file-name">No files selected</span>
				</div>
				<div id="errorMsg" class="error-message"></div>
			</div>

			<div class="form-group">
				<label for="formatSelect">Output Format:</label>
				<select id="formatSelect">
					<option value="image/jpeg">JPG</option>
					<option value="image/png">PNG</option>
				</select>
			</div>

			<div class="form-group" id="qualityGroup">
				<label for="qualitySelect">JPG Quality:</label>
				<select id="qualitySelect">
					<option value="0.92">High (0.92)</option>
					<option value="0.85" selected>Medium (0.85)</option>
					<option value="0.75">Low (0.75)</option>
				</select>
			</div>

			<div class="form-group">
				<label for="downloadMode">Download Mode:</label>
				<select id="downloadMode">
					<option value="individual">Individual Files (download as converted)</option>
					<option value="zip">ZIP Archive (download all at once when done)</option>
				</select>
			</div>

			<button id="convertBtn" class="retro-button retro-button--primary">Convert & Download All</button>

			<div id="progress"></div>
		</div>
	</Window>

	<Window title="About This Tool" badgeText="INFO">
		<div class="info-content">
			<p><strong>Privacy First:</strong> All conversions happen in your browser. Your images are never uploaded to any server.</p>
			<p><strong>HEIC Format:</strong> HEIC (High Efficiency Image Container) is Apple's default image format. It offers better compression than JPG but isn't widely supported.</p>
			<p><strong>Download Modes:</strong></p>
			<ul>
				<li><strong>Individual Files:</strong> Each image downloads immediately after conversion</li>
				<li><strong>ZIP Archive:</strong> All converted images are bundled into a single ZIP file that downloads once everything is complete</li>
			</ul>
			<p><strong>JPG Quality:</strong> Only applies when converting to JPG format. Higher quality = larger file size. PNG is lossless and doesn't use quality settings.</p>
		</div>
	</Window>

	<!-- Load heic-to and JSZip libraries from CDN -->
	<script is:inline src="https://cdn.jsdelivr.net/npm/heic-to@1.3.0/dist/iife/heic-to.js" integrity="sha384-R9DMp3OJlMnbM+JPaosqA30W1QqMM+plQMspUZ3KguUAlg9SSVHybSqJQ3zgZMhE" crossorigin="anonymous"></script>
	<script is:inline src="https://cdn.jsdelivr.net/npm/jszip@3.10.1/dist/jszip.min.js" integrity="sha384-+mbV2IY1Zk/X1p/nWllGySJSUN8uMs+gUAN10Or95UBH0fpj6GfKgPmgC5EXieXG" crossorigin="anonymous"></script>

	<script>
		// CDN globals loaded by the is:inline script tags above
		declare const HeicTo: { isHeic(f: Blob): Promise<boolean>; (opts: { blob: Blob; type: string; quality?: number }): Promise<Blob> };
		declare const JSZip: new () => { file(name: string, data: Blob): void; generateAsync(opts: { type: string }): Promise<Blob> };
		import { escapeHtml } from '../../lib/escape-html';

		document.addEventListener('DOMContentLoaded', function() {
			const fileInput = document.getElementById('fileInput') as HTMLInputElement;
			const fileCount = document.getElementById('fileCount') as HTMLElement;
			const convertBtn = document.getElementById('convertBtn') as HTMLButtonElement;
			const progress = document.getElementById('progress') as HTMLElement;
			const errorMsg = document.getElementById('errorMsg') as HTMLElement;
			const formatSelect = document.getElementById('formatSelect') as HTMLSelectElement;
			const qualityGroup = document.getElementById('qualityGroup') as HTMLElement;

			// Hide/show quality setting based on format
			formatSelect.addEventListener('change', function() {
				if (this.value === 'image/png') {
					qualityGroup.style.display = 'none';
				} else {
					qualityGroup.style.display = 'flex';
				}
			});

			// Update file count display
			fileInput.addEventListener('change', function() {
				const files = this.files;
				if (files && files.length > 0) {
					fileCount.textContent = `${files.length} file${files.length > 1 ? 's' : ''} selected`;
				} else {
					fileCount.textContent = 'No files selected';
				}
			});

			// Convert button handler
			convertBtn.addEventListener('click', async function() {
				const files = fileInput.files;
				if (!files || files.length === 0) {
					errorMsg.textContent = 'Please select one or more HEIC files first.';
					return;
				}

				const outType = (document.getElementById('formatSelect') as HTMLSelectElement).value;
				const quality = parseFloat((document.getElementById('qualitySelect') as HTMLSelectElement).value);
				const downloadMode = (document.getElementById('downloadMode') as HTMLSelectElement).value;
				// Fail fast with a clear message if CDN libraries did not load
				if (typeof HeicTo === 'undefined') {
					errorMsg.textContent = 'Converter failed to load (heic-to library unavailable). Check your connection or script blocker and reload the page.';
					return;
				}
				if (downloadMode === 'zip' && typeof JSZip === 'undefined') {
					errorMsg.textContent = 'ZIP support failed to load (JSZip library unavailable). Check your connection or script blocker and reload the page.';
					return;
				}

				convertBtn.disabled = true;
				progress.innerHTML = '';
				errorMsg.textContent = '';

				// For ZIP mode, collect all converted files
				const zipFiles = [];

				for (const file of files) {
					const row = document.createElement('div');
					row.className = 'file-item';
					row.innerHTML = `<span class="file-name">${escapeHtml(file.name)}</span><span class="status">Queued…</span>`;
					progress.appendChild(row);
					const statusEl = row.querySelector<HTMLElement>('.status')!;

					try {
						setStatus(statusEl, 'Checking…');

						// Check if file is HEIC
						const isHeic = await HeicTo.isHeic(file);
						if (!isHeic) {
							setStatus(statusEl, 'Skipped (not HEIC)', '#b45309');
							continue;
						}

						setStatus(statusEl, 'Converting…');

						// Convert the file
						const converted = await HeicTo({
							blob: file,
							type: outType,
							quality
						});

						const ext = outType === 'image/png' ? 'png' : 'jpg';
						const outName = `${baseName(file.name)}.${ext}`;

						if (downloadMode === 'zip') {
							// Collect for ZIP download
							zipFiles.push({ blob: converted, name: outName });
							setStatus(statusEl, 'Added to ZIP', '#15803d');
						} else {
							// Individual download
							setStatus(statusEl, 'Downloading…');
							downloadBlob(converted, outName);
							setStatus(statusEl, 'Done', '#15803d');
						}

						await new Promise(r => setTimeout(r, 150));
					} catch (e) {
						console.error(e);
						setStatus(statusEl, 'Failed', '#b91c1c');
					}
				}

				// If ZIP mode, create and download the ZIP file
				if (downloadMode === 'zip' && zipFiles.length > 0) {
					errorMsg.textContent = 'Creating ZIP archive...';
					try {
						const zip = new JSZip();
						zipFiles.forEach(file => {
							zip.file(file.name, file.blob);
						});

						const zipBlob = await zip.generateAsync({ type: 'blob' });
						const zipName = `converted_images_${new Date().getTime()}.zip`;
						downloadBlob(zipBlob, zipName);
						errorMsg.textContent = `ZIP archive created with ${zipFiles.length} file${zipFiles.length > 1 ? 's' : ''}`;
					} catch (e) {
						console.error(e);
						errorMsg.textContent = 'Error creating ZIP archive';
					}
				}

				convertBtn.disabled = false;
			});

			// Helper function to set status
			function setStatus(el: HTMLElement, text: string, color = '#666') {
				el.textContent = text;
				el.style.color = color;
			}

			// Helper function to get base name
			function baseName(filename: string): string {
				return filename.replace(/\.[^/.]+$/, '');
			}

			// Helper function to download blob
			function downloadBlob(blob: Blob, filename: string): void {
				const url = URL.createObjectURL(blob);
				const a = document.createElement('a');
				a.href = url;
				a.download = filename;
				document.body.appendChild(a);
				a.click();
				a.remove();
				setTimeout(() => URL.revokeObjectURL(url), 2000);
			}
		});
	</script>
</ToolLayout>

<style>
	.tools-hero {
		text-align: center;
		padding: 2rem 0;
	}

	.tools-hero h1 {
		font-size: 2.5rem;
		margin: 0 0 0.5rem 0;
	}

	.tools-subtitle {
		font-size: 1.3rem;
		color: var(--muted);
		margin: 0;
	}

	.controls {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.row {
		display: flex;
		gap: 1rem;
	}

	.row > * {
		flex: 1;
	}

	.form-group {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	.form-group label {
		font-weight: bold;
		color: var(--text);
	}

	.form-group input[type="file"] {
		display: none;
	}

	.file-input-wrapper {
		display: flex;
		align-items: center;
		gap: 1rem;
		flex-wrap: wrap;
	}

	.file-input-label {
		padding: 0.5rem 1rem;
		background: var(--panel);
		color: var(--text);
		border: 2px solid var(--border);
		font-family: var(--font-display);
		font-size: 1.1rem;
		cursor: pointer;
		transition: all 0.1s ease;
		display: inline-block;
		box-shadow: 2px 2px 0 var(--shadow);
	}

	.file-input-label:hover {
		background: var(--accent);
		color: var(--bg);
		transform: translate(1px, 1px);
		box-shadow: 1px 1px 0 var(--shadow);
	}

	.file-name {
		font-family: var(--font-display);
		font-size: 1rem;
		color: var(--muted);
		font-style: italic;
	}

	.form-group select {
		padding: 0.5rem;
		border: 2px solid var(--border);
		background: var(--bg);
		color: var(--text);
		font-family: var(--font-body);
		font-size: 1rem;
	}

	.error-message {
		margin-top: 0.5rem;
		padding: 0.5rem;
		background: var(--panel);
		border: 2px solid var(--border);
		color: var(--text);
		font-family: var(--font-display);
		font-size: 1rem;
		min-height: 1.5rem;
	}

	.file-item {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		padding: 0.75rem;
		background: var(--panel);
		border: 1px solid var(--border);
		font-family: var(--font-display);
		font-size: 1rem;
	}

	.file-item .file-name {
		flex: 1;
		font-style: normal;
		word-break: break-all;
	}

	.status {
		color: #666;
		font-size: 0.9rem;
		white-space: nowrap;
		flex-shrink: 0;
	}

	.info-content {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.info-content p {
		margin: 0;
		line-height: 1.6;
	}

	.info-content ul {
		margin: 0;
		padding-left: 1.5rem;
		list-style-type: disc;
	}

	.info-content li {
		margin: 0.5rem 0;
		line-height: 1.6;
	}

	.info-content strong {
		color: var(--accent);
	}

	@media (max-width: 768px) {
		.tools-hero h1 {
			font-size: 2rem;
		}

		.row {
			flex-direction: column;
		}

		.file-item {
			flex-direction: column;
			gap: 0.5rem;
		}

		.status {
			white-space: normal;
		}
	}
</style>
