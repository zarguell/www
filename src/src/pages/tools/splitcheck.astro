---
import ToolLayout from '../../layouts/ToolLayout.astro';
import Window from '../../components/Window.astro';
---

<ToolLayout title="SplitCheck - Expense Splitting Calculator">
	<div class="splitcheck-container">
		<div class="topbar">
			<div>
				<h1>SplitCheck</h1>
				<div class="badge" aria-live="polite">
					<strong>Status:</strong>
					<span id="modeValue">View-only</span>
				</div>
			</div>
			<div class="btnrow" id="topActions">
				<button id="copyLinkBtn" class="retro-button retro-button--secondary smallbtn" type="button">Copy link</button>
			</div>
		</div>

		<div id="modeNotice" class="notice hidden" role="note"></div>

		<!-- Manage-only UI -->
		<div id="manageUI" class="hidden">
			<Window title="Share" badgeText="LINKS">
				<p class="muted">Send the view link to friends. Keep the manage link private.</p>
				<div class="primaryShare">
					<button id="copyViewBtn" class="retro-button retro-button--secondary" type="button">Copy view link</button>
					<button id="copyManageBtn" class="retro-button retro-button--secondary" type="button">Copy manage link</button>
				</div>
				<div class="hint" id="shareStatus" aria-live="polite"></div>
				<textarea id="urlBox" class="form-control mono" rows="3" readonly aria-label="Link"></textarea>
				<div class="hint muted" id="urlLen"></div>
			</Window>

			<Window title="People" badgeText="MANAGE">
				<div class="row">
					<div>
						<label class="form-label" for="personName">Add person</label>
						<input id="personName" class="form-control" type="text" placeholder="Name" maxlength="50" autocomplete="off" />
						<button id="addPersonBtn" class="retro-button retro-button--primary" type="button">Add Person</button>
					</div>
					<div>
						<label class="form-label">Keyboard shortcuts</label>
						<div class="shortcuts-card">
							<div class="muted">Enter: Add person (name box)</div>
							<div class="muted">Ctrl/Cmd+K: Copy view link</div>
							<div class="muted">Ctrl/Cmd+Shift+K: Copy manage link</div>
						</div>
					</div>
				</div>

				<h2>People List</h2>
				<div id="peopleList" class="chips" aria-live="polite"></div>
			</Window>

			<Window title="Add Expense" badgeText="ADD">
				<div class="row">
					<div>
						<label class="form-label" for="expenseDesc">Description</label>
						<input id="expenseDesc" class="form-control" type="text" placeholder="Dinner, Uber, Groceries…" maxlength="100" autocomplete="off" />
					</div>
					<div>
						<label class="form-label" for="expenseAmount">Amount</label>
						<input id="expenseAmount" class="form-control" type="number" placeholder="0.00" step="0.01" min="0.01" inputmode="decimal" />
					</div>
				</div>

				<div class="row">
					<div>
						<label class="form-label" for="expensePayer">Paid by</label>
						<select id="expensePayer" class="form-control" aria-label="Expense payer"></select>
					</div>
					<div>
						<label class="form-label" for="splitType">Split type</label>
						<select id="splitType" class="form-control" aria-label="Split type">
							<option value="even">Even split</option>
							<option value="custom">Custom amounts</option>
						</select>
					</div>
				</div>

				<div id="customSplitInputs" class="hidden" aria-label="Custom split inputs"></div>
				<div class="hint" id="customHint"></div>

				<button id="addExpenseBtn" class="retro-button retro-button--primary" type="button">Add Expense</button>
			</Window>

			<Window title="Export / Import" badgeText="DATA">
				<div class="twocols">
					<button id="exportBtn" class="retro-button retro-button--secondary" type="button">Copy JSON</button>
					<button id="importBtn" class="retro-button retro-button--secondary" type="button">Import JSON</button>
				</div>
				<button id="resetBtn" class="retro-button retro-button--danger" type="button">Reset</button>
				<div class="hint" id="ioStatus" aria-live="polite"></div>
			</Window>
		</div>

		<!-- View-only UI -->
		<div id="viewUI" class="card hidden">
			<h2>View-only</h2>
			<div class="muted">This page is read-only.</div>
		</div>

		<!-- Always-visible results -->
		<div id="resultsUI">
			<Window title="Expenses" badgeText="LIST">
				<div id="expensesList" aria-live="polite"></div>
			</Window>

			<Window title="Balances" badgeText="CALCULATED">
				<div id="balancesList" aria-live="polite"></div>
			</Window>

			<Window title="Who owes who" badgeText="SETTLEMENTS">
				<div id="settlementsList" aria-live="polite"></div>
			</Window>
		</div>
	</div>

	<script src="https://cdn.jsdelivr.net/npm/lz-string@1.5.0/libs/lz-string.min.js" is:inline></script>
	<script define:vars={{}}>
		// Internal mechanics:
		// - "view" link uses param e
		// - "manage" link uses param d
		//
		// UX rules:
		// - View pages never show alternate links or "manage" affordances.
		// - Manage pages show both "view link" and "manage link".
		// - Top-right "Copy link" behaves contextually:
		//   - In view mode: copies the current (view) link
		//   - In manage mode: copies the view link (default share-first)

		const DEFAULT_STATE = { people: [], expenses: [] };

		const app = {
			data: structuredClone(DEFAULT_STATE),
			mode: 'manage', // 'manage' | 'view'
			lastURLWriteOk: true
		};

		const els = {};
		function bindEls() {
			els.modeValue = document.getElementById('modeValue');
			els.modeNotice = document.getElementById('modeNotice');

			els.topActions = document.getElementById('topActions');
			els.copyLinkBtn = document.getElementById('copyLinkBtn');

			els.manageUI = document.getElementById('manageUI');
			els.viewUI = document.getElementById('viewUI');

			els.copyViewBtn = document.getElementById('copyViewBtn');
			els.copyManageBtn = document.getElementById('copyManageBtn');
			els.shareStatus = document.getElementById('shareStatus');
			els.urlBox = document.getElementById('urlBox');
			els.urlLen = document.getElementById('urlLen');

			els.personName = document.getElementById('personName');
			els.addPersonBtn = document.getElementById('addPersonBtn');
			els.peopleList = document.getElementById('peopleList');

			els.expenseDesc = document.getElementById('expenseDesc');
			els.expenseAmount = document.getElementById('expenseAmount');
			els.expensePayer = document.getElementById('expensePayer');
			els.splitType = document.getElementById('splitType');
			els.customSplitInputs = document.getElementById('customSplitInputs');
			els.customHint = document.getElementById('customHint');
			els.addExpenseBtn = document.getElementById('addExpenseBtn');

			els.exportBtn = document.getElementById('exportBtn');
			els.importBtn = document.getElementById('importBtn');
			els.resetBtn = document.getElementById('resetBtn');
			els.ioStatus = document.getElementById('ioStatus');

			els.expensesList = document.getElementById('expensesList');
			els.balancesList = document.getElementById('balancesList');
			els.settlementsList = document.getElementById('settlementsList');
		}

		// --- Compression helpers ---
		function encodeState(obj) {
			return LZString.compressToEncodedURIComponent(JSON.stringify(obj));
		}
		function decodeState(str) {
			const json = LZString.decompressFromEncodedURIComponent(str);
			if (!json) return null;
			return JSON.parse(json);
		}

		// --- URL helpers ---
		function getParams() {
			const sp = new URLSearchParams(window.location.search);
			return { e: sp.get('e'), d: sp.get('d') };
		}

		function buildLink(kind) {
			// kind: 'view' => e=, 'manage' => d=
			const url = new URL(window.location.origin + window.location.pathname);
			const encoded = encodeState(app.data);
			if (kind === 'view') url.searchParams.set('e', encoded);
			else url.searchParams.set('d', encoded);
			return url.toString();
		}

		function parseURLIntoState() {
			const { e, d } = getParams();

			if (e) {
				app.mode = 'view';
				try {
					const parsed = decodeState(e);
					if (parsed && typeof parsed === 'object') app.data = parsed;
				} catch {}
				return;
			}

			if (d) {
				app.mode = 'manage';
				try {
					const parsed = decodeState(d);
					if (parsed && typeof parsed === 'object') app.data = parsed;
				} catch {}
				return;
			}

			app.mode = 'manage';
			app.data = structuredClone(DEFAULT_STATE);
		}

		function writeManageURL() {
			if (app.mode !== 'manage') return;

			const url = new URL(window.location.href);
			url.searchParams.delete('e');
			url.searchParams.set('d', encodeState(app.data));

			if (url.toString().length > 2000) {
				app.lastURLWriteOk = false;
				renderURLMeta();
				return;
			}
			app.lastURLWriteOk = true;
			history.replaceState({}, '', url);
			renderURLMeta();
		}

		const writeManageURLDebounced = (() => {
			let t = null;
			return () => { clearTimeout(t); t = setTimeout(writeManageURL, 300); };
		})();

		// --- Clipboard ---
		async function copy(kind) {
			const url = buildLink(kind);
			const tooLong = url.length > 2000;

			try {
				await navigator.clipboard.writeText(url);
				if (els.shareStatus) {
					els.shareStatus.textContent = (kind === 'view') ? 'Copied view link.' : 'Copied manage link.';
					els.shareStatus.className = 'hint ok';
				}
			} catch {
				if (els.shareStatus) {
					els.shareStatus.textContent = 'Could not copy automatically. Copy from the box below.';
					els.shareStatus.className = 'hint warn';
				}
			}

			if (els.urlBox) els.urlBox.value = url;
			renderURLMeta(tooLong);
		}

		// --- Manage actions ---
		function addPerson() {
			if (app.mode !== 'manage') return;
			const name = (els.personName.value || '').trim();
			if (!name) return;
			if (app.data.people.includes(name)) return;
			app.data.people.push(name);
			els.personName.value = '';
			syncAll();
		}

		function removePerson(name) {
			if (app.mode !== 'manage') return;
			app.data.people = app.data.people.filter(p => p !== name);
			app.data.expenses = app.data.expenses
				.filter(e => e.payer !== name)
				.map(e => {
					if (e.splitType === 'custom' && e.customSplits) {
						const cs = { ...e.customSplits };
						delete cs[name];
						return { ...e, customSplits: cs };
					}
					return e;
				});
			syncAll();
		}

		function updatePayerSelect() {
			const opts = app.data.people.map(p => `<option value="${escapeHTML(p)}">${escapeHTML(p)}</option>`).join('');
			els.expensePayer.innerHTML = opts;
		}

		function toggleCustomSplit() {
			const type = els.splitType.value;
			if (type === 'custom') {
				els.customSplitInputs.classList.remove('hidden');
				renderCustomSplitInputs();
			} else {
				els.customSplitInputs.classList.add('hidden');
				els.customSplitInputs.innerHTML = '';
				els.customHint.textContent = '';
			}
		}

		function renderCustomSplitInputs() {
			const people = app.data.people;
			if (!people.length) {
				els.customSplitInputs.innerHTML = '<div class="muted">Add people first.</div>';
				return;
			}
			els.customSplitInputs.innerHTML = people.map(p => `
				<div class="row" style="grid-template-columns:1fr 140px;align-items:center">
					<label for="cs_${cssId(p)}">${escapeHTML(p)}</label>
					<input id="cs_${cssId(p)}" class="form-control" type="number" min="0" step="0.01" placeholder="0.00" inputmode="decimal" />
				</div>
			`).join('');
			els.customHint.textContent = 'Custom amounts must sum exactly to the expense amount.';
			els.customHint.className = 'hint muted';
		}

		function addExpense() {
			if (app.mode !== 'manage') return;
			if (!app.data.people.length) return;

			const description = (els.expenseDesc.value || '').trim();
			const amount = Number(els.expenseAmount.value);
			const payer = els.expensePayer.value;
			const splitType = els.splitType.value;

			if (!description || !isFinite(amount) || amount <= 0 || !payer) return;

			const expense = {
				id: crypto.randomUUID ? crypto.randomUUID() : String(Date.now()) + '_' + Math.random().toString(16).slice(2),
				description,
				amount: round2(amount),
				payer,
				splitType
			};

			if (splitType === 'custom') {
				const customSplits = {};
				let sum = 0;
				for (const person of app.data.people) {
					const el = document.getElementById(`cs_${cssId(person)}`);
					const val = Number(el?.value || 0);
					if (val > 0) {
						customSplits[person] = round2(val);
						sum += round2(val);
					}
				}
				sum = round2(sum);
				if (Math.abs(sum - expense.amount) > 0.01) {
					els.customHint.textContent = `Custom split sums to $${sum.toFixed(2)} but needs $${expense.amount.toFixed(2)}.`;
					els.customHint.className = 'hint warn';
					return;
				}
				expense.customSplits = customSplits;
			}

			app.data.expenses.push(expense);
			els.expenseDesc.value = '';
			els.expenseAmount.value = '';
			syncAll();
		}

		function removeExpense(id) {
			if (app.mode !== 'manage') return;
			app.data.expenses = app.data.expenses.filter(e => e.id !== id);
			syncAll();
		}

		// --- Computation ---
		function computeBalances() {
			const balances = Object.fromEntries(app.data.people.map(p => [p, 0]));
			const people = app.data.people;
			const n = people.length || 1;

			for (const e of app.data.expenses) {
				if (balances[e.payer] === undefined) continue;

				if (e.splitType === 'even') {
					const share = round2(e.amount / n);
					for (const p of people) balances[p] = round2(balances[p] + share);
					balances[e.payer] = round2(balances[e.payer] - e.amount);
				} else {
					const splits = e.customSplits || {};
					for (const p of people) {
						const owed = round2(Number(splits[p] || 0));
						balances[p] = round2(balances[p] + owed);
					}
					balances[e.payer] = round2(balances[e.payer] - e.amount);
				}
			}
			return balances; // positive => owes, negative => is owed
		}

		function computeSettlements(balances) {
			const debtors = [];
			const creditors = [];
			for (const [p, amt] of Object.entries(balances)) {
				if (amt > 0.009) debtors.push({ p, amt: round2(amt) });
				else if (amt < -0.009) creditors.push({ p, amt: round2(-amt) });
			}
			debtors.sort((a,b) => b.amt - a.amt);
			creditors.sort((a,b) => b.amt - a.amt);

			const tx = [];
			let i = 0, j = 0;
			while (i < debtors.length && j < creditors.length) {
				const pay = debtors[i], recv = creditors[j];
				const amt = round2(Math.min(pay.amt, recv.amt));
				if (amt > 0) tx.push({ from: pay.p, to: recv.p, amount: amt });

				pay.amt = round2(pay.amt - amt);
				recv.amt = round2(recv.amt - amt);

				if (pay.amt <= 0.009) i++;
				if (recv.amt <= 0.009) j++;
			}
			return tx;
		}

		// --- Rendering ---
		function applyModeUI() {
			if (app.mode === 'view') {
				els.modeValue.textContent = 'View-only';
				els.modeNotice.textContent = 'This page is read-only.';
				els.modeNotice.className = 'notice view';
				els.modeNotice.classList.remove('hidden');

				els.manageUI.classList.add('hidden');
				els.viewUI.classList.remove('hidden');

				// In view mode, do not show any alternative links.
				els.urlBox && (els.urlBox.value = '');
				els.copyLinkBtn.textContent = 'Copy link';
			} else {
				els.modeValue.textContent = 'Manage';
				els.modeNotice.textContent = 'Share the view link with friends. Keep the manage link private.';
				els.modeNotice.className = 'notice manage';
				els.modeNotice.classList.remove('hidden');

				els.manageUI.classList.remove('hidden');
				els.viewUI.classList.add('hidden');

				// Share-first: top "Copy link" copies view link.
				els.copyLinkBtn.textContent = 'Copy view link';
			}
		}

		function renderPeople() {
			els.peopleList.innerHTML = app.data.people.length
				? app.data.people.map(p => `
						<div class="chip">
							<span>${escapeHTML(p)}</span>
							<button class="retro-button retro-button--danger" type="button" aria-label="Remove ${escapeHTML(p)}" data-remove-person="${escapeHTML(p)}">×</button>
						</div>
					`).join('')
				: `<div class="muted">Add at least 2 people to start splitting.</div>`;
		}

		function renderExpenses() {
			const canEdit = app.mode === 'manage';
			if (!app.data.expenses.length) {
				els.expensesList.innerHTML = `<div class="muted">No expenses yet.</div>`;
				return;
			}
			els.expensesList.innerHTML = app.data.expenses.map(e => `
				<div class="card">
					<div style="display:flex;justify-content:space-between;gap:10px;align-items:flex-start">
						<div>
							<div><strong>${escapeHTML(e.description)}</strong></div>
							<div class="muted">$${Number(e.amount).toFixed(2)} • paid by ${escapeHTML(e.payer)} • ${e.splitType === 'even' ? 'even split' : 'custom split'}</div>
						</div>
						${canEdit ? `<button class="retro-button retro-button--danger" style="width:auto;padding:8px 10px" type="button" data-remove-expense="${escapeHTML(e.id)}">Delete</button>` : ``}
					</div>
				</div>
			`).join('');
		}

		function renderBalancesAndSettlements() {
			const balances = computeBalances();
			const people = app.data.people;

			els.balancesList.innerHTML = people.length
				? people.map(p => {
						const amt = round2(balances[p] || 0);
						const cls = amt >= 0 ? 'card neg' : 'card pos';
						const label = amt >= 0 ? `Owes $${amt.toFixed(2)}` : `Is owed $${Math.abs(amt).toFixed(2)}`;
						return `<div class="${cls}"><strong>${escapeHTML(p)}</strong>: ${label}</div>`;
					}).join('')
				: `<div class="muted">Add people to see balances.</div>`;

			const settlements = computeSettlements(balances);
			els.settlementsList.innerHTML = settlements.length
				? settlements.map(t => `<div class="card settle">${escapeHTML(t.from)} pays ${escapeHTML(t.to)} <strong>$${t.amount.toFixed(2)}</strong></div>`).join('')
				: `<div class="muted">No payments needed.</div>`;
		}

		function renderURLMeta(overrideTooLong=null) {
			if (app.mode !== 'manage') return;

			const url = buildLink('manage'); // current working URL box in manage mode can show manage link by default
			const tooLong = overrideTooLong === null ? (url.length > 2000) : overrideTooLong;

			els.urlBox.value = url;

			els.urlLen.textContent = `URL length: ${url.length} chars` + (app.lastURLWriteOk ? '' : ' (too long to auto-write)');
			els.urlLen.className = 'hint ' + (tooLong ? 'warn' : 'muted');
		}

		function render() {
			applyModeUI();

			if (app.mode === 'manage') {
				renderPeople();
				updatePayerSelect();
				toggleCustomSplit();
			}

			renderExpenses();
			renderBalancesAndSettlements();
			renderURLMeta();
		}

		function syncAll() {
			render();
			writeManageURLDebounced();
		}

		// --- Import/Export/Reset (manage only) ---
		async function exportJSON() {
			if (app.mode !== 'manage') return;
			try {
				await navigator.clipboard.writeText(JSON.stringify(app.data, null, 2));
				els.ioStatus.textContent = 'Copied JSON to clipboard.';
				els.ioStatus.className = 'hint ok';
			} catch {
				els.ioStatus.textContent = 'Could not copy JSON automatically.';
				els.ioStatus.className = 'hint warn';
			}
		}

		async function importJSON() {
			if (app.mode !== 'manage') return;
			const raw = prompt('Paste JSON:');
			if (!raw) return;
			try {
				const parsed = JSON.parse(raw);
				if (!parsed || !Array.isArray(parsed.people) || !Array.isArray(parsed.expenses)) throw new Error('Bad shape');
				app.data = parsed;
				els.ioStatus.textContent = 'Imported JSON.';
				els.ioStatus.className = 'hint ok';
				syncAll();
			} catch {
				els.ioStatus.textContent = 'Invalid JSON.';
				els.ioStatus.className = 'hint warn';
			}
		}

		function resetAll() {
			if (app.mode !== 'manage') return;
			app.data = structuredClone(DEFAULT_STATE);
			const url = new URL(window.location.origin + window.location.pathname);
			url.searchParams.set('d', encodeState(app.data));
			history.replaceState({}, '', url);
			els.customHint.textContent = '';
			els.shareStatus.textContent = '';
			syncAll();
		}

		// --- Utilities ---
		function round2(n) { return Math.round((Number(n) + Number.EPSILON) * 100) / 100; }
		function escapeHTML(s) {
			return String(s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
		}
		function cssId(s) { return String(s).replace(/[^a-zA-Z0-9_-]/g, '_'); }

		// --- Events ---
		function wireEvents() {
			// Contextual top button:
			// - view: copies view link (current)
			// - manage: copies view link (default)
			els.copyLinkBtn.addEventListener('click', () => {
				if (app.mode === 'view') copy('view');
				else copy('view');
			});

			// Manage-only share buttons
			els.copyViewBtn.addEventListener('click', () => copy('view'));
			els.copyManageBtn.addEventListener('click', () => copy('manage'));

			// Manage actions
			els.addPersonBtn.addEventListener('click', addPerson);
			els.personName.addEventListener('keydown', (e) => {
				if (e.key === 'Enter') { e.preventDefault(); addPerson(); }
			});

			els.splitType.addEventListener('change', () => { toggleCustomSplit(); });

			els.addExpenseBtn.addEventListener('click', addExpense);

			els.peopleList.addEventListener('click', (e) => {
				const btn = e.target.closest('[data-remove-person]');
				if (!btn) return;
				const name = btn.getAttribute('data-remove-person');
				if (confirm(`Remove ${name}?`)) removePerson(name);
			});

			els.expensesList.addEventListener('click', (e) => {
				const btn = e.target.closest('[data-remove-expense]');
				if (!btn) return;
				const id = btn.getAttribute('data-remove-expense');
				removeExpense(id);
			});

			els.exportBtn.addEventListener('click', exportJSON);
			els.importBtn.addEventListener('click', importJSON);
			els.resetBtn.addEventListener('click', () => {
				if (app.mode !== 'manage') return;
				if (confirm('Reset everything?')) resetAll();
			});

			document.addEventListener('keydown', (e) => {
				const key = e.key.toLowerCase();
				const mod = e.ctrlKey || e.metaKey;
				if (!mod) return;
				if (key === 'k' && !e.shiftKey) { e.preventDefault(); copy('view'); }
				if (key === 'k' && e.shiftKey) { e.preventDefault(); copy('manage'); }
			});

			window.addEventListener('popstate', () => {
				parseURLIntoState();
				render();
			});
		}

		// --- Boot ---
		document.addEventListener('DOMContentLoaded', () => {
			bindEls();
			parseURLIntoState();
			wireEvents();
			render();

			// Creator flow: if no params, create manage link immediately (so they can bookmark/return)
			const { e, d } = getParams();
			if (!e && !d) {
				const url = new URL(window.location.origin + window.location.pathname);
				url.searchParams.set('d', encodeState(app.data));
				history.replaceState({}, '', url);
				app.mode = 'manage';
				els.modeValue.textContent = 'Manage';
				els.modeNotice.textContent = 'New split created. Share the view link with friends and keep the manage link private.';
				els.modeNotice.className = 'notice manage';
				els.modeNotice.classList.remove('hidden');
				els.manageUI.classList.remove('hidden');
				els.viewUI.classList.add('hidden');
				renderURLMeta();
			}

			// View mode: hide any hint/status areas that imply alternative links
			if (app.mode === 'view') {
				// remove share/status elements if present (defense-in-depth)
				if (els.manageUI) els.manageUI.classList.add('hidden');
				if (els.shareStatus) els.shareStatus.textContent = '';
			}
		});
	</script>
</ToolLayout>

