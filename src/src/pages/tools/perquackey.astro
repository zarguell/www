---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Window from '../../components/Window.astro';
import RetroButton from '../../components/RetroButton.astro';
import Badge from '../../components/Badge.astro';
import DiceConfig from '../../components/DiceConfig.astro';
import DiceRoller from '../../components/DiceRoller.astro';

const ogImage = new URL('/assets/perquackey-og.jpg', Astro.site);
---

<BaseLayout title="Perquackey Tracker" description="Track your Perquackey word game scores with automatic timer, dictionary validation, and complete game state management" ogImage={ogImage.toString()} hideAimChat={true}>
	<div class="tool-hero">
		<h1>PERQUACKEY TRACKER</h1>
		<p>Word Game Score Tracker with Timer & Dictionary</p>
	</div>

	<div id="app">
		<div id="setup-phase" class="phase">
			<DiceConfig />

			<Window title="Game Setup">
				<div class="form-group">
					<label for="player-name">Add Player</label>
					<input type="text" id="player-name" placeholder="Enter player name" maxlength="20" />
					<button id="add-player-btn" class="retro-button">Add Player</button>
				</div>

				<div id="players-list"></div>

				<div class="form-group">
					<label for="round-time">Round Time (seconds)</label>
					<input type="number" id="round-time" value="180" min="30" max="600" />
					<small>Default: 180 seconds (3 minutes)</small>
				</div>

				<div class="form-group">
					<label for="score-limit">Game End Score</label>
					<input type="number" id="score-limit" value="5000" min="1000" max="20000" step="500" />
					<small>Default: 5000 points</small>
				</div>

				<div id="setup-actions">
					<button id="start-game-btn" class="retro-button retro-button--primary" disabled>Start Game</button>
				</div>
			</Window>
		</div>

		<div id="playing-phase" class="phase" style="display: none;">
			<div class="timer-display" id="timer">3:00</div>
			<div class="current-player" id="current-player-name"></div>

			<div id="manual-word-entry">
				<Window title="Word Entry">
					<div class="form-group">
						<input type="text" id="word-input" placeholder="Enter word (3-8 letters)" maxlength="8" />
						<div id="validation-message" class="validation-message"></div>
						<button id="override-btn" class="override-btn" style="display: none;">Override Dictionary</button>
					</div>
				</Window>
			</div>

			<div id="virtual-dice-entry" style="display: none;">
				<DiceRoller />
				<div id="dice-validation-message" class="validation-message"></div>
			</div>

			<Window title="Current Words">
				<div id="current-words" class="words-list"></div>
			</Window>

			<Window title="Controls">
				<div class="controls-row">
					<button id="start-timer-btn" class="retro-button retro-button--primary">Start Timer</button>
					<button id="pause-timer-btn" class="retro-button retro-button--secondary" style="display: none;">Pause Timer</button>
				</div>
				<div class="controls-row">
					<button id="end-round-btn" class="retro-button">End Round</button>
					<button id="restart-round-btn" class="retro-button retro-button--secondary">Restart Round</button>
					<button id="forfeit-round-btn" class="retro-button retro-button--danger">Forfeit Round</button>
				</div>
				<div class="controls-row">
					<button id="toggle-sound-btn" class="mute-btn">🔊 Sound On</button>
					<button id="end-game-btn" class="retro-button retro-button--danger">End Game</button>
				</div>
			</Window>
		</div>

		<div id="round-complete-phase" class="phase" style="display: none;">
			<Window title="Round Summary">
				<div id="round-summary"></div>
				<div class="form-group">
					<label for="manual-adjustment">Manual Score Adjustment</label>
					<input type="number" id="manual-adjustment" value="0" />
					<button id="apply-adjustment-btn" class="retro-button">Apply</button>
				</div>
			</Window>

			<Window title="Actions">
				<div class="controls-row">
					<button id="edit-words-btn" class="retro-button retro-button--secondary">Edit Words</button>
					<button id="confirm-round-btn" class="retro-button retro-button--primary">Confirm & Next</button>
				</div>
			</Window>
		</div>

		<div id="game-over-phase" class="phase" style="display: none;">
			<Window title="Game Recap">
				<div id="game-recap-card" class="recap-card">
					<div id="recap-winner" class="recap-section"></div>
					<div id="recap-stats" class="recap-section"></div>
					<div id="recap-scores" class="recap-section"></div>
					<div id="recap-longest-word" class="recap-section"></div>
					<div id="recap-best-round" class="recap-section"></div>
				</div>
				<div class="recap-actions">
					<button id="share-recap-btn" class="retro-button retro-button--primary">📤 Share Results</button>
					<button id="play-again-btn" class="retro-button">Play Again</button>
					<button id="new-game-btn" class="retro-button retro-button--secondary">New Game</button>
				</div>
			</Window>
		</div>

		<div id="rules-reference" class="rules-reference">
			<Window title="Perquackey Rules (Quick Reference)">
				<div class="rules-content">
					<h4>Objective</h4>
					<p>First player to reach the score limit wins!</p>
					
					<h4>Gameplay</h4>
					<ul>
						<li>Create words using letter dice (3-8 letters long)</li>
						<li>Maximum 5 words per letter length</li>
						<li>3-letter words disabled when vulnerable (2000+ points)</li>
					</ul>
					
					<h4>Scoring</h4>
					<div class="scoring-table">
						<div class="score-row"><span>3-letter words:</span><span>60/70/80/90/100</span></div>
						<div class="score-row"><span>4-letter words:</span><span>120/140/160/180/200</span></div>
						<div class="score-row"><span>5-letter words:</span><span>200/250/300/350/400</span></div>
						<div class="score-row"><span>6-letter words:</span><span>300/400/500/600/700</span></div>
						<div class="score-row"><span>7-letter words:</span><span>500/650/800/950/1100</span></div>
						<div class="score-row"><span>8-letter words:</span><span>750/1000/1250/1500/1750</span></div>
					</div>
					
					<h4>Bonuses</h4>
					<ul>
						<li>3+4 complete: +300</li>
						<li>4+5 complete: +500</li>
						<li>5+6 complete: +800</li>
						<li>6+7 complete: +1200</li>
						<li>7+8 complete: +1850</li>
					</ul>
					
					<h4>Vulnerability & Penalty</h4>
					<ul>
						<li>At 2000+ points: 3-letter words disabled (RED DICE active)</li>
						<li>If round score &lt; 500 while vulnerable: -500 penalty</li>
					</ul>
				</div>
			</Window>
		</div>

		<div id="standings-window" class="standings-window" style="display: none;">
			<Window title="Standings" badgeText="MINI">
				<div class="standings-header">
					<span class="standings-title">Player Standings</span>
					<button id="toggle-standings-btn" class="toggle-btn">−</button>
				</div>
				<div id="standings-list" class="standings-list"></div>
			</Window>
		</div>
	</div>
</BaseLayout>

<style>
	.tool-hero h1 {
		font-size: 3rem;
		margin-bottom: 0.5rem;
	}

	#app {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
		max-width: 1200px;
		margin: 0 auto;
	}

	.phase {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}

	.form-group {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		margin-bottom: 1rem;
	}

	.form-group label {
		font-size: 1.2rem;
		font-weight: bold;
	}

	.form-group input {
		padding: 0.75rem;
		font-size: 1rem;
		font-family: var(--font-body);
		border: 2px solid var(--border);
		background: var(--bg);
		color: var(--text);
	}

	#player-name, #word-input, #manual-adjustment {
		text-transform: uppercase;
	}

	#players-list, #current-words, #standings-list, #round-summary, #final-scores {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	.player-item, .word-item, .standing-item {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.5rem;
		border: 1px solid var(--border);
		background: var(--bg2);
	}

	.player-item, .standing-item {
		justify-content: space-between;
	}

	.word-item {
		justify-content: space-between;
	}

	.word-length-group {
		margin-bottom: 1rem;
	}

	.word-length-header {
		font-weight: bold;
		margin-bottom: 0.5rem;
		color: var(--accent);
	}

	.controls-row {
		display: flex;
		gap: 0.5rem;
		flex-wrap: wrap;
	}

	.timer-display {
		font-size: 4rem;
		text-align: center;
		padding: 1rem;
		border: 3px solid var(--border);
		background: var(--bg2);
		margin-bottom: 1rem;
	}

	.timer-display.warning {
		color: var(--warning);
	}

	.timer-display.danger {
		color: var(--danger);
		animation: pulse 0.5s infinite;
	}

	.timer-display.time-up {
		animation: blinkRed 0.5s infinite;
		background: var(--danger) !important;
		color: #ffffff !important;
	}

	@keyframes pulse {
		0%, 100% { opacity: 1; }
		50% { opacity: 0.5; }
	}

	@keyframes blinkRed {
		0%, 100% { opacity: 1; }
		50% { opacity: 0.3; }
	}

	.current-player {
		font-size: 2rem;
		text-align: center;
		margin-bottom: 1rem;
		color: var(--accent);
	}

	.validation-message {
		min-height: 1.5rem;
		font-size: 1rem;
		margin-top: 0.25rem;
	}

	.validation-message.error {
		color: var(--danger);
	}

	.validation-message.success {
		color: var(--success);
	}

	.validation-message.info {
		color: var(--accent2);
	}

	.override-btn {
		background: var(--danger);
		border: 2px solid var(--border);
		color: white;
		padding: 0.5rem 1rem;
		font-family: var(--font-display);
		font-size: 1rem;
		cursor: pointer;
		transition: all 0.2s ease;
		margin-top: 0.5rem;
	}

	.override-btn:hover {
		background: var(--danger);
		transform: scale(1.02);
	}

	.score-row {
		display: flex;
		justify-content: space-between;
		padding: 0.25rem 0;
		border-bottom: 1px solid var(--border);
	}

	.bonus-highlight {
		color: var(--success);
		font-weight: bold;
	}

	.total-score {
		font-size: 1.5rem;
		font-weight: bold;
		text-align: right;
		margin-top: 1rem;
		color: var(--accent);
	}

	.winner-text {
		font-size: 2.5rem;
		text-align: center;
		color: var(--accent);
		margin-bottom: 1rem;
	}

	.vulnerability-badge {
		display: inline-block;
		padding: 0.25rem 0.5rem;
		background: var(--danger);
		color: white;
		font-size: 0.8rem;
		margin-left: 0.5rem;
	}

	.red-dice-badge {
		display: inline-block;
		padding: 0.25rem 0.5rem;
		background: var(--danger);
		color: white;
		font-size: 0.8rem;
		margin-left: 0.5rem;
	}

	.standings-window {
		position: fixed;
		bottom: 1rem;
		right: 1rem;
		max-width: 200px;
		min-width: 180px;
		z-index: 100;
		transition: all 0.3s ease;
	}

	.standings-window.collapsed {
		max-width: 180px;
	}

	.standings-window.collapsed .standings-list {
		display: none;
	}

	.standings-header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 0.5rem;
		cursor: move;
	}

	.standings-title {
		font-size: 0.9rem;
		font-weight: bold;
		color: var(--accent);
	}

	.toggle-btn {
		background: var(--bg);
		border: 1px solid var(--border);
		color: var(--text);
		font-family: var(--font-display);
		font-size: 1.2rem;
		line-height: 1;
		padding: 0.25rem 0.5rem;
		cursor: pointer;
		transition: all 0.2s ease;
	}

	.toggle-btn:hover {
		background: var(--accent);
		color: var(--sticker-text);
	}

	.standings-list {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		margin-top: 0.5rem;
		transition: all 0.3s ease;
	}

	.standing-item {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 0.5rem;
		padding: 0.25rem 0.5rem;
		font-size: 0.85rem;
		border-bottom: 1px solid var(--border);
		background: var(--bg2);
	}

	.rules-reference {
		max-width: 1200px;
		margin: 2rem auto 0;
	}

	.rules-content {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.rules-content h4 {
		margin: 0;
		font-size: 1.1rem;
	}

	.rules-content p {
		margin: 0.25rem 0;
	}

	.rules-content ul {
		margin: 0.25rem 0;
		padding-left: 1.5rem;
	}

	.rules-content ul li {
		margin-bottom: 0.25rem;
	}

	.scoring-table {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		background: var(--bg2);
		padding: 0.5rem;
		border: 1px solid var(--border);
	}

	.recap-card {
		background: var(--bg2);
		border: 2px solid var(--accent);
		padding: 1.5rem;
		margin-bottom: 1rem;
	}

	.recap-section {
		margin-bottom: 1rem;
		padding-bottom: 1rem;
		border-bottom: 1px solid var(--border);
	}

	.recap-section:last-child {
		border-bottom: none;
		margin-bottom: 0;
		padding-bottom: 0;
	}

	.recap-label {
		color: var(--accent);
		font-weight: bold;
		font-size: 1.1rem;
		margin-bottom: 0.5rem;
	}

	.recap-value {
		font-size: 1.3rem;
		margin-left: 0.5rem;
	}

	.mute-btn {
		background: var(--bg);
		border: 2px solid var(--border);
		color: var(--text);
		padding: 0.5rem 1rem;
		font-family: var(--font-display);
		font-size: 1rem;
		cursor: pointer;
		transition: all 0.2s ease;
	}

	.mute-btn:hover {
		background: var(--accent);
		color: var(--sticker-text);
	}

	.mute-btn.muted {
		opacity: 0.5;
	}

	.recap-actions {
		display: flex;
		gap: 0.5rem;
		flex-wrap: wrap;
		margin-top: 1rem;
	}

	/* Virtual dice styles live in the <style is:global> block below — the dice
	   are rendered by JavaScript at runtime, so scoped selectors can't reach them. */

	@media (max-width: 768px) {
		.standings-window {
			position: static;
			max-width: 100%;
			min-width: 100%;
		}

		.timer-display {
			font-size: 3rem;
		}
	}
</style>

<style is:global>
	/* Dice are created by perquackey-app at runtime, so these rules must be
	   global. They live here (not global.css) because only this page rolls dice. */
	.dice-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(70px, 1fr));
		gap: 1rem;
		margin-bottom: 1.5rem;
		min-height: 100px;
	}

	.die {
		width: 70px;
		height: 70px;
		border: 6px solid var(--border);
		background: var(--bg);
		color: var(--text);
		font-family: var(--font-display);
		font-size: 2.5rem;
		font-weight: bold;
		display: flex;
		align-items: center;
		justify-content: center;
		cursor: pointer;
		user-select: none;
		position: relative;
		box-shadow:
			6px 6px 0 rgba(0, 0, 0, 0.4),
			inset 3px 3px 0 rgba(255, 255, 255, 0.15);
		transition: all 0.1s ease;
		image-rendering: pixelated;
		border-radius: 8px;
	}

	.die::before {
		content: '';
		position: absolute;
		top: 6px;
		left: 6px;
		right: 6px;
		bottom: 6px;
		border: 3px solid rgba(0, 0, 0, 0.3);
		border-radius: 4px;
		pointer-events: none;
	}

	.die::after {
		content: '';
		position: absolute;
		bottom: 3px;
		right: 3px;
		width: 8px;
		height: 8px;
		background: rgba(255, 255, 255, 0.2);
		border-radius: 50%;
		pointer-events: none;
	}

	.die.black {
		background: linear-gradient(135deg, #1a1a1a 0%, #0a0a0a 100%);
		color: #ffffff;
		border-color: #000000;
	}

	.die.black:hover {
		background: linear-gradient(135deg, #2a2a2a 0%, #1a1a1a 100%);
		transform: translate(-3px, -3px);
		box-shadow:
			9px 9px 0 rgba(0, 0, 0, 0.4),
			inset 3px 3px 0 rgba(255, 255, 255, 0.15);
	}

	.die.black.selected {
		background: linear-gradient(135deg, #3a3a3a 0%, #2a2a2a 100%);
		border-color: var(--accent);
		border-width: 8px;
		box-shadow:
			0 0 15px var(--accent),
			6px 6px 0 rgba(0, 0, 0, 0.4),
			inset 3px 3px 0 rgba(255, 255, 255, 0.2);
		transform: scale(1.08);
	}

	.die:focus-visible {
		outline: 3px solid var(--focus);
		outline-offset: 3px;
	}

	.die.red {
		background: linear-gradient(
			135deg,
			color-mix(in srgb, var(--danger) 85%, black) 0%,
			color-mix(in srgb, var(--danger) 60%, black) 100%
		);
		color: #ffffff;
		border-color: color-mix(in srgb, var(--danger) 55%, black);
	}

	.die.red:hover {
		background: linear-gradient(
			135deg,
			var(--danger) 0%,
			color-mix(in srgb, var(--danger) 75%, black) 100%
		);
		transform: translate(-3px, -3px);
		box-shadow:
			9px 9px 0 rgba(0, 0, 0, 0.4),
			inset 3px 3px 0 rgba(255, 255, 255, 0.15);
	}

	.die.red.selected {
		background: linear-gradient(
			135deg,
			color-mix(in srgb, var(--danger) 95%, white) 0%,
			var(--danger) 100%
		);
		border-color: var(--accent);
		border-width: 8px;
		box-shadow:
			0 0 15px var(--accent),
			6px 6px 0 rgba(0, 0, 0, 0.4),
			inset 3px 3px 0 rgba(255, 255, 255, 0.2);
		transform: scale(1.08);
	}

	.die.rolling {
		animation: roll 0.5s ease-in-out;
	}

	@keyframes roll {
		0% { transform: rotate(0deg) scale(1); }
		25% { transform: rotate(90deg) scale(1.1); }
		50% { transform: rotate(180deg) scale(1); }
		75% { transform: rotate(270deg) scale(1.1); }
		100% { transform: rotate(360deg) scale(1); }
	}

	@keyframes touch-pulse {
		0% { transform: scale(1); filter: brightness(1); }
		50% { transform: scale(1.05); filter: brightness(1.2); }
		100% { transform: scale(1); filter: brightness(1); }
	}

	.die.touch-active {
		animation: touch-pulse 0.15s ease-out;
	}

	.dice-controls {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.selected-word-display {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.75rem;
		background: var(--bg2);
		border: 2px solid var(--border);
		min-height: 3rem;
	}

	.selected-word-label {
		font-size: 1.1rem;
		font-weight: bold;
		color: var(--accent);
		white-space: nowrap;
	}

	.selected-word-value {
		font-size: 1.3rem;
		font-family: var(--font-display);
		font-weight: bold;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		flex: 1;
		color: var(--text);
	}

	.selected-word-value:empty::before {
		content: 'Click dice to select letters';
		color: var(--border);
		font-size: 1rem;
		letter-spacing: normal;
		text-transform: none;
	}

	.dice-actions {
		display: flex;
		gap: 0.5rem;
		flex-wrap: wrap;
	}

	.dice-actions .retro-button {
		flex: 1;
		min-width: 120px;
	}

	@keyframes reorder-pulse {
		0%, 100% {
			box-shadow: 0 0 15px var(--accent);
		}
		50% {
			box-shadow: 0 0 25px var(--focus), 0 0 35px var(--accent);
		}
	}

	.dice-container .die.reorder-target {
		animation: reorder-pulse 0.5s ease-in-out infinite;
		border-color: var(--focus) !important;
	}

	.reorder-help-text {
		background: var(--accent);
		color: var(--sticker-text);
		padding: 0.5rem;
		text-align: center;
		font-weight: bold;
		margin-bottom: 0.5rem;
		border-radius: 4px;
		animation: slideDown 0.2s ease-out;
		border: 2px solid var(--border);
		box-shadow: 3px 3px 0 var(--shadow);
	}

	@keyframes slideDown {
		from { opacity: 0; transform: translateY(-10px); }
		to { opacity: 1; transform: translateY(0); }
	}

	@media (max-width: 768px) {
		.dice-grid {
