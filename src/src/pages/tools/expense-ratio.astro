---
import PythonToolLayout from '../../layouts/PythonToolLayout.astro';
import Window from '../../components/Window.astro';
---

<PythonToolLayout title="Expense Ratio Impact Visualizer - ARGUELLES.ME" plotly>
	<div class="tool-header">
		<h1>Expense Ratio Impact Visualizer</h1>
		<p class="tool-subtitle">See the long-term cost of high expense ratios on your wealth</p>
	</div>

	<div class="tool-content">
		<form id="simulationForm">

		<script>
			document.getElementById("simulationForm")?.addEventListener("submit", (e) => e.preventDefault());
		</script>
			<Window title="Investment Parameters" badgeText="INPUTS">
				<div class="form-group">
					<label for="startingBalance">Starting Balance <small>($)</small></label>
					<input type="number" id="startingBalance" min="0" max="5000000" step="10000" value="100000" required />
					<small>Initial investment amount</small>
				</div>

				<div class="form-group">
					<label for="annualContribution">Annual Contribution <small>($)</small></label>
					<input type="number" id="annualContribution" min="0" max="50000" step="1000" value="10000" required />
					<small>Amount you'll add each year</small>
				</div>

				<div class="form-group">
					<label for="timeHorizon">Time Horizon <small>(years)</small></label>
					<input type="number" id="timeHorizon" min="1" max="50" value="30" required />
					<small>Investment timeframe (1-50 years)</small>
				</div>

				<div class="form-group">
					<label for="grossReturn">Gross Return <small>(decimal)</small></label>
					<input type="number" id="grossReturn" min="0.02" max="0.12" step="0.005" value="0.07" required />
					<small>Expected return before fees (2% - 12%)</small>
				</div>

				<div class="form-group">
					<label for="fundAer">Fund A Expense Ratio <small>(decimal)</small></label>
					<input type="number" id="fundAer" min="0.0003" max="0.02" step="0.0001" value="0.001" required />
					<small>Low-cost fund (e.g., 0.10% = 0.001)</small>
				</div>

				<div class="form-group">
					<label for="fundBer">Fund B Expense Ratio <small>(decimal)</small></label>
					<input type="number" id="fundBer" min="0.0003" max="0.02" step="0.0001" value="0.007" required />
					<small>Higher-cost fund (e.g., 0.70% = 0.007)</small>
				</div>

				<div class="button-group">
					<button type="button" class="retro-button retro-button--primary" py-click="calculate_impact">
						Compare Funds
					</button>
				</div>
			</Window>
		</form>

		<div id="chart-container" class="chart-container">
			<h3>Static Image (Click to Zoom)</h3>
			<div id="chart" class="click-zoom"></div>
		</div>

		<div id="plotly-container" class="chart-container">
			<h3>Interactive Charts (Hover for Exact Values)</h3>
			<div id="plotlyChart"></div>
		</div>

		<div id="summary"></div>
	</div>
</PythonToolLayout>

<script>
	import { watchForChart } from '../../scripts/zoomable-chart';
	watchForChart('chart', [{ img: 'chartImg', checkbox: 'zoom-checkbox-chart' }]);
</script>

<style>
	.tool-header { text-align: center; margin-bottom: 2rem; }
	.tool-header h1 { font-size: 2.5rem; margin: 0 0 0.5rem 0; color: var(--accent); }
	.tool-subtitle { font-size: 1.2rem; color: var(--muted); margin: 0; }
	.tool-content { display: flex; flex-direction: column; gap: 2rem; }
	.form-group { margin-bottom: 1.5rem; }
	.form-group label { display: block; font-weight: bold; margin-bottom: 0.5rem; color: var(--text); }
	.form-group label small { font-weight: normal; color: var(--muted); font-size: 0.9rem; }
	.form-group input { width: 100%; padding: 0.75rem; font-family: 'VT323', monospace; font-size: 1.1rem; border: 2px solid var(--border); background: var(--bg); color: var(--text); box-sizing: border-box; }
	.form-group input:focus { outline: none; border-color: var(--accent); }
	.form-group small { display: block; margin-top: 0.5rem; color: var(--muted); font-size: 0.95rem; }
	.button-group { display: flex; gap: 1rem; margin-top: 1rem; }
	.retro-button { flex: 1; padding: 1rem 2rem; font-family: 'VT323', monospace; font-size: 1.2rem; border: 3px solid var(--border); cursor: pointer; transition: all 0.2s ease; text-transform: uppercase; font-weight: bold; }
	.chart-container { width: 100%; overflow-x: hidden; border: 3px solid var(--border); background: var(--panel); padding: 1rem; box-shadow: 4px 4px 0 var(--shadow); margin-bottom: 1.5rem; }
	.chart-container h3 { margin: 0 0 1rem 0; font-size: 1.2rem; color: var(--accent); }
	:global(#chart img) { max-width: 100% !important; height: auto !important; display: block !important; }
	:global(#plotlyChart) { min-height: 500px; height: 90vh; }

	@media (max-width: 768px) {
		.tool-header h1 { font-size: 2rem; }
		.tool-subtitle { font-size: 1rem; }
		.button-group { flex-direction: column; }
	}
</style>

<Fragment set:html={`<script type="py" src="/tools/expense-ratio/main.py" config="/tools/expense-ratio/config.json"></script>`} />
