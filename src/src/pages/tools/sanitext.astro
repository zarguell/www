---
import ToolLayout from '../../layouts/ToolLayout.astro';
import Window from '../../components/Window.astro';
---

<ToolLayout title="Sanitext - Privacy-Focused Text Sanitization">
	<div class="sanitext-hero">
		<h1>Sanitext</h1>
		<p class="tagline">Privacy-focused, client-side text sanitization</p>
	</div>

	<!-- Configuration Button -->
	<div class="config-bar">
		<button id="configBtn" class="retro-button retro-button--secondary">Configure Rules</button>
		<button id="importBtn" class="retro-button retro-button--secondary">Import Config</button>
		<button id="exportBtn" class="retro-button retro-button--secondary">Export Config</button>
		<button id="resetBtn" class="retro-button retro-button--outline">Reset to Defaults</button>
	</div>

	<!-- Main Text Areas -->
	<div class="text-areas-container">
		<Window title="Input Text" badgeText="INPUT">
			<div class="section-header">
				<span class="char-count" id="inputCharCount">0 characters</span>
			</div>
			<textarea
				id="inputText"
				class="text-area"
				placeholder="Paste your text here to sanitize..."
				spellcheck="false"
			></textarea>
		</Window>

		<Window title="Sanitized Text" badgeText="OUTPUT">
			<div class="section-header">
				<span class="char-count" id="outputCharCount">0 characters</span>
				<button id="copyBtn" class="retro-button retro-button--primary" disabled>Copy to Clipboard</button>
			</div>
			<textarea
				id="outputText"
				class="text-area"
				readonly
				placeholder="Sanitized text will appear here..."
			></textarea>
		</Window>
	</div>

	<!-- Configuration Modal -->
	<div id="configModal" class="modal hidden" role="dialog" aria-modal="true" aria-labelledby="configModalTitle">
		<div class="modal-content">
			<div class="modal-header">
				<h3 id="configModalTitle">Sanitization Rules Configuration</h3>
				<button class="modal-close" id="closeModal">
					<svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
						<path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/>
					</svg>
				</button>
			</div>

			<div class="modal-body">
				<div class="config-actions">
					<button id="addRuleBtn" class="retro-button retro-button--primary">Add Rule</button>
				</div>

				<div class="rules-container">
					<div class="rules-header">
						<span>Rule Name</span>
						<span>Pattern/Text</span>
						<span>Replacement</span>
						<span>Type</span>
						<span>Category</span>
						<span>Enabled</span>
						<span>Actions</span>
					</div>
					<div id="rulesList" class="rules-list"></div>
				</div>
			</div>
		</div>
	</div>

	<!-- Add/Edit Rule Modal -->
	<div id="ruleModal" class="modal hidden" role="dialog" aria-modal="true" aria-labelledby="ruleModalTitle">
		<div class="modal-content">
			<div class="modal-header">
				<h3 id="ruleModalTitle">Add New Rule</h3>
				<button class="modal-close" id="closeRuleModal">
					<svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
						<path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/>
					</svg>
				</button>
			</div>

			<form id="ruleForm" class="modal-body">
				<div class="form-group">
					<label class="form-label" for="ruleName">Rule Name</label>
					<input type="text" id="ruleName" class="form-control" required>
				</div>

				<div class="form-group">
					<label class="form-label" for="ruleType">Type</label>
					<select id="ruleType" class="form-control" required>
						<option value="string">String Match</option>
						<option value="regex">Regular Expression</option>
					</select>
				</div>

				<div class="form-group">
					<label class="form-label" for="rulePattern">Pattern/Text to Match</label>
					<textarea id="rulePattern" class="form-control" rows="2" required></textarea>
					<small class="form-help">For regex type, enter a valid regular expression. For string type, enter exact text to match.</small>
				</div>

				<div class="form-group">
					<label class="form-label" for="ruleReplacement">Replacement Text</label>
					<input type="text" id="ruleReplacement" class="form-control" required>
				</div>

				<div class="form-group">
					<label class="form-label" for="ruleCategory">Category</label>
					<select id="ruleCategory" class="form-control" required>
						<option value="Personal Information">Personal Information</option>
						<option value="Financial Information">Financial Information</option>
						<option value="Network Information">Network Information</option>
						<option value="Custom Company Rules">Custom Company Rules</option>
					</select>
				</div>

				<div class="checkbox-group">
					<label class="checkbox-label">
						<input type="checkbox" id="ruleEnabled" checked>
						<span class="checkmark"></span>
						Enable this rule
					</label>
				</div>

				<div class="form-actions">
					<button type="button" class="retro-button retro-button--outline" id="cancelRuleBtn">Cancel</button>
					<button type="submit" class="retro-button retro-button--primary" id="saveRuleBtn">Save Rule</button>
				</div>
			</form>
		</div>
	</div>

	<!-- Toast Notifications -->
	<div id="toast" class="toast hidden" role="status" aria-live="polite">
		<span id="toastMessage"></span>
		<button class="toast-close" id="toastClose" aria-label="Dismiss notification">×</button>
	</div>

	<input type="file" id="importFile" accept=".json" style="display: none;">

	<div class="privacy-notice">
		<p>100% Client-Side Processing - Your text never leaves your browser</p>
	</div>
</ToolLayout>

<style>
	.sanitext-hero {
		text-align: center;
		padding: 2rem 0;
		margin-bottom: 2rem;
	}

	.sanitext-hero h1 {
		font-size: 3rem;
		margin: 0 0 0.5rem 0;
		color: var(--accent);
	}

	.tagline {
		font-size: 1.3rem;
		color: var(--muted);
		margin: 0;
	}

	.config-bar {
		display: flex;
		gap: 1rem;
		flex-wrap: wrap;
		margin-bottom: 2rem;
		justify-content: center;
	}

	.text-areas-container {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 2rem;
		margin-bottom: 2rem;
	}

	.section-header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-bottom: 1rem;
	}

	.char-count {
		font-family: 'VT323', monospace;
		font-size: 1.1rem;
		color: var(--muted);
	}

	.text-area {
		width: 100%;
		min-height: 400px;
		padding: 1rem;
		font-family: 'VT323', monospace;
		font-size: 1.2rem;
		line-height: 1.6;
		background: var(--bg);
		border: 2px solid var(--border);
		border-radius: 4px;
		color: var(--text);
		resize: vertical;
	}

	.text-area:focus {
		outline: 3px solid var(--focus);
		outline-offset: 2px;
		border-color: var(--accent);
	}

	.text-area[readonly] {
		background: var(--bg2);
	}

	/* Modal Styles */
	.modal {
		position: fixed;
		inset: 0;
		background: rgba(0, 0, 0, 0.8);
		display: flex;
		align-items: center;
		justify-content: center;
		z-index: 1000;
		padding: 2rem;
	}

	.modal.hidden {
		display: none;
	}

	.modal-content {
		background: var(--panel);
		border: 3px solid var(--border);
		border-radius: 8px;
		box-shadow: 6px 6px 0 var(--shadow);
		max-width: 900px;
		width: 100%;
		max-height: 90vh;
		overflow: hidden;
		display: flex;
		flex-direction: column;
	}

	.modal-header {
		background: linear-gradient(180deg, var(--bevel-light), var(--bevel-dark));
		border-bottom: 2px solid var(--border);
		padding: 1rem 1.5rem;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
	}

	.modal-header h3 {
		margin: 0;
		font-size: 1.5rem;
		color: var(--text);
	}

	.modal-close {
		background: none;
		border: none;
		cursor: pointer;
		padding: 0.5rem;
		color: var(--text);
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.modal-close:hover {
		color: var(--accent);
	}

	.modal-body {
		padding: 1.5rem;
		overflow-y: auto;
		flex: 1;
	}

	.config-actions {
		display: flex;
		gap: 1rem;
		margin-bottom: 1.5rem;
		flex-wrap: wrap;
	}

	.rules-container {
		border: 2px solid var(--border);
		border-radius: 4px;
		overflow: hidden;
	}

	:global(.rules-header) {
		display: grid;
		grid-template-columns: 1.5fr 2fr 1.5fr 1fr 1.5fr 1fr 1fr;
		gap: 0.5rem;
		padding: 0.75rem 1rem;
		background: var(--bg2);
		border-bottom: 2px solid var(--border);
		font-family: 'VT323', monospace;
		font-size: 1.1rem;
		font-weight: bold;
		color: var(--text);
	}

	.rules-list {
		max-height: 400px;
		overflow-y: auto;
	}

	:global(.rule-item) {
		display: grid;
		grid-template-columns: 1.5fr 2fr 1.5fr 1fr 1.5fr 1fr 1fr;
		gap: 0.5rem;
		padding: 0.75rem 1rem;
		border-bottom: 1px solid var(--border);
		align-items: center;
		font-family: 'VT323', monospace;
		font-size: 1rem;
	}

	:global(.rule-item:last-child) {
		border-bottom: none;
	}

	:global(.rule-name) {
		font-weight: bold;
		color: var(--text);
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	:global(.rule-pattern),
	:global(.rule-replacement) {
		color: var(--muted);
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	:global(.rule-type),
	:global(.rule-category) {
		color: var(--text);
		font-size: 0.9rem;
	}

	:global(.rule-actions) {
		display: flex;
		gap: 0.5rem;
	}

	.rule-action-btn {
		background: none;
		border: 2px solid var(--border);
		border-radius: 4px;
		cursor: pointer;
		padding: 0.25rem 0.5rem;
		color: var(--text);
		display: flex;
		align-items: center;
		justify-content: center;
		transition: all 0.2s ease;
	}

	.rule-action-btn:hover {
		background: var(--accent);
		color: var(--sticker-text);
	}

	.rule-action-btn.delete:hover {
		background: #ff4444;
		color: #ffffff;
	}

	/* Toggle Switch */
	.toggle {
		position: relative;
		display: inline-block;
		width: 50px;
		height: 24px;
	}

	.toggle input {
		opacity: 0;
		width: 0;
		height: 0;
	}

	.toggle-slider {
		position: absolute;
		cursor: pointer;
		inset: 0;
		background-color: var(--bg2);
		transition: 0.3s;
		border: 2px solid var(--border);
		border-radius: 24px;
	}

	.toggle-slider:before {
		position: absolute;
		content: "";
		height: 16px;
		width: 16px;
		left: 2px;
		bottom: 2px;
		background-color: var(--text);
		transition: 0.3s;
		border-radius: 50%;
	}

	.toggle input:checked + .toggle-slider {
		background-color: var(--accent);
		border-color: var(--accent);
	}

	.toggle input:checked + .toggle-slider:before {
		transform: translateX(26px);
		background-color: var(--sticker-text);
	}

	/* Form Styles */
	.form-group {
		margin-bottom: 1.25rem;
	}

	.form-label {
		display: block;
		font-family: 'VT323', monospace;
		font-size: 1.2rem;
		font-weight: bold;
		color: var(--text);
		margin-bottom: 0.5rem;
	}

	.form-control {
		width: 100%;
		padding: 0.6em 0.8em;
		font-family: 'VT323', monospace;
		font-size: 1.1rem;
		background: var(--bg);
		border: 2px solid var(--border);
		border-radius: 4px;
		color: var(--text);
		transition: all 0.2s ease;
	}

	.form-control:focus {
		outline: none;
		border-color: var(--accent);
		box-shadow: 0 0 0 3px var(--focus);
	}

	.form-help {
		display: block;
		font-family: 'VT323', monospace;
		font-size: 1rem;
		color: var(--muted);
		margin-top: 0.5rem;
	}

	.checkbox-group {
		margin-bottom: 1.25rem;
	}

	.checkbox-label {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		cursor: pointer;
		font-family: 'VT323', monospace;
		font-size: 1.2rem;
		color: var(--text);
	}

	.checkbox-label input[type="checkbox"] {
		width: 20px;
		height: 20px;
		cursor: pointer;
	}

	.form-actions {
		display: flex;
		gap: 1rem;
		justify-content: flex-end;
		margin-top: 1.5rem;
	}

	/* Toast Notifications */
	.toast {
		position: fixed;
		bottom: 2rem;
		right: 2rem;
		padding: 1rem 1.5rem;
		background: var(--panel);
		border: 3px solid var(--border);
		border-radius: 4px;
		box-shadow: 6px 6px 0 var(--shadow);
		font-family: 'VT323', monospace;
		font-size: 1.2rem;
		color: var(--text);
		display: flex;
		align-items: center;
		gap: 1rem;
		z-index: 1001;
		min-width: 300px;
	}

	.toast.hidden {
		display: none;
	}

	.toast.success {
		border-color: #00cc00;
		background: var(--bg2);
	}

	.toast.error {
		border-color: #ff4444;
		background: var(--bg2);
	}

	.toast-close {
		background: none;
		border: none;
		font-size: 2rem;
		color: var(--text);
		cursor: pointer;
		padding: 0;
		line-height: 1;
	}

	.toast-close:hover {
		color: var(--accent);
	}

	.privacy-notice {
		text-align: center;
		padding: 2rem;
		margin-top: 2rem;
		font-family: 'VT323', monospace;
		font-size: 1.2rem;
		color: var(--muted);
		border-top: 2px solid var(--border);
	}

	@media (max-width: 1024px) {
		.text-areas-container {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 768px) {
		.sanitext-hero h1 {
			font-size: 2.5rem;
		}

		.config-bar {
			flex-direction: column;
		}

		.toast {
			right: 1rem;
			left: 1rem;
			bottom: 1rem;
		}
	}

	/* Only stack rules on very small screens (< 600px) */
	@media (max-width: 600px) {
		.rules-header,
		.rule-item {
			grid-template-columns: 1fr;
			gap: 0.25rem;
		}
	}
</style>

<script>
	import { initSanitextApp } from '../../scripts/sanitext-app';

	document.addEventListener('DOMContentLoaded', () => initSanitextApp());
</script>
