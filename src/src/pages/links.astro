---
import BaseLayout from '../layouts/BaseLayout.astro';
import Window from '../components/Window.astro';
import RetroButton from '../components/RetroButton.astro';
import Badge from '../components/Badge.astro';
import CoolFindCard from '../components/CoolFindCard.astro';
import { linksData, coolFindsData, extractDomain } from '../data/links';

// Add domain to cool finds data
const coolFindsWithDomains = coolFindsData.map((find) => ({
	...find,
	domain: extractDomain(find.url),
}));
---

<BaseLayout title="Links - ARGUELLES.ME">
	<div class="links-hero">
		<h1>Links</h1>
		<p class="links-subtitle">Curated corners of the internet</p>
	</div>

	<div class="links-grid">
		{linksData.map((category) => (
			<Window title={category.name}>
				<div class="link-list">
					{category.links.map((link) => (
						<div class="link-item">
							<RetroButton href={link.url} variant="secondary" target="_blank">
								{link.title}
							</RetroButton>
							<p class="link-description">{link.description}</p>
						</div>
					))}
				</div>
			</Window>
		))}
	</div>

	<div class="cool-finds-section">
		<h2 class="section-title">Cool Finds</h2>

		{coolFindsWithDomains.length === 0 ? (
			<div class="no-results">
				<p>Cool finds coming soon!</p>
			</div>
		) : (
			<>
				<div class="cool-finds-header">
					<div class="search-container">
						<label for="cool-finds-search" class="visually-hidden">Search cool finds</label>
						<input
							type="text"
							id="cool-finds-search"
							class="search-input"
							placeholder="Search by title, description, or domain..."
							aria-label="Search cool finds"
						/>
					</div>
					<div class="tags-container" id="tags-container">
						<!-- Tag chips will be inserted here by JavaScript -->
					</div>
				</div>

				<div class="cool-finds-grid" id="cool-finds-grid">
					{coolFindsWithDomains.map((find) => (
						<CoolFindCard
							title={find.title}
							url={find.url}
							description={find.description}
							date={find.date}
							tags={find.tags}
							domain={find.domain}
						/>
					))}
				</div>

				<div class="no-results" id="no-results" hidden>
					<p>No cool finds match your filters.</p>
					<RetroButton id="clear-filters" variant="secondary">Clear filters</RetroButton>
				</div>
			</>
		)}
	</div>

	<Window title="Submit a Link" badgeText="OPEN">
		<div class="prose">
			<p>
				Know a cool corner of the web? <a href="http://github.com/zarguell/www/issues">Open an issue on Github</a> with your suggestion.
			</p>
		</div>
	</Window>
</BaseLayout>

<script>
	// Get all cool finds data from the rendered cards
	const coolFindsGrid = document.getElementById('cool-finds-grid');
	const searchInput = document.getElementById('cool-finds-search');
	const tagsContainer = document.getElementById('tags-container');
	const noResults = document.getElementById('no-results');
	const clearFiltersBtn = document.getElementById('clear-filters');

	// Ensure all required elements exist
	if (!coolFindsGrid || !searchInput || !tagsContainer || !noResults || !clearFiltersBtn) {
		console.error('Required DOM elements not found for cool finds filtering');
	} else {
		// Extract cool finds data from the DOM
	function getCoolFindsData() {
		const cards = Array.from(coolFindsGrid.children);
		return cards.map(card => ({
			element: card,
			title: card.querySelector('.card-title')?.textContent.toLowerCase() || '',
			description: card.querySelector('.card-description')?.textContent.toLowerCase() || '',
			domain: card.querySelector('.domain-badge')?.textContent.toLowerCase() || '',
			tags: Array.from(card.querySelectorAll('.tag')).map(tag => tag.dataset.tag || '')
		}));
	}

	// Get all unique tags from the dataset
	function getAllTags(data) {
		const tagSet = new Set();
		data.forEach(item => {
			item.tags.forEach(tag => tagSet.add(tag));
		});
		return Array.from(tagSet).sort();
	}

	// Create tag chips
	function renderTagChips(tags) {
		tagsContainer.innerHTML = '';
		tags.forEach(tag => {
			const button = document.createElement('button');
			button.className = 'tag-chip';
			button.textContent = tag;
			button.setAttribute('aria-pressed', 'false');
			button.addEventListener('click', () => toggleTag(tag, button));
			tagsContainer.appendChild(button);
		});
	}

	// Toggle tag filter
	let activeTag = null;
	function toggleTag(tag, button) {
		const buttons = tagsContainer.querySelectorAll('.tag-chip');

		if (activeTag === tag) {
			// Deselect
			activeTag = null;
			button.setAttribute('aria-pressed', 'false');
			button.classList.remove('active');
		} else {
			// Select new tag
			activeTag = tag;
			buttons.forEach(btn => {
				btn.setAttribute('aria-pressed', 'false');
				btn.classList.remove('active');
			});
			button.setAttribute('aria-pressed', 'true');
			button.classList.add('active');
		}

		applyFilters();
		updateURL();
	}

	// Apply filters to the grid
	function applyFilters() {
		const data = getCoolFindsData();
		const searchText = searchInput.value.toLowerCase().trim();

		let visibleCount = 0;

		data.forEach(item => {
			const matchesSearch =
				searchText === '' ||
				item.title.includes(searchText) ||
				item.description.includes(searchText) ||
				item.domain.includes(searchText);

			const matchesTag = activeTag === null || item.tags.includes(activeTag);

			if (matchesSearch && matchesTag) {
				item.element.hidden = false;
				visibleCount++;
			} else {
				item.element.hidden = true;
			}
		});

		// Show/hide no results message
		noResults.hidden = visibleCount > 0;
	}

	// Update URL params
	function updateURL() {
		const params = new URLSearchParams();

		const searchValue = searchInput.value.trim();
		if (searchValue) {
			params.set('q', searchValue);
		}

		if (activeTag) {
			params.set('tag', activeTag);
		}

		const newURL = params.toString() ? `?${params.toString()}` : window.location.pathname;
		window.history.replaceState({}, '', newURL);
	}

	// Restore state from URL
	function restoreFromURL() {
		const params = new URLSearchParams(window.location.search);
		const searchQuery = params.get('q') || '';
		const tagParam = params.get('tag');

		searchInput.value = searchQuery;

		if (tagParam) {
			const tagButton = Array.from(tagsContainer.querySelectorAll('.tag-chip'))
				.find(btn => btn.textContent === tagParam);
			if (tagButton) {
				toggleTag(tagParam, tagButton);
			}
		}

		applyFilters();
	}

	// Clear all filters
	clearFiltersBtn.addEventListener('click', () => {
		searchInput.value = '';
		activeTag = null;
		document.querySelectorAll('.tag-chip').forEach(btn => {
			btn.setAttribute('aria-pressed', 'false');
			btn.classList.remove('active');
		});
		applyFilters();
		updateURL();
	});

	// Search input listener
	searchInput.addEventListener('input', () => {
		applyFilters();
		updateURL();
	});

	// Initialize
	const coolFindsData = getCoolFindsData();
	const allTags = getAllTags(coolFindsData);
	renderTagChips(allTags);

	// Wait for DOM to be ready before restoring from URL
	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', restoreFromURL);
	} else {
		restoreFromURL();
	}
	}
</script>

<style>
	.links-hero {
		text-align: center;
		padding: 2rem 0;
	}

	.links-hero h1 {
		font-size: 3rem;
		margin: 0 0 0.5rem 0;
	}

	.links-subtitle {
		font-size: 1.3rem;
		color: var(--muted);
		margin: 0;
	}

	.links-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
		gap: 2rem;
		margin-bottom: 2rem;
	}

	.link-list {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}

	.link-item {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	.link-description {
		margin: 0;
		font-size: 1rem;
		color: var(--muted);
		line-height: 1.4;
	}

	@media (max-width: 768px) {
		.links-grid {
			grid-template-columns: 1fr;
		}

		.links-hero h1 {
			font-size: 2.5rem;
		}
	}

	/* Cool Finds Section */
	.cool-finds-section {
		margin-top: 4rem;
		margin-bottom: 2rem;
	}

	.section-title {
		font-size: 2rem;
		margin-bottom: 1.5rem;
		text-align: center;
	}

	/* Sticky Header */
	.cool-finds-header {
		position: sticky;
		top: 1rem;
		z-index: 100;
		background: var(--bg);
		padding: 1rem;
		border: 2px solid var(--border);
		border-radius: 8px;
		margin-bottom: 2rem;
		display: flex;
		flex-direction: column;
		gap: 1rem;
		box-shadow: 0 4px 0 var(--shadow);
	}

	/* Search Input */
	.search-container {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	.search-input {
		width: 100%;
		padding: 0.75rem 1rem;
		font-family: "VT323", monospace;
		font-size: 1.1rem;
		background: var(--bg2);
		border: 2px solid var(--border);
		border-radius: 4px;
		color: var(--text);
		outline: none;
		transition: border-color 0.2s ease;
	}

	.search-input:focus {
		border-color: var(--focus);
		outline: 2px solid var(--focus);
		outline-offset: 2px;
	}

	/* Visually hidden for accessibility */
	.visually-hidden {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	/* Tag Chips Container */
	.tags-container {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		overflow-x: auto;
	}

	.tag-chip {
		padding: 0.375rem 0.75rem;
		font-family: "VT323", monospace;
		font-size: 1rem;
		background: var(--bg2);
		border: 1px solid var(--border);
		border-radius: 4px;
		color: var(--text);
		cursor: pointer;
		transition: all 0.2s ease;
		box-shadow: 1px 1px 0 var(--shadow);
		position: relative;
	}

	.tag-chip:hover {
		border-color: var(--accent);
		background: var(--border);
		transform: translate(0.5px, 0.5px);
		box-shadow: 0.5px 0.5px 0 var(--shadow);
	}

	.tag-chip:focus {
		outline: 2px solid var(--focus);
		outline-offset: 2px;
	}

	.tag-chip.active {
		background: var(--accent);
		border-color: var(--accent);
		color: var(--sticker-text);
		box-shadow: 0 0 0 var(--shadow);
		transform: translate(1px, 1px);
	}

	/* Cool Finds Grid */
	.cool-finds-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
		gap: 1.5rem;
	}

	/* No Results Message */
	.no-results {
		text-align: center;
		padding: 3rem;
		border: 2px dashed var(--border);
		border-radius: 8px;
	}

	.no-results p {
		font-size: 1.2rem;
		color: var(--muted);
		margin: 0 0 1rem 0;
	}

	/* Responsive for Cool Finds */
	@media (max-width: 768px) {
		.cool-finds-header {
			top: 0.5rem;
		}

		.cool-finds-grid {
			grid-template-columns: 1fr;
		}

		.section-title {
			font-size: 1.5rem;
		}

		.tags-container {
			flex-wrap: nowrap;
			overflow-x: auto;
			scroll-snap-type: x mandatory;
		}

		.tag-chip {
			scroll-snap-align: start;
			flex-shrink: 0;
		}
	}
</style>
