---
import BaseLayout from '../layouts/BaseLayout.astro';
import Window from '../components/Window.astro';
import RetroButton from '../components/RetroButton.astro';
import Badge from '../components/Badge.astro';
import CoolFindCard from '../components/CoolFindCard.astro';
import { linksData, coolFindsData, extractDomain } from '../data/links';

// Add domain to cool finds data
const coolFindsWithDomains = coolFindsData.map((find) => ({
	...find,
	domain: extractDomain(find.url),
}));
---

<BaseLayout title="Links - ARGUELLES.ME">
	<div class="links-hero">
		<h1>Links</h1>
		<p class="links-subtitle">Curated corners of the internet</p>
	</div>

	<div class="links-grid">
		{linksData.map((category) => (
			<Window title={category.name}>
				<div class="link-list">
					{category.links.map((link) => (
						<a class="link-card" href={link.url} target="_blank" rel="noopener noreferrer">
							<span class="link-card__title">
								{link.title}
								<span class="link-card__arrow" aria-hidden="true">↗</span>
							</span>
							<span class="link-card__description">{link.description}</span>
						</a>
					))}
				</div>
			</Window>
		))}
	</div>

	<div class="cool-finds-section">
		<h2 class="section-title">Cool Finds</h2>

		{coolFindsWithDomains.length === 0 ? (
			<div class="no-results">
				<p>Cool finds coming soon!</p>
			</div>
		) : (
			<>
				<div class="cool-finds-header">
					<div class="search-container">
						<label for="cool-finds-search" class="visually-hidden">Search cool finds</label>
						<input
							type="text"
							id="cool-finds-search"
							class="search-input"
							placeholder="Search by title, description, or domain..."
							aria-label="Search cool finds"
						/>
					</div>
					<div class="tags-container" id="tags-container">
						<!-- Tag chips will be inserted here by JavaScript -->
					</div>
				</div>

				<div class="cool-finds-grid" id="cool-finds-grid">
					{coolFindsWithDomains.map((find) => (
						<CoolFindCard
							title={find.title}
							url={find.url}
							description={find.description}
							date={find.date}
							tags={find.tags}
							domain={find.domain}
						/>
					))}
				</div>

				<div class="no-results" id="no-results" hidden>
					<p>No cool finds match your filters.</p>
					<RetroButton id="clear-filters" variant="secondary">Clear filters</RetroButton>
				</div>
			</>
		)}
	</div>

	<Window title="Submit a Link" badgeText="OPEN">
		<div class="prose">
			<p>
				Know a cool corner of the web? <a href="http://github.com/zarguell/www/issues">Open an issue on Github</a> with your suggestion.
			</p>
		</div>
	</Window>
</BaseLayout>

<script>
	// Get all cool finds data from the rendered cards
	const coolFindsGrid = document.getElementById('cool-finds-grid') as HTMLElement;
	const searchInput = document.getElementById('cool-finds-search') as HTMLInputElement;
	const tagsContainer = document.getElementById('tags-container') as HTMLElement;
	const noResults = document.getElementById('no-results') as HTMLElement;
	const clearFiltersBtn = document.getElementById('clear-filters');

	// Ensure all required elements exist
		if (!coolFindsGrid || !searchInput || !tagsContainer || !noResults || !clearFiltersBtn) {
			console.error('Required DOM elements not found for cool finds filtering');
		} else {
			// Extract cool finds data from the DOM
		function getCoolFindsData() {
			const cards = Array.from(coolFindsGrid.children) as HTMLElement[];
			return cards.map(card => ({
				element: card,
				title: card.querySelector<HTMLElement>('.card-title')?.textContent.toLowerCase() || '',
				description: card.querySelector<HTMLElement>('.card-description')?.textContent.toLowerCase() || '',
				domain: card.querySelector<HTMLElement>('.domain-badge')?.textContent.toLowerCase() || '',
				tags: Array.from(card.querySelectorAll<HTMLElement>('.tag')).map((tag) => tag.dataset.tag || '')
			}));
		}

		// Get all unique tags from the dataset
		function getAllTags(data: Array<{ tags: string[] }>): string[] {
			const tagSet = new Set<string>();
			data.forEach((item: { tags: string[] }) => {
				item.tags.forEach((tag: string) => tagSet.add(tag));
			});
			return Array.from(tagSet).sort();
		}

		// Create tag chips
		function renderTagChips(tags: string[]): void {
			tagsContainer.innerHTML = '';
			tags.forEach(tag => {
				const button = document.createElement('button');
				button.className = 'tag-chip';
				button.textContent = tag;
				button.setAttribute('aria-pressed', 'false');
				button.addEventListener('click', () => toggleTag(tag, button));
				tagsContainer.appendChild(button);
			});
		}

		// Toggle tag filter
		let activeTag: string | null = null;
		function toggleTag(tag: string, button: HTMLElement): void {
			const buttons = tagsContainer.querySelectorAll('.tag-chip');

			if (activeTag === tag) {
				// Deselect
				activeTag = null;
				button.setAttribute('aria-pressed', 'false');
				button.classList.remove('active');
			} else {
				// Select new tag
				activeTag = tag;
				buttons.forEach(btn => {
					btn.setAttribute('aria-pressed', 'false');
					btn.classList.remove('active');
				});
				button.setAttribute('aria-pressed', 'true');
				button.classList.add('active');
			}

			applyFilters();
			updateURL();
		}

		// Apply filters to the grid
		function applyFilters() {
			const data = getCoolFindsData();
			const searchText = searchInput.value.toLowerCase().trim();

			let visibleCount = 0;

			data.forEach(item => {
				const matchesSearch =
					searchText === '' ||
					item.title.includes(searchText) ||
					item.description.includes(searchText) ||
					item.domain.includes(searchText);

				const matchesTag = activeTag === null || item.tags.includes(activeTag);

				if (matchesSearch && matchesTag) {
					item.element.hidden = false;
					visibleCount++;
				} else {
					item.element.hidden = true;
				}
			});

			// Show/hide no results message
			noResults.hidden = visibleCount > 0;
		}

		// Update URL params
		function updateURL() {
			const params = new URLSearchParams();

			const searchValue = searchInput.value.trim();
			if (searchValue) {
				params.set('q', searchValue);
			}

			if (activeTag) {
				params.set('tag', activeTag);
			}

			const newURL = params.toString() ? `?${params.toString()}` : window.location.pathname;
			window.history.replaceState({}, '', newURL);
		}

		// Restore state from URL
		function restoreFromURL() {
			const params = new URLSearchParams(window.location.search);
			const searchQuery = params.get('q') || '';
			const tagParam = params.get('tag');

			searchInput.value = searchQuery;

			if (tagParam) {
				const tagButton = Array.from(tagsContainer.querySelectorAll<HTMLElement>('.tag-chip'))
					.find(btn => btn.textContent === tagParam);
				if (tagButton) {
					toggleTag(tagParam, tagButton);
				}
			}

			applyFilters();
		}

		// Clear all filters
		clearFiltersBtn.addEventListener('click', () => {
			searchInput.value = '';
			activeTag = null;
			document.querySelectorAll('.tag-chip').forEach(btn => {
				btn.setAttribute('aria-pressed', 'false');
				btn.classList.remove('active');
			});
			applyFilters();
			updateURL();
		});

		// Search input listener
		searchInput.addEventListener('input', () => {
			applyFilters();
			updateURL();
		});

		// Initialize
		const coolFindsData = getCoolFindsData();
		const allTags = getAllTags(coolFindsData);
		renderTagChips(allTags);

		// Wait for DOM to be ready before restoring from URL
		if (document.readyState === 'loading') {
			document.addEventListener('DOMContentLoaded', restoreFromURL);
		} else {
			restoreFromURL();
		}
		}
	</script>

	<style>
	.links-hero {
		text-align: center;
		padding: 2rem 0;
	}

	.links-hero h1 {
		font-size: 3rem;
		margin: 0 0 0.5rem 0;
	}

	.links-subtitle {
		font-size: 1.3rem;
		color: var(--muted);
		margin: 0;
	}

	.links-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
		gap: 2rem;
		margin-bottom: 2rem;
	}

	.link-list {
		display: flex;
		flex-direction: column;
		gap: 0.875rem;
	}

	.link-card {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		padding: 0.875rem 1rem;
		background: var(--bg2);
		border: 2px solid var(--border);
		border-radius: 6px;
		box-shadow: 3px 3px 0 var(--shadow);
		text-decoration: none;
		transition: all 0.1s ease;
	}

	.link-card:hover {
		transform: translate(1px, 1px);
		box-shadow: 2px 2px 0 var(--shadow);
		border-color: var(--accent);
	}

	.link-card:focus-visible {
		outline: 3px solid var(--focus);
		outline-offset: 2px;
	}

	.link-card__title {
		font-family: var(--font-display);
		font-size: 1.375rem;
		color: var(--text);
		display: flex;
		align-items: baseline;
		gap: 0.4em;
	}

	.link-card:hover .link-card__title,
	.link-card:hover .link-card__arrow {
		color: var(--accent);
	}

	.link-card__arrow {
		font-size: 0.85em;
		color: var(--muted);
		transition: color 0.15s ease;
	}

	.link-card__description {
		font-size: 0.925rem;
		color: var(--muted);
		line-height: 1.45;
	}

	@media (max-width: 768px) {
		.links-grid {
			grid-template-columns: 1fr;
		}

		.links-hero h1 {
			font-size: 2.5rem;
		}
	}

	/* Cool Finds Section */
	.cool-finds-section {
		margin-top: 4rem;
		margin-bottom: 2rem;
	}

	.section-title {
		font-size: 2rem;
		margin-bottom: 1.5rem;
		text-align: center;
	}

	/* Sticky Header */
	.cool-finds-header {
		position: sticky;
		top: 1rem;
		z-index: 100;
		background: var(--bg);
		padding: 1rem;
		border: 2px solid var(--border);
		border-radius: 8px;
		margin-bottom: 2rem;
		display: flex;
		flex-direction: column;
		gap: 1rem;
		box-shadow: 0 4px 0 var(--shadow);
	}

	/* Search Input */
	.search-container {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	.search-input {
		width: 100%;
		padding: 0.75rem 1rem;
		font-family: var(--font-display);
		font-size: 1.1rem;
		background: var(--bg2);
		border: 2px solid var(--border);
		border-radius: 4px;
		color: var(--text);
		outline: none;
		transition: border-color 0.2s ease;
	}

	.search-input:focus {
		border-color: var(--focus);
		outline: 2px solid var(--focus);
		outline-offset: 2px;
	}

	/* Visually hidden for accessibility */
	.visually-hidden {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	/* Tag Chips Container */
	.tags-container {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		overflow-x: auto;
	}

	/* Cool Finds Grid */
	.cool-finds-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
		gap: 1.5rem;
	}

	/* No Results Message */
	.no-results {
		text-align: center;
		padding: 3rem;
		border: 2px dashed var(--border);
		border-radius: 8px;
	}

	.no-results p {
		font-size: 1.2rem;
		color: var(--muted);
		margin: 0 0 1rem 0;
	}

	/* Responsive for Cool Finds */
	@media (max-width: 768px) {
		.cool-finds-header {
			top: 0.5rem;
		}

		.cool-finds-grid {
			grid-template-columns: 1fr;
		}

		.section-title {
			font-size: 1.5rem;
		}

		.tags-container {
			flex-wrap: nowrap;
			overflow-x: auto;
			scroll-snap-type: x mandatory;
		}
	}
</style>

<style is:global>
	/* Tag filter chips are created by the page script at runtime, so these
	   selectors must be global — Astro scoped styles can't reach them.
	   Lives here instead of global.css because only this page renders chips. */
	.tag-chip {
		padding: 0.375rem 0.75rem;
		font-family: var(--font-display);
		font-size: 1.1rem;
		background: var(--bg2);
		border: 1px solid var(--border);
		border-radius: 4px;
		color: var(--text);
		cursor: pointer;
		transition: all 0.2s ease;
		box-shadow: 1px 1px 0 var(--shadow);
		position: relative;
	}

	.tag-chip:hover {
		border-color: var(--accent);
		background: var(--border);
		transform: translate(0.5px, 0.5px);
		box-shadow: 0.5px 0.5px 0 var(--shadow);
	}

	.tag-chip:focus {
		outline: 2px solid var(--focus);
		outline-offset: 2px;
	}

	.tag-chip.active {
		background: var(--accent);
		border-color: var(--accent);
		color: var(--sticker-text);
		box-shadow: 0 0 0 var(--shadow);
		transform: translate(1px, 1px);
	}

	@media (max-width: 768px) {
		.tag-chip {
			scroll-snap-align: start;
			flex-shrink: 0;
		}
	}
</style>
