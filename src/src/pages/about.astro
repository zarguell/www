---
import BaseLayout from '../layouts/BaseLayout.astro';
import Window from '../components/Window.astro';
import Badge from '../components/Badge.astro';
---

<BaseLayout title="About - Retro.SITE">
	<div class="about-hero">
		<h1>About</h1>
		<Badge text="WHO AM I?" variant="accent" />
	</div>

	<Window title="Bio">
		<div class="prose">
			<p>
				Cybersecurity engineer and habitual tinkerer. Interests include static sites, PyScript, Cloudflare Workers, Ansible, Docker, and whatever I’m learning this week.
			</p>
		</div>
	</Window>

	<Window title="Colophon" badgeText="NERD STUFF">
		<div class="prose">
			<h3>How This Site Is Built</h3>
			<ul>
				<li><strong>Generator:</strong> <a href="https://astro.build/" target="_blank">Astro</a> v5 (static)</li>
				<li><strong>Font:</strong> VT323 via Google Fonts</li>
				<li><strong>Styling:</strong> Custom CSS with design tokens (no frameworks)</li>
				<li><strong>Hosting:</strong> Static (Netlify-ready)</li>
				<li><strong>Features:</strong> Theme toggle, content collections, zero JS bloat</li>
				<li><strong>Philosophy:</strong> Minimal dependencies, maximal aesthetics</li>
			</ul>
		</div>
	</Window>
</BaseLayout>

<style>
	.about-hero {
		text-align: center;
		padding: 2rem 0;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1rem;
	}

	.about-hero h1 {
		font-size: 3rem;
		margin: 0;
	}
</style>
