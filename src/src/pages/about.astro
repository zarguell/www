---
import BaseLayout from '../layouts/BaseLayout.astro';
import Window from '../components/Window.astro';
import Badge from '../components/Badge.astro';
---

<BaseLayout title="About - Retro.SITE">
	<div class="about-hero">
		<h1>About</h1>
		<Badge text="WHO AM I?" variant="accent" />
	</div>

	<Window title="Bio">
		<div class="prose">
			<p>
				Hi! I'm a digital creator exploring the intersection of <strong>fashion</strong>, <strong>coding</strong>, and <strong>retro aesthetics</strong>. This site is my experimental playground where 90s web nostalgia meets modern static site architecture.
			</p>
			<p>
				I believe the web was more fun when it was weird, personal, and broken in interesting ways. This site is my attempt to recapture some of that energy — beveled borders, neon colors, and unapologetic maximalism included.
			</p>
		</div>
	</Window>

	<Window title="Now" badgeText="CURRENT">
		<div class="prose">
			<h3>What I'm Into Lately</h3>
			<ul>
				<li><strong>Fashion:</strong> Cargo pants, oversized tees, and cyber accessories</li>
				<li><strong>Tech:</strong> Building tiny tools that feel like toys</li>
				<li><strong>Creative:</strong> Writing at the intersection of style and substance</li>
				<li><strong>Design:</strong> JPEG artifacts as intentional texture</li>
			</ul>
		</div>
	</Window>

	<Window title="Style Influences">
		<div class="prose">
			<h3>Aesthetic Inspirations</h3>
			<ul>
				<li><strong>90s Personal Pages:</strong> GeoCities, Angelfire, the raw unpolished web</li>
				<li><strong>Fashion:</strong> Jean Paul Gaultier, Comme des Garçons, archival runway looks</li>
				<li><strong>Digital Art:</strong> Early web graphics, pixel art, glitch aesthetics</li>
				<li><strong>Design:</strong> Brutalism, maximalism, things that are "so bad they're good"</li>
			</ul>
		</div>
	</Window>

	<Window title="Colophon" badgeText="NERD STUFF">
		<div class="prose">
			<h3>How This Site Is Built</h3>
			<ul>
				<li><strong>Generator:</strong> <a href="https://astro.build/" target="_blank">Astro</a> v5 (static)</li>
				<li><strong>Font:</strong> VT323 via Google Fonts</li>
				<li><strong>Styling:</strong> Custom CSS with design tokens (no frameworks)</li>
				<li><strong>Hosting:</strong> Static (Netlify-ready)</li>
				<li><strong>Features:</strong> Theme toggle, content collections, zero JS bloat</li>
				<li><strong>Philosophy:</strong> Minimal dependencies, maximal aesthetics</li>
			</ul>
		</div>
	</Window>
</BaseLayout>

<style>
	.about-hero {
		text-align: center;
		padding: 2rem 0;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1rem;
	}

	.about-hero h1 {
		font-size: 3rem;
		margin: 0;
	}
</style>
