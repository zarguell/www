---
/**
 * Retro AIM Chat Window Component
 * A nostalgic AIM-style chat window with functional messaging
 * Can be minimized and positioned anywhere on the page
 */

const buddyName = 'zachisawesome';
const buddyStatus = 'away';
const myStatus = 'available';
---

<div class="aim-chat-window" id="aimChatWindow" style="display: none">
	<!-- Title Bar -->
	<div class="aim-title-bar" id="aimTitleBar">
		<div class="aim-title-left">
			<span class="aim-icon">😊</span>
			<span class="aim-buddy-name">{buddyName}</span>
		</div>
		<div class="aim-title-controls">
			<button class="aim-control-btn minimize-btn" id="minimizeBtn" aria-label="Minimize">_</button>
			<button class="aim-control-btn maximize-btn" id="maximizeBtn" aria-label="Maximize">□</button>
			<button class="aim-control-btn close-btn" id="closeBtn" aria-label="Close">×</button>
		</div>
	</div>

	<!-- Menu Bar -->
	<div class="aim-menu-bar">
		<div class="aim-menu-dropdown">
			<button class="aim-menu-item" data-menu="file" aria-haspopup="true" aria-expanded="false">File ▼</button>
			<div class="aim-dropdown-menu" id="fileMenu" role="menu">
				<button type="button" class="aim-dropdown-item">Save Chat...</button>
				<button type="button" class="aim-dropdown-item" id="clearChatItem">Clear Chat</button>
				<div class="aim-dropdown-divider"></div>
				<button type="button" class="aim-dropdown-item">Close</button>
			</div>
		</div>
		<div class="aim-menu-dropdown">
			<button class="aim-menu-item" data-menu="edit" aria-haspopup="true" aria-expanded="false">Edit ▼</button>
			<div class="aim-dropdown-menu" id="editMenu" role="menu">
				<button type="button" class="aim-dropdown-item">Undo</button>
				<button type="button" class="aim-dropdown-item">Cut</button>
				<button type="button" class="aim-dropdown-item">Copy</button>
				<button type="button" class="aim-dropdown-item">Paste</button>
			</div>
		</div>
		<div class="aim-menu-dropdown">
			<button class="aim-menu-item" data-menu="view" aria-haspopup="true" aria-expanded="false">View ▼</button>
			<div class="aim-dropdown-menu" id="viewMenu" role="menu">
				<button type="button" class="aim-dropdown-item">Buddy List</button>
				<button type="button" class="aim-dropdown-item">Chat History</button>
				<button type="button" class="aim-dropdown-item">Preferences</button>
			</div>
		</div>
		<div class="aim-menu-dropdown">
			<button class="aim-menu-item" data-menu="buddies" aria-haspopup="true" aria-expanded="false">Buddies ▼</button>
			<div class="aim-dropdown-menu" id="buddiesMenu" role="menu">
				<button type="button" class="aim-dropdown-item">Get Buddy Info</button>
				<button type="button" class="aim-dropdown-item">View Away Message</button>
				<button type="button" class="aim-dropdown-item">Warn Buddy</button>
				<div class="aim-dropdown-divider"></div>
				<button type="button" class="aim-dropdown-item">Block Buddy</button>
			</div>
		</div>
		<div class="aim-menu-dropdown">
			<button class="aim-menu-item" data-menu="help" aria-haspopup="true" aria-expanded="false">Help ▼</button>
			<div class="aim-dropdown-menu" id="helpMenu" role="menu">
				<button type="button" class="aim-dropdown-item">AIM Help</button>
				<button type="button" class="aim-dropdown-item">Report a Bug</button>
				<button type="button" class="aim-dropdown-item">About AIM</button>
			</div>
		</div>
	</div>

	<!-- Chat Content -->
	<div class="aim-chat-content" id="aimChatContent">
		<div class="aim-connection-message" id="connectionMessage">
			<span class="aim-buddy-name-text">{buddyName}</span> has been signed on since 3:42 PM
		</div>
		<div id="messagesContainer"></div>
	</div>

	<!-- Input Area -->
	<div class="aim-input-area">
		<textarea
			class="aim-input"
			placeholder="Enter message here..."
			id="aimInput"
		></textarea>
		<div class="aim-input-footer">
			<button class="aim-send-btn" id="sendBtn">Send</button>
			<span class="aim-typing-status" id="typingStatus">
				<span class="aim-buddy-name-text">{buddyName}</span> has an idle message: away
			</span>
		</div>
	</div>

	<!-- Status Bar -->
	<div class="aim-status-bar">
		<span class="aim-status-indicator {buddyStatus === 'away' ? 'away' : 'available'}"></span>
		<span class="aim-status-text">
			<span class="aim-buddy-name-text">{buddyName}</span> is {buddyStatus}
		</span>
	</div>
</div>

<style>
	.aim-chat-window {
		position: fixed;
		bottom: 20px;
		right: 20px;
		width: 400px;
		background: var(--bg2);
		border: 2px solid var(--border);
		box-shadow: 4px 4px 0 var(--shadow);
		font-family: Arial, Helvetica, sans-serif;
		font-size: 12px;
		z-index: 9999;
		max-height: 500px;
		display: flex;
		flex-direction: column;
	}

	/* Title Bar - Theme adaptive */
	.aim-title-bar {
		background: linear-gradient(180deg, var(--accent) 0%, color-mix(in srgb, var(--accent) 70%, black) 100%);
		color: var(--sticker-text);
		padding: 4px 8px;
		display: flex;
		justify-content: space-between;
		align-items: center;
		cursor: move;
		user-select: none;
		border-bottom: 1px solid color-mix(in srgb, var(--accent) 50%, black);
	}

	.aim-title-left {
		display: flex;
		align-items: center;
		gap: 6px;
		font-weight: bold;
		font-size: 13px;
	}

	.aim-icon {
		font-size: 14px;
	}

	.aim-buddy-name {
		font-size: 13px;
	}

	.aim-title-controls {
		display: flex;
		gap: 4px;
	}

	.aim-control-btn {
		background: linear-gradient(180deg, #ffffff 0%, #e0e0e0 100%);
		border: 1px solid #808080;
		border-radius: 2px;
		width: 18px;
		height: 18px;
		font-size: 14px;
		font-weight: bold;
		cursor: pointer;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 0;
		line-height: 1;
	}

	.aim-control-btn:hover {
		background: linear-gradient(180deg, #f0f0f0 0%, #d0d0d0 100%);
	}

	.aim-control-btn:active {
		background: #c0c0c0;
	}

	/* Menu Bar */
	.aim-menu-bar {
		background: var(--bg2);
		padding: 2px 8px;
		display: flex;
		gap: 4px;
		border-bottom: 1px solid var(--border);
		position: relative;
	}

	.aim-menu-dropdown {
		position: relative;
	}

	.aim-menu-item {
		cursor: pointer;
		color: var(--text);
		background: none;
		border: none;
		font-family: Arial, Helvetica, sans-serif;
		font-size: 12px;
		padding: 2px 6px;
	}

	.aim-menu-item:hover {
		background: var(--accent);
		color: var(--sticker-text);
	}

	.aim-dropdown-menu {
		display: none;
		position: absolute;
		top: 100%;
		left: 0;
		background: var(--bg2);
		border: 2px outset var(--border);
		min-width: 180px;
		z-index: 10000;
		box-shadow: 2px 2px 4px rgba(0, 0, 0, 0.2);
	}

	.aim-dropdown-menu.active {
		display: block;
	}

	.aim-dropdown-item {
		display: block;
		width: 100%;
		padding: 4px 16px;
		cursor: pointer;
		color: var(--text);
		background: none;
		border: none;
		text-align: left;
		font: inherit;
	}

	.aim-dropdown-item:hover {
		background: var(--accent);
		color: var(--sticker-text);
	}

	.aim-dropdown-divider {
		height: 1px;
		background: var(--border);
		margin: 4px 0;
	}

	/* Chat Content Area */
	.aim-chat-content {
		background: var(--panel);
		padding: 10px;
		overflow-y: auto;
		flex: 1;
		max-height: 280px;
		border-top: 1px solid var(--border);
		border-bottom: 1px solid var(--border);
		display: block;
		transition: max-height 0.3s ease;
	}

	.aim-chat-window.minimized .aim-chat-content {
		max-height: 0;
		padding: 0 10px;
		overflow: hidden;
	}

	.aim-connection-message {
		color: var(--muted);
		font-style: italic;
		font-size: 11px;
		padding: 5px 0;
		border-bottom: 1px solid var(--border);
		margin-bottom: 10px;
	}

	/* Messages */
	.aim-message {
		margin-bottom: 8px;
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 4px;
		animation: fadeIn 0.2s ease-in;
	}

	@keyframes fadeIn {
		from {
			opacity: 0;
			transform: translateY(5px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	.aim-message-them {
		color: var(--text);
	}

	.aim-message-me {
		color: var(--accent);
		flex-direction: row-reverse;
		justify-content: flex-start;
	}

	.aim-sender-name {
		font-weight: bold;
		color: var(--link);
		font-size: 12px;
	}

	.aim-buddy-name-text {
		font-weight: bold;
		color: var(--link);
	}

	.aim-message-text {
		flex: 1;
		word-break: break-word;
	}

	.aim-message-time {
		font-size: 10px;
		color: var(--muted);
		font-style: italic;
	}

	/* Typing indicator */
	.aim-typing-indicator {
		color: var(--muted);
		font-style: italic;
		font-size: 11px;
		padding: 4px 0;
		animation: pulse 1.5s ease-in-out infinite;
	}

	@keyframes pulse {
		0%, 100% {
			opacity: 0.5;
		}
		50% {
			opacity: 1;
		}
	}

	/* Input Area */
	.aim-input-area {
		background: var(--bg2);
		padding: 8px;
		border-top: 1px solid var(--border);
	}

	.aim-input {
		width: 100%;
		min-height: 50px;
		padding: 6px;
		border: 2px solid var(--border);
		background: var(--panel);
		color: var(--text);
		font-family: Arial, Helvetica, sans-serif;
		font-size: 12px;
		resize: none;
		box-sizing: border-box;
	}

	.aim-input:focus {
		outline: none;
		border-color: var(--accent);
	}

	.aim-input-footer {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-top: 6px;
		gap: 10px;
		flex-wrap: wrap;
	}

	.aim-send-btn {
		background: linear-gradient(180deg, #f0f0f0 0%, #d0d0d0 100%);
		border: 2px outset #e0e0e0;
		padding: 4px 16px;
		font-family: Arial, Helvetica, sans-serif;
		font-size: 12px;
		cursor: pointer;
		font-weight: bold;
	}

	.aim-send-btn:active {
		border-style: inset;
	}

	.aim-typing-status {
		font-size: 11px;
		color: var(--muted);
		font-style: italic;
	}

	/* Status Bar */
	.aim-status-bar {
		background: var(--bg2);
		padding: 4px 8px;
		border-top: 1px solid var(--border);
		display: flex;
		align-items: center;
		gap: 6px;
		font-size: 11px;
	}

	.aim-status-indicator {
		width: 10px;
		height: 10px;
		border-radius: 50%;
		background: var(--accent);
		border: 1px solid color-mix(in srgb, var(--accent) 70%, black);
	}

	.aim-status-indicator.away {
		background: var(--focus);
		border-color: color-mix(in srgb, var(--focus) 70%, black);
	}

	.aim-status-text {
		color: var(--text);
	}

	/* Minimized State */
	.aim-chat-window.minimized {
		max-height: auto;
	}

	.aim-chat-window.minimized .aim-input-area,
	.aim-chat-window.minimized .aim-status-bar {
		display: none;
	}

	/* Scrollbar Styling */
	.aim-chat-content::-webkit-scrollbar {
		width: 16px;
	}

	.aim-chat-content::-webkit-scrollbar-track {
		background: var(--bg);
		border-left: 1px solid var(--border);
	}

	.aim-chat-content::-webkit-scrollbar-thumb {
		background: linear-gradient(180deg, var(--bg2) 0%, var(--bg) 100%);
		border: 1px solid var(--border);
	}

	.aim-chat-content::-webkit-scrollbar-thumb:hover {
		background: linear-gradient(180deg, color-mix(in srgb, var(--bg2) 80%, var(--accent)) 0%, var(--bg2) 100%);
	}

	/* Mobile Responsive */
	@media (max-width: 480px) {
		.aim-chat-window {
			right: 10px;
			left: 10px;
			width: auto;
			bottom: 10px;
		}

		.aim-dropdown-menu {
			min-width: 160px;
		}
	}
</style>

<script>
	import { initAimChat } from '../scripts/aim-chat';

	initAimChat();
</script>
