---
import Window from './Window.astro';
import RetroButton from './RetroButton.astro';
---

<div id="dice-roller-container" class="dice-roller-container">
	<Window title="Virtual Dice">
		<div id="dice-grid" class="dice-grid">
			<!-- Dice will be rendered here by JavaScript -->
		</div>

		<div class="dice-controls">
			<div class="dice-settings">
				<label class="dice-sound-toggle">
					<input type="checkbox" id="dice-sound-checkbox" />
					<span>Dice Sounds</span>
				</label>
			</div>

			<div class="selected-word-display">
				<span class="selected-word-label">Selected Letters:</span>
				<span id="selected-word" class="selected-word-value"></span>
			</div>

			<div class="dice-actions">
				<button id="add-word-btn" class="retro-button retro-button--primary" disabled>Add Word</button>
				<button id="roll-dice-btn" class="retro-button retro-button--primary">🎲 Roll Dice</button>
				<button id="clear-all-btn" class="retro-button retro-button--danger">🗑 Clear All</button>
				<button id="undo-last-die-btn" class="retro-button retro-button--secondary">⌫ Undo</button>
			</div>
		</div>
	</Window>
</div>

<style>
/* Only container/settings styles live here — the shared die/dice-grid look
   (including responsive rules) is defined once in global.css. */
	.dice-roller-container {
		margin-bottom: 1.5rem;
	}
	.dice-settings {
		display: flex;
		justify-content: center;
		padding: 0.5rem;
		background: var(--bg2);
		border-radius: 4px;
		margin-bottom: 1rem;
	}
	.dice-sound-toggle {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		cursor: pointer;
		font-size: 1rem;
	}
	.dice-sound-toggle input[type="checkbox"] {
		width: 1.2rem;
		height: 1.2rem;
		cursor: pointer;
	}
</style>
