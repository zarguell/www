---
interface Props {
	title: string;
	url: string;
	description: string;
	date: string;
	tags: string[];
	domain: string;
}

const { title, url, description, date, tags, domain } = Astro.props;

// Format date from ISO to readable format
function formatDate(isoDate: string): string {
	const date = new Date(isoDate);
	return date.toLocaleDateString('en-US', {
		month: 'short',
		day: 'numeric',
		year: 'numeric'
	});
}
---

<article class="cool-find-card">
	<a href={url} target="_blank" rel="noopener noreferrer" class="card-link">
		<h3 class="card-title">{title}</h3>
	</a>
	<span class="domain-badge">{domain}</span>
	<p class="card-description">{description}</p>
	<button class="expand-btn" aria-expanded="false" hidden>Show more</button>
	<div class="card-footer">
		<time class="card-date">{formatDate(date)}</time>
		{tags.length > 0 && (
			<div class="card-tags">
				{tags.map((tag) => (
					<span class="tag" data-tag={tag}>{tag}</span>
				))}
			</div>
		)}
	</div>
</article>

<style>
.cool-find-card {
	border: 2px solid var(--border);
	padding: 1.5rem;
	background: var(--bg);
	transition: all 0.2s ease;
	position: relative;
}

.cool-find-card:hover {
	border-color: var(--accent);
	box-shadow: 4px 4px 0 var(--accent);
	transform: translate(-2px, -2px);
}

.card-link {
	display: block;
	text-decoration: none;
	margin-bottom: 0.5rem;
}

.card-title {
	font-size: 1.2rem;
	margin: 0;
	color: var(--link);
	transition: color 0.2s ease;
}

.cool-find-card:hover .card-title {
	color: var(--accent);
	text-decoration: underline;
}

.domain-badge {
	display: inline-block;
	font-size: 0.75rem;
	padding: 0.25rem 0.5rem;
	background: var(--muted);
	border-radius: 9999px;
	margin-bottom: 1rem;
	font-weight: bold;
	letter-spacing: 0.05em;
	text-transform: uppercase;
}

.card-description {
	margin: 0 0 1rem 0;
	color: var(--text);
	line-height: 1.6;
	display: -webkit-box;
	-webkit-line-clamp: 2;
	-webkit-box-orient: vertical;
	overflow: hidden;
}

.card-footer {
	display: flex;
	justify-content: space-between;
	align-items: center;
	gap: 1rem;
	flex-wrap: wrap;
}

.card-date {
	font-size: 0.875rem;
	color: var(--muted);
}

.card-tags {
	display: flex;
	gap: 0.5rem;
	flex-wrap: wrap;
}

.tag {
	font-size: 0.75rem;
	padding: 0.25rem 0.5rem;
	background: var(--bg2);
	border: 1px solid var(--border);
	border-radius: 4px;
	cursor: pointer;
	transition: all 0.2s ease;
	box-shadow: 1px 1px 0 var(--shadow);
	position: relative;
}

.tag:hover {
	background: var(--border);
	transform: translate(0.5px, 0.5px);
	box-shadow: 0.5px 0.5px 0 var(--shadow);
}

.tag:active {
	transform: translate(1px, 1px);
	box-shadow: 0 0 0 var(--shadow);
}

.expand-btn {
	background: none;
	border: none;
	color: var(--link);
	font-family: inherit;
	font-size: 0.875rem;
	padding: 0;
	margin-bottom: 1rem;
	cursor: pointer;
	text-decoration: underline;
}

.expand-btn:hover {
	color: var(--accent);
}

.card-description.expanded {
	display: block;
	-webkit-line-clamp: unset;
}
</style>

<script>
document.querySelectorAll('.cool-find-card').forEach(card => {
	const description = card.querySelector('.card-description');
	const expandBtn = card.querySelector('.expand-btn');
	
	if (description && expandBtn) {
		// Check if text is truncated
		if (description.scrollHeight > description.clientHeight) {
			expandBtn.hidden = false;
			
			expandBtn.addEventListener('click', (e) => {
				e.stopPropagation();
				const isExpanded = description.classList.toggle('expanded');
				expandBtn.textContent = isExpanded ? 'Show less' : 'Show more';
				expandBtn.setAttribute('aria-expanded', String(isExpanded));
			});
		}
	}
});
</script>
