---
/**
 * Sticker Component
 * Loud callout labels for emphasis
 */
interface Props {
	text: string;
	rotate?: 'left' | 'right' | 'none';
}

const {
	text,
	rotate = 'left',
} = Astro.props;

const rotationStyles = {
	left: 'transform: rotate(-3deg);',
	right: 'transform: rotate(3deg);',
	none: 'transform: none;',
};
---

<span class={`sticker sticker--${rotate}`}>{text}</span>

<style>
	.sticker {
		display: inline-block;
		padding: 0.4em 0.8em;
		font-size: 1.2rem;
		font-weight: 400;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		background: var(--sticker-bg);
		color: var(--sticker-text);
		border: 3px solid var(--border);
		border-radius: 4px;
		box-shadow: 3px 3px 0 var(--shadow);
		margin: 0 0.3em;
	}

	.sticker--left {
		transform: rotate(-3deg);
	}

	.sticker--right {
		transform: rotate(3deg);
	}

	.sticker--none {
		transform: none;
	}
</style>
