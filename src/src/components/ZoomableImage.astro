---
/**
 * ZoomableImage Component
 *
 * Provides click-to-zoom fullscreen functionality for images.
 * Perfect for PyScript matplotlib charts or any detailed images.
 *
 * @param {string} id - Unique ID for the image element
 * @param {string} src - Image source (can be data URI, URL, or set dynamically)
 * @param {string} alt - Alt text for accessibility
 * @param {string} hint - Optional hint text (default: "Click image to view fullscreen")
 */
interface Props {
	id: string;
	src?: string;
	alt?: string;
	hint?: string;
}

const {
	id,
	src = '',
	alt = 'Zoomable image',
	hint = '🔍 Click image to view fullscreen',
} = Astro.props;

const uniqueId = `zoomable-${id}`;
const imgId = `img-${id}`;
const checkboxId = `checkbox-${id}`;
---

<div id={uniqueId} class="click-zoom-container">
	<div class="zoom-hint">{hint}</div>
	<div class="click-zoom">
		<input type="checkbox" id={checkboxId} class="zoom-checkbox" />
		<label for={checkboxId} class="zoom-label">
			<img id={imgId} src={src} alt={alt} class="zoomable-image" />
		</label>
	</div>
</div>

<style>
	.click-zoom-container {
		width: 100%;
	}

	.zoom-hint {
		font-family: 'VT323', monospace;
		font-size: 1rem;
		color: var(--color-text);
		opacity: 0.7;
		margin-bottom: 0.5rem;
		text-align: center;
	}

	/* Hide checkbox */
	.zoom-checkbox {
		display: none;
	}

	/* Label acts as trigger */
	.zoom-label {
		cursor: zoom-in;
		display: block;
	}

	/* Base image styling */
	.zoomable-image {
		max-width: 100%;
		height: auto;
		display: block;
		transition: transform 0.25s ease;
		cursor: zoom-in;
	}

	/* Fullscreen modal when checkbox is checked */
	.click-zoom input:checked + .zoom-label {
		position: fixed;
		inset: 0;
		background: rgba(0, 0, 0, 0.95);
		display: flex;
		align-items: center;
		justify-content: center;
		z-index: 9999;
		cursor: zoom-out;
		padding: 2rem;
	}

	.click-zoom input:checked + .zoom-label .zoomable-image {
		max-width: 100%;
		max-height: 95vh;
		object-fit: contain;
		cursor: zoom-out;
	}

	/* Responsive adjustments */
	@media (max-width: 768px) {
		.zoom-hint {
			font-size: 0.875rem;
		}
	}
</style>
