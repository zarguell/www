---
import BaseLayout from './BaseLayout.astro';
import Tag from '../components/Tag.astro';
import Badge from '../components/Badge.astro';
import type { CollectionEntry } from 'astro:content';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, tags, heroImage } = Astro.props;

// Format date for display
const formatDate = (date: Date) => {
	return new Date(date).toLocaleDateString('en-US', {
		year: 'numeric',
		month: 'long',
		day: 'numeric',
	});
};
---

<BaseLayout title={title}>
	<article class="blog-post">
		<header class="blog-post__header">
			<h1 class="blog-post__title">{title}</h1>
			<div class="blog-post__meta">
				<time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
				{tags && tags.length > 0 && (
					<div class="blog-post__tags">
						{tags.map((tag) => (
							<Tag tag={tag} href={`/blog/?tag=${tag}`} />
						))}
					</div>
				)}
			</div>
			{description && <p class="blog-post__description">{description}</p>}
		</header>

		<div class="blog-post__content prose">
			<slot />
		</div>

		<footer class="blog-post__footer">
			<a href="/blog/" class="back-link">← Back to Blog</a>
		</footer>
	</article>
</BaseLayout>

<style>
	.blog-post {
		max-width: 65ch;
		margin: 0 auto;
	}

	.blog-post__header {
		text-align: center;
		padding: 2rem 0;
		border-bottom: 3px dashed var(--border);
		margin-bottom: 2rem;
	}

	.blog-post__title {
		font-size: 3rem;
		margin-bottom: 1rem;
		line-height: 1.2;
	}

	.blog-post__meta {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1rem;
		margin-bottom: 1rem;
	}

	.blog-post__meta time {
		color: var(--muted);
		font-size: 1.1rem;
	}

	.blog-post__tags {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.5rem;
	}

	.blog-post__description {
		font-size: 1.3rem;
		color: var(--muted);
		font-style: italic;
	}

	.blog-post__content {
		margin-bottom: 3rem;
	}

	.blog-post__footer {
		border-top: 3px dashed var(--border);
		padding-top: 2rem;
		text-align: center;
	}

	.back-link {
		display: inline-block;
		padding: 0.6em 1.2em;
		background: var(--bg2);
		border: 2px solid var(--border);
		border-radius: 4px;
		color: var(--text);
		text-decoration: none;
		transition: all 0.2s ease;
	}

	.back-link:hover {
		background: var(--accent);
		color: var(--sticker-text);
		border-color: var(--accent);
	}

	@media (max-width: 768px) {
		.blog-post__title {
			font-size: 2.5rem;
		}

		.blog-post__description {
			font-size: 1.1rem;
		}
	}
</style>
