---
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import '../styles/global.css';
import HeadMeta from '../components/HeadMeta.astro';

interface Props {
	title?: string;
	description?: string;
	ogImage?: string;
}

const {
	title = 'Tool',
	description = 'Interactive tool',
	ogImage,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en" data-theme="neon-night">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<link rel="canonical" href={canonicalURL} />

		<!-- Apply saved theme before first paint (mirrors src/scripts/theme.ts) -->
		<script is:inline>
			(() => {
				let theme = null;
				try {
					theme = localStorage.getItem('theme');
				} catch {}
				if (theme !== 'neon-night' && theme !== 'mall-pastel') {
					theme =
						window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches
							? 'neon-night'
							: 'mall-pastel';
				}
				document.documentElement.dataset.theme = theme;
			})();
		</script>

		<HeadMeta title={title} description={description} canonicalURL={canonicalURL} ogImage={ogImage} ogImageAlt="Preview image for this tool" />

		<!-- VT323 Font Embed -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=VT323&display=swap" rel="stylesheet">

		<title>{title}</title>
	</head>
	<body>
		<SiteHeader />
		<main>
			<slot />
		</main>
		<SiteFooter />
	</body>
</html>

<style>
	body {
		margin: 0;
		padding: 0;
		min-height: 100vh;
	}

	main {
		padding: 2rem;
		max-width: 1200px;
		margin: 0 auto;
	}
</style>
