{
  "name": "arguelles-me",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Static site for arguelles.me, generated by a Python + Jinja engine.",
  "scripts": {
    "build": "bash scripts/build.sh",
    "dev": "bash scripts/build.sh --serve",
    "vendor": "bash scripts/build.sh --vendor-only",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "bash scripts/lint.sh"
  },
  "dependencies": {
    "@e965/xlsx": "^0.20.3",
    "@pyscript/core": "0.7.31",
    "exifreader": "4.54.0",
    "heic-to": "1.6.7",
    "html-to-image": "1.11.13",
    "jszip": "3.10.2",
    "lz-string": "1.5.0",
    "plotly.js-dist-min": "4.3.0",
    "tesseract.js": "7.0.0",
    "wordlist-js": "2.0.0"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.1.0",
    "esbuild": "0.28.2",
    "jsdom": "31.0.1",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
